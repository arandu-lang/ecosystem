module ita

import io
import std.env as env
import std.fs as fs
import std.alloc.string as ownedStrings

import self.sha256 as sha256
import self.hex as hex

/// Hash a single file and print `<hex>  <path>`.
@Effects(FileRead, Foreign)
func hashFile(path: str): bool {
    match fs.readToString(path) {
        Ok(content) => {
            let bytes = content.asBytes()
            let digest = sha256.sha256Bytes(bytes)
            let hex_str = hex.encodeDigest32(digest)
            io.println("${hex_str.asStr()}  ${path}")
            return true
        }
        Err(_) => {
            io.println("ita: ${path}: could not read file")
            return false
        }
    }
}

@Effects(FileRead, Foreign)
func main(): int {
    let argc = env.argsLen()
    if argc < 2 {
        io.println("ita — SHA-256 file hasher")
        io.println("")
        io.println("Usage: ita <file> [<file> ...]")
        io.println("")
        io.println("Output: <sha256hex>  <filename>")
        return 1
    }

    let mut failures: uint = 0
    let mut i: int = 1
    while i < argc {
        let path = env.arg(i)
        if !hashFile(path) {
            failures = failures + 1
        }
        i = i + 1
    }

    if failures > 0 {
        return 1
    }
    return 0
}

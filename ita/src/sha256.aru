    state.h0 = state.h0 + a
    state.h1 = state.h1 + b
    state.h2 = state.h2 + c
    state.h3 = state.h3 + d
    state.h4 = state.h4 + e
    state.h5 = state.h5 + f
    state.h6 = state.h6 + g
    state.h7 = state.h7 + h

module jabuti

import io
import std.env as env
import std.alloc.vec as vec
import self.index as index

public struct Rng32 {
    public state: u32
}

/// Generates a deterministic pseudo-random `f32` in `[-1.0, 1.0]` using xorshift32.
func Rng32.nextF32(self: mut ref Rng32): f32 {
    let mut x = self.state
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    self.state = x
    let masked = (x & 0xFFFF) as int
    let norm = (masked as f32) / 32768.0
    return norm - 1.0
}

func runDemo(numVectors: usize, dim: usize, topK: usize): int {
    io.println("jabuti — SIMD Vector Similarity Search Engine")
    io.println("Building flat index: ${numVectors} vectors x ${dim} dimensions (F32x4 4-way unrolled)...")

    let mut idx = index.newFlatIndex(dim)
    let mut rng = Rng32 { state: 0xCAFEBABE }
    let mut vIdx: usize = 0

    while vIdx < numVectors {
        let mut v = vec.Vec.new<f32>()
        let mut d: usize = 0
        while d < dim {
            v.push(rng.nextF32())
            d = d + 1
        }
        idx.addVector((vIdx + 1000) as u64, v.asSlice())
        vIdx = vIdx + 1
    }

    // Plant a known target vector at ID 99999
    let mut target = vec.Vec.new<f32>()
    let mut query = vec.Vec.new<f32>()
    let mut d: usize = 0
    while d < dim {
        let val = ((d % 7) as f32) * 0.25 + 0.1
        target.push(val)
        // Slightly perturbed query vector
        query.push(val + 0.01)
        d = d + 1
    }
    idx.addVector(99999, target.asSlice())

    let results = idx.searchTopKCosine(query.asSlice(), topK)
    let resSlice = results.asSlice()
    io.println("Top-${topK} nearest neighbors (Cosine Similarity):")

    let mut r: usize = 0
    while r < results.len() {
        let hit = ref resSlice[r]
        let rank = r + 1
        let scoreInt = (hit.score * 10000.0) as int
        io.println("  #${rank} -> id=${hit.id} (cosine_x10000=${scoreInt})")
        r = r + 1
    }

    return 0
}

@Effects(Foreign)
func main(): int {
    let argc = env.argsLen()
    if argc >= 2 {
        let cmd = env.arg(1)
        if cmd == "bench" {
            return runDemo(2048, 128, 5)
        }
        if cmd == "demo" {
            return runDemo(256, 64, 5)
        }
        if cmd == "--help" || cmd == "-h" {
            io.println("Usage: jabuti [demo|bench]")
            return 0
        }
    }
    return runDemo(256, 64, 5)
}

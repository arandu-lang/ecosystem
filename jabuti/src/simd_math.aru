module simd_math

import std.core.simd as simd
import std.core.slice as slice

/// Scalar reference implementation of the dot product of two `f32` slices.
public func dotProductScalar(a: []f32, b: []f32): f32 {
    let n = slice.len<f32>(a)
    let m = slice.len<f32>(b)
    let len = if n < m { n } else { m }
    let mut sum: f32 = 0.0
    let mut i: usize = 0
    while i < len {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    return sum
}

/// Computes the horizontal sum of all 4 lanes in an `F32x4` SIMD vector.
public func horizontalSum(v: simd.F32x4): f32 {
    return (v.extractLane(0) + v.extractLane(1)) + (v.extractLane(2) + v.extractLane(3))
}

/// Computes the dot product of `a` and `b` using 4-way unrolled 128-bit SIMD
/// (`F32x4`) vertical accumulators and a single horizontal reduction at the end.
///
/// Why 4-way unrolling matters:
/// - Floating-point multiply-add has a 3-5 cycle latency on modern CPUs, while
///   throughput is 1-2 ops/cycle. Using 4 independent accumulators (`acc0..acc3`)
///   breaks the loop-carried dependency chain and saturates the SIMD execution ports.
/// - Horizontal reduction (`extractLane`) is performed only once after the loop.
public func dotProductSimd(a: []f32, b: []f32): f32 {
    let n = slice.len<f32>(a)
    let m = slice.len<f32>(b)
    let len = if n < m { n } else { m }

    let mut acc0 = simd.F32x4.splat(0.0)
    let mut acc1 = simd.F32x4.splat(0.0)
    let mut acc2 = simd.F32x4.splat(0.0)
    let mut acc3 = simd.F32x4.splat(0.0)

    let mut i: usize = 0

    // Main 16-float (64-byte) unrolled SIMD loop
    while i + 16 <= len {
        let a0 = simd.F32x4.new(a[i], a[i + 1], a[i + 2], a[i + 3])
        let b0 = simd.F32x4.new(b[i], b[i + 1], b[i + 2], b[i + 3])
        acc0 = acc0.add(a0.mul(b0))

        let a1 = simd.F32x4.new(a[i + 4], a[i + 5], a[i + 6], a[i + 7])
        let b1 = simd.F32x4.new(b[i + 4], b[i + 5], b[i + 6], b[i + 7])
        acc1 = acc1.add(a1.mul(b1))

        let a2 = simd.F32x4.new(a[i + 8], a[i + 9], a[i + 10], a[i + 11])
        let b2 = simd.F32x4.new(b[i + 8], b[i + 9], b[i + 10], b[i + 11])
        acc2 = acc2.add(a2.mul(b2))

        let a3 = simd.F32x4.new(a[i + 12], a[i + 13], a[i + 14], a[i + 15])
        let b3 = simd.F32x4.new(b[i + 12], b[i + 13], b[i + 14], b[i + 15])
        acc3 = acc3.add(a3.mul(b3))

        i = i + 16
    }

    // 4-float (16-byte) SIMD remainder loop
    while i + 4 <= len {
        let av = simd.F32x4.new(a[i], a[i + 1], a[i + 2], a[i + 3])
        let bv = simd.F32x4.new(b[i], b[i + 1], b[i + 2], b[i + 3])
        acc0 = acc0.add(av.mul(bv))
        i = i + 4
    }

    // Tree reduction of the 4 SIMD accumulators into a single `F32x4`
    let sum01 = acc0.add(acc1)
    let sum23 = acc2.add(acc3)
    let totalVec = sum01.add(sum23)
    let mut total = horizontalSum(totalVec)

    // Scalar tail for dimensions not divisible by 4
    while i < len {
        total = total + a[i] * b[i]
        i = i + 1
    }

    return total
}

/// Computes the squared L2 norm (`||a||^2`) using 4-way SIMD.
public func l2NormSqSimd(a: []f32): f32 {
    return dotProductSimd(a, a)
}

/// Fast Newton-Raphson square root for `f32`.
public func sqrtF32(x: f32): f32 {
    if x <= 0.0 {
        return 0.0
    }
    let mut scaled = x
    let mut shift: int = 0
    while scaled > 4.0 {
        scaled = scaled / 4.0
        shift = shift + 1
    }
    while scaled < 0.25 {
        scaled = scaled * 4.0
        shift = shift - 1
    }
    let mut guess = scaled * 0.5 + 0.5
    let mut i: int = 0
    while i < 10 {
        guess = 0.5 * (guess + scaled / guess)
        i = i + 1
    }
    let mut result = guess
    let mut k: int = 0
    if shift > 0 {
        while k < shift {
            result = result * 2.0
            k = k + 1
        }
    } else {
        while k < -shift {
            result = result / 2.0
            k = k + 1
        }
    }
    return result
}

/// Computes the L2 norm (`||a||`) of a vector slice using SIMD.
public func l2NormSimd(a: []f32): f32 {
    return sqrtF32(l2NormSqSimd(a))
}

/// Computes the cosine similarity between `a` and `b` in `[-1.0, 1.0]`.
public func cosineSimilaritySimd(a: []f32, b: []f32): f32 {
    let dot = dotProductSimd(a, b)
    let na = l2NormSimd(a)
    let nb = l2NormSimd(b)
    let denom = na * nb
    if denom < 0.00000001 {
        return 0.0
    }
    return dot / denom
}

/// Computes squared Euclidean (L2) distance `||a - b||^2` using 4-way SIMD.
public func l2DistanceSqSimd(a: []f32, b: []f32): f32 {
    let n = slice.len<f32>(a)
    let m = slice.len<f32>(b)
    let len = if n < m { n } else { m }

    let mut acc0 = simd.F32x4.splat(0.0)
    let mut acc1 = simd.F32x4.splat(0.0)
    let mut i: usize = 0

    while i + 8 <= len {
        let a0 = simd.F32x4.new(a[i], a[i + 1], a[i + 2], a[i + 3])
        let b0 = simd.F32x4.new(b[i], b[i + 1], b[i + 2], b[i + 3])
        let d0 = a0.sub(b0)
        acc0 = acc0.add(d0.mul(d0))

        let a1 = simd.F32x4.new(a[i + 4], a[i + 5], a[i + 6], a[i + 7])
        let b1 = simd.F32x4.new(b[i + 4], b[i + 5], b[i + 6], b[i + 7])
        let d1 = a1.sub(b1)
        acc1 = acc1.add(d1.mul(d1))

        i = i + 8
    }

    while i + 4 <= len {
        let av = simd.F32x4.new(a[i], a[i + 1], a[i + 2], a[i + 3])
        let bv = simd.F32x4.new(b[i], b[i + 1], b[i + 2], b[i + 3])
        let dv = av.sub(bv)
        acc0 = acc0.add(dv.mul(dv))
        i = i + 4
    }

    let mut total = horizontalSum(acc0.add(acc1))
    while i < len {
        let diff = a[i] - b[i]
        total = total + diff * diff
        i = i + 1
    }
    return total
}

@Test
func parse_integer(): void {
    let src = strings.asBytes("42")
    match parser.parseJson(src) {
        Ok(mut arena) => {
            let n = arena.node(arena.root)
            let ok_integer = match n.kind {
                JsonKind.Integer => true
                _ => false
            }
            testing.expect(ok_integer, "must be Integer")
            testing.expect(n.int_val == 42, "int_val must be 42")
        }
        Err(e) => { testing.expect(false, "parse integer failed") }
    }
}

@Test
func parse_negative_integer(): void {
    let src = strings.asBytes("-7")
    match parser.parseJson(src) {
        Ok(mut arena) => {
            let n = arena.node(arena.root)
            let ok_integer = match n.kind {
                JsonKind.Integer => true
                _ => false
            }
            testing.expect(ok_integer, "must be Integer")
            testing.expect(n.int_val == -7, "int_val must be -7")
        }
        Err(e) => { testing.expect(false, "parse -7 failed") }

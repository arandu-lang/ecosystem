module kandiru_tests

import std.testing as testing
import std.core.str as strings
import std.core.slice as slice

from self.parser import { JsonKind }
import self.parser as parser
import self.query as query


@Test
func parse_null(): void {
    let src = strings.asBytes("null")
    match parser.parseJson(src) {
        Ok(mut arena) => {
            let n = arena.node(arena.root)
            let ok_null = match n.kind {
                JsonKind.Null => true
                _ => false
            }
            testing.expect(ok_null, "root must be null")
        }
        Err(e) => { testing.expect(false, "parse null failed: ${e.message}") }
    }
}


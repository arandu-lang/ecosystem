                s2 += s1
                s1 += (localPtr[1] as u32)
                s2 += s1
                s1 += (localPtr[2] as u32)
                s2 += s1
                s1 += (localPtr[3] as u32)
                s2 += s1
                s1 += (localPtr[4] as u32)
                s2 += s1
                s1 += (localPtr[5] as u32)
                s2 += s1
                s1 += (localPtr[6] as u32)
                s2 += s1
                s1 += (localPtr[7] as u32)
                s2 += s1

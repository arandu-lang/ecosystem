//! Arquivo gerado automaticamente pelo c2arandu
//! Baseado na arquitetura Dual-Locus & OSSA da linguagem Arandu.

// --- Tipos de Sistema C C-ABI ---
@Repr("C")
public struct FILE {}

@Repr("C")
public struct Tm {
    public tmSec: int,
    public tmMin: int,
    public tmHour: int,
    public tmMday: int,
    public tmMon: int,
    public tmYear: int,
    public tmWday: int,
    public tmYday: int,
    public tmIsdst: int,
}

public type TimeT = i64

@Repr("C")
public struct AnonTransferInfo {
    public ftransfer: u16,
    public ntransfer: u16,
}

@Repr("C")
public struct AnonCallInfoC {
    public ctx: LuaKContext,
    public k: LuaKFunction,
    public oldErrfunc: isize,
}

@Repr("C")
public struct AnonCallInfoL {
    public nextraargs: int,
    public savedpc: ptr[Instruction],
    public trap: u8,
}

@Repr("C")
public struct AnonInd {
    public idx: i16,
    public t: u8,
}

@Repr("C")
public struct AnonOpen {
    public next: ptr[u8],
    public previous: ptr[u8],
}

@Repr("C")
public struct AnonVar {
    public ridx: u8,
    public vidx: i16,
}

@Repr("C")
public union AnonymousStruct {
    public dummy: int,
    public arr: [64]usize,
    public b: int,
    public c: AnonCallInfoC,
    public delta: u16,
    public funcidx: int,
    public hnext: int,
    public ind: AnonInd,
    public info: int,
    public ival: i64,
    public k: int,
    public keyTt: u8,
    public keyVal: Value,
    public kind: u8,
    public l: AnonCallInfoL,
    public lnglen: usize,
    public metatable: ptr[Table],
    public n: int,
    public name: ptr[TString],
    public next: int,
    public nres: int,
    public nval: f64,
    public nyield: int,
    public offset: isize,
    public open: AnonOpen,
    public p: ptr[u8],
    public pidx: int,
    public ridx: int,
    public size: usize,
    public strval: ptr[u8],
    public transferinfo: AnonTransferInfo,
    public u: usize,
    public value: usize,
    public var: AnonVar,
    public init: ptr[u8],
    public len: isize,
}


        let mut localP: ptr[ptr[GCObject]] = p
        let mut curr: ptr[GCObject] = nil
        let mut g: ptr[GlobalState] = l.lG
        while true {
            curr = localP[0]
            if !((curr != (nil as ptr[GCObject]))) {
                break
            }
            if ((curr.marked & ((1 << 3) | (1 << 4))) != 0) {
                localP[0] = curr.next
                freeobj(l, curr)
            } else {
                curr.marked = (((curr.marked & ~7) | 4) as LuByte)
                if (curr.tt == (8 | (0 << 4))) {
                    let mut th: ptr[LuaState] = &(curr as ptr[GCUnion]).th
                    linkgclist(&(th as ptr[GCUnion]).gc, &th.gclist, &g.grayagain)
                } else {
                    if ((curr.tt == (9 | (0 << 4))) && ((curr as ptr[GCUnion]).upv.v.p != &(curr as ptr[GCUnion]).upv.u.value)) {
                        curr.marked &= ((~((1 << 5) | ((1 << 3) | (1 << 4))) as LuByte) as LuByte)
                    } else {
                        curr.marked |= ((1 << 5) as LuByte)
                    }
                }
                localP = &curr.next
            }
        }
    }
}

@Export
public func sweepgen(l: ptr[LuaState], g: ptr[GlobalState], p: ptr[ptr[GCObject]], limit: ptr[GCObject], pfirstold1: ptr[ptr[GCObject]]): ptr[ptr[GCObject]] {
    unsafe {
        let mut localP: ptr[ptr[GCObject]] = p
        let mut nextage: [7]LuByte = [1, 3, 3, 4, 4, 5, 6]
        let mut white: int = ((g.currentwhite & ((1 << 3) | (1 << 4))) as LuByte)
        let mut curr: ptr[GCObject] = nil
        while true {
            curr = localP[0]
            if !((curr != limit)) {
                break
            }
            if ((curr.marked & ((1 << 3) | (1 << 4))) != 0) {
                localP[0] = curr.next
                freeobj(l, curr)
            } else {
                if ((curr.marked & 7) == 0) {
                    let mut marked: int = (curr.marked & ~(((1 << 5) | ((1 << 3) | (1 << 4))) | 7))
                    curr.marked = (((marked | 1) | white) as LuByte)
                } else {
                    curr.marked = (((curr.marked & ~7) | nextage[(curr.marked & 7)]) as LuByte)
                    if (((curr.marked & 7) == 3) && (pfirstold1[0] == (nil as ptr[GCObject]))) {
                        pfirstold1[0] = curr
                    }
                }
                localP = &curr.next
            }
        }
        return localP
    }
}

@Export
public func whitelist(g: ptr[GlobalState], p: ptr[GCObject]) {
    unsafe {
        let mut localP: ptr[GCObject] = p
        let mut white: int = ((g.currentwhite & ((1 << 3) | (1 << 4))) as LuByte)
        while (localP != (nil as ptr[GCObject])) {
            localP.marked = (((localP.marked & ~(((1 << 5) | ((1 << 3) | (1 << 4))) | 7)) | white) as LuByte)
            localP = localP.next
        }
    }
}

@Export
public func correctgraylist(p: ptr[ptr[GCObject]]): ptr[ptr[GCObject]] {
    unsafe {
        let mut localP: ptr[ptr[GCObject]] = p
        let mut curr: ptr[GCObject] = nil
        while true {
            curr = localP[0]
            if !((curr != (nil as ptr[GCObject]))) {
                break
            }
            let mut next: ptr[ptr[GCObject]] = getgclist(curr)
            while true {
                if ((curr.marked & ((1 << 3) | (1 << 4))) != 0) {
                    break
                } else {
                    if ((curr.marked & 7) == 5) {
                        curr.marked |= ((1 << 5) as LuByte)
                        curr.marked ^= ((5 ^ 6) as LuByte)
                        // goto remain
                    } else {
                        if (curr.tt == (8 | (0 << 4))) {
                            // goto remain
                        } else {
                            if ((curr.marked & 7) == 6) {
                                curr.marked ^= ((6 ^ 4) as LuByte)
                            }
                            curr.marked |= ((1 << 5) as LuByte)
                            break
                        }
                    }
                }
                break
            }
            localP[0] = next[0]
            continue
            localP = next
            continue
        }
        return localP
    }
}

@Export
public func correctgraylists(g: ptr[GlobalState]) {
    unsafe {
        let mut list: ptr[ptr[GCObject]] = correctgraylist(&g.grayagain)
        list[0] = g.weak
        g.weak = (nil as ptr[GCObject])
        list = correctgraylist(list)
        list[0] = g.allweak
        g.allweak = (nil as ptr[GCObject])
        list = correctgraylist(list)
        list[0] = g.ephemeron
        g.ephemeron = (nil as ptr[GCObject])
        correctgraylist(list)
    }
}

@Export
public func markold(g: ptr[GlobalState], from: ptr[GCObject], to: ptr[GCObject]) {
    unsafe {
        let mut p: ptr[GCObject] = nil
        p = from
        while (p != to) {
            if ((p.marked & 7) == 3) {
                p.marked ^= ((3 ^ 4) as LuByte)
                if ((p.marked & (1 << 5)) != 0) {
                    reallymarkobject(g, p)
                }
            }
            p = p.next
        }
    }
}

@Export
public func finishgencycle(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        correctgraylists(g)
        checkSizes(l, g)
        g.gcstate = 0
        if (g.gcemergency == 0) {
            callallpendingfinalizers(l)
        }
    }
}

@Export
public func youngcollection(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        let mut psurvival: ptr[ptr[GCObject]] = nil
        let mut dummy: ptr[GCObject] = nil
        if (g.firstold1 != 0) {
            markold(g, g.firstold1, g.reallyold)
            g.firstold1 = (nil as ptr[GCObject])
        }
        markold(g, g.finobj, g.finobjrold)
        markold(g, g.tobefnz, (nil as ptr[GCObject]))
        atomic(l)
        g.gcstate = 3
        psurvival = sweepgen(l, g, &g.allgc, g.survival, &g.firstold1)
        sweepgen(l, g, psurvival, g.old1, &g.firstold1)
        g.reallyold = g.old1
        g.old1 = psurvival[0]
        g.survival = g.allgc
        dummy = (nil as ptr[GCObject])
        psurvival = sweepgen(l, g, &g.finobj, g.finobjsur, &dummy)
        sweepgen(l, g, psurvival, g.finobjold1, &dummy)
        g.finobjrold = g.finobjold1
        g.finobjold1 = psurvival[0]
        g.finobjsur = g.finobj
        sweepgen(l, g, &g.tobefnz, (nil as ptr[GCObject]), &dummy)
        finishgencycle(l, g)
    }
}

@Export
public func atomic2gen(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        cleargraylists(g)
        g.gcstate = 3
        sweep2old(l, &g.allgc)
        g.survival = g.allgc
        g.old1 = g.survival
        g.reallyold = g.old1
        g.firstold1 = (nil as ptr[GCObject])
        sweep2old(l, &g.finobj)
        g.finobjsur = g.finobj
        g.finobjold1 = g.finobjsur
        g.finobjrold = g.finobjold1
        sweep2old(l, &g.tobefnz)
        g.gckind = 1
        g.lastatomic = 0
        g.gCestimate = ((g.totalbytes + g.gCdebt) as LuMem)
        finishgencycle(l, g)
    }
}

@Export
public func setminordebt(g: ptr[GlobalState]) {
    unsafe {
        luaESetdebt(g, -(((((g.totalbytes + g.gCdebt) as LuMem) / 100) as LMem) * g.genminormul))
    }
}

@Export
public func entergen(l: ptr[LuaState], g: ptr[GlobalState]): LuMem {
    unsafe {
        let mut numobjs: LuMem = LuMem {}
        luaCRuntilstate(l, (1 << 8))
        luaCRuntilstate(l, (1 << 0))
        numobjs = atomic(l)
        atomic2gen(l, g)
        setminordebt(g)
        return numobjs
    }
}

@Export
public func enterinc(g: ptr[GlobalState]) {
    unsafe {
        whitelist(g, g.allgc)
        g.survival = (nil as ptr[GCObject])
        g.old1 = g.survival
        g.reallyold = g.old1
        whitelist(g, g.finobj)
        whitelist(g, g.tobefnz)
        g.finobjsur = (nil as ptr[GCObject])
        g.finobjold1 = g.finobjsur
        g.finobjrold = g.finobjold1
        g.gcstate = 8
        g.gckind = 0
        g.lastatomic = 0
    }
}

@Export
public func fullgen(l: ptr[LuaState], g: ptr[GlobalState]): LuMem {
    unsafe {
        enterinc(g)
        return entergen(l, g)
    }
}

@Export
public func stepgenfull(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        let mut newatomic: LuMem = LuMem {}
        let mut lastatomic: LuMem = g.lastatomic
        if (g.gckind == 1) {
            enterinc(g)
        }
        luaCRuntilstate(l, (1 << 0))
        newatomic = atomic(l)
        if (newatomic < (lastatomic + (lastatomic >> 3))) {
            atomic2gen(l, g)
            setminordebt(g)
        } else {
            g.gCestimate = ((g.totalbytes + g.gCdebt) as LuMem)
            entersweep(l)
            luaCRuntilstate(l, (1 << 8))
            setpause(g)
            g.lastatomic = newatomic
        }
    }
}

@Export
public func genstep(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        if (g.lastatomic != 0) {
            stepgenfull(l, g)
        } else {
            let mut majorbase: LuMem = g.gCestimate
            let mut majorinc: LuMem = ((majorbase / 100) * (g.genmajormul * 4))
            if ((g.gCdebt > 0) && (((g.totalbytes + g.gCdebt) as LuMem) > (majorbase + majorinc))) {
                let mut numobjs: LuMem = fullgen(l, g)
                if (((g.totalbytes + g.gCdebt) as LuMem) < (majorbase + (majorinc / 2))) {
                } else {
                    g.lastatomic = numobjs
                    setpause(g)
                }
            } else {
                youngcollection(l, g)
                setminordebt(g)
                g.gCestimate = majorbase
            }
        }
    }
}

@Export
public func deletelist(l: ptr[LuaState], p: ptr[GCObject], limit: ptr[GCObject]) {
    unsafe {
        let mut localP: ptr[GCObject] = p
        while (localP != limit) {
            let mut next: ptr[GCObject] = localP.next
            freeobj(l, localP)
            localP = next
        }
    }
}

@Export
public func sweepstep(l: ptr[LuaState], g: ptr[GlobalState], nextstate: int, nextlist: ptr[ptr[GCObject]]): int {
    unsafe {
        if (g.sweepgc != 0) {
            let mut olddebt: LMem = g.gCdebt
            let mut count: int = 0
            g.sweepgc = sweeplist(l, g.sweepgc, 100, &count)
            g.gCestimate += (g.gCdebt - olddebt)
            return count
        } else {
            g.gcstate = nextstate
            g.sweepgc = nextlist
            return 0
        }
    }
}

@Export
public func singlestep(l: ptr[LuaState]): LuMem {
    unsafe {
        let mut g: ptr[GlobalState] = l.lG
        let mut work: LuMem = LuMem {}
        g.gcstopem = 1
        match g.gcstate {
            8 => {
                restartcollection(g)
                g.gcstate = 0
                work = 1
                break
            }
            0 => {
                if (g.gray == (nil as ptr[GCObject])) {
                    g.gcstate = 1
                    work = 0
                } else {
                    work = propagatemark(g)
                }
                break
            }
            1 => {
                work = atomic(l)
                entersweep(l)
                g.gCestimate = ((g.totalbytes + g.gCdebt) as LuMem)
                break
            }
            3 => {
                work = sweepstep(l, g, 4, &g.finobj)
                break
            }
            4 => {
                work = sweepstep(l, g, 5, &g.tobefnz)
                break
            }
            5 => {
                work = sweepstep(l, g, 6, (nil as ptr[ptr[GCObject]]))
                break
            }
            6 => {
                checkSizes(l, g)
                g.gcstate = 7
                work = 0
                break
            }
            7 => {
                if ((g.tobefnz != 0) && (g.gcemergency == 0)) {
                    g.gcstopem = 0
                    work = (runafewfinalizers(l, 10) * 50)
                } else {
                    g.gcstate = 8
                    work = 0
                }
                break
            }
            _ => {
                return 0
            }
        }
        g.gcstopem = 0
        return work
    }
}

@Export
public func incstep(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        let mut stepmul: int = ((g.gcstepmul * 4) | 1)
        let mut debt: LMem = ((g.gCdebt / 16) * (stepmul as usize))
        let mut stepsize: LMem = (if (g.gcstepsize <= ((8 * (8 as usize)) - (2 as usize))) {
((((1 as LMem) << g.gcstepsize) / 16) * (stepmul as usize))
} else {
(((~(0 as LuMem) as LuMem) >> 1) as LMem)
})
        while true {
            let mut work: LuMem = singlestep(l)
            debt -= (work as LMem)
            if !(((debt > -stepsize) && (g.gcstate != 8))) {
                break
            }
        }
        if (g.gcstate == 8) {
            setpause(g)
        } else {
            debt = ((debt / stepmul) * 16)
            luaESetdebt(g, debt)
        }
    }
}

@Export
public func fullinc(l: ptr[LuaState], g: ptr[GlobalState]) {
    unsafe {
        if (g.gcstate <= 2) {
            entersweep(l)
        }
        luaCRuntilstate(l, (1 << 8))
        luaCRuntilstate(l, (1 << 0))
        g.gcstate = 1
        luaCRuntilstate(l, (1 << 7))
        luaCRuntilstate(l, (1 << 8))
        setpause(g)
    }
}

@Export
public func lexerror(ls: ptr[LexState], msg: ptr[i8], token: int) {
    unsafe {
        let mut localMsg: ptr[i8] = msg
        localMsg = luaGAddinfo(ls.l, localMsg, ls.source, ls.linenumber)
        if (token != 0) {
            luaOPushfstring(ls.l, c"%s near %s", localMsg, txtToken(ls, token))
        }
        luaDThrow(ls.l, 3)
    }
}

@Export

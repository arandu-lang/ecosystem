@Export
public func forlist(ls: ptr[LexState], indexname: ptr[TString]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut e: Expdesc = Expdesc {}
        let mut nvars: int = 5
        let mut line: int = 0
        let mut base: int = fs.freereg
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))

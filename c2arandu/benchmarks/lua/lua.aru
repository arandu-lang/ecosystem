        return (if ((idx > 0) || (idx <= (-1000000 - 1000))) {
idx
} else {
((((l.top.p as isize) - (l.ci.funcVal.p as isize)) as int) + idx)
})
    }
}

@Export
public func luaGettop(l: ptr[LuaState]): int {
    unsafe {
        return (((l.top.p as isize) - ((l.ci.funcVal.p + (1 as StkId)) as isize)) as int)
    }
}

@Export
public func luaSettop(l: ptr[LuaState], idx: int) {
    unsafe {
        let mut ci: ptr[CallInfo] = nil
        let mut funcVal: StkId = StkId {}
        let mut newtop: StkId = StkId {}
        let mut diff: isize = 0

}

@Export
public func gRead(l: ptr[LuaState], f: ptr[FILE], first: int): int {
    unsafe {
        let mut nargs: int = (luaGettop(l) - 1)
        let mut n: int = 0
        let mut success: int = 0
        clearerr(f)
        let mut _tmp = ErrnoLocation()
        tmp[0] = 0
        if (nargs == 0) {
            success = readLine(l, f, 1)
            n = (first + 1)
        } else {
            luaLCheckstack(l, (nargs + 20), c"too many arguments")
            success = 1
            n = first
            while (((nargs - 1) != 0) && (success != 0)) {
                if (luaType(l, n) == 3) {
                    let mut l: usize = (luaLCheckinteger(l, n) as usize)
                    success = (if (l == (0 as usize)) {
testEof(l, f)
} else {
readChars(l, f, l)
})
                } else {
                    let mut p: ptr[i8] = luaLChecklstring(l, n, (nil as ptr[usize]))
                    if ((p[0] as int) == 42) {
                        p = p + 1
                    }
                    match (p[0] as int) {
                        110 => {
                            success = readNumber(l, f)
                        }
                        108 => {
                            success = readLine(l, f, 1)
                        }
                        76 => {
                            success = readLine(l, f, 0)
                        }
                        97 => {
                            readAll(l, f)
                        }
                        _ => {
                            success = 1
                            return luaLArgerror(l, n, c"invalid format")
                        }
                    }
                }
                n = n + 1
            }
        }
        if (ferror(f) != 0) {
            return luaLFileresult(l, 0, (nil as ptr[i8]))
        }
        if (success == 0) {
            luaSettop(l, (-1 - 1))
            luaPushnil(l)
        }
        return (n - first)
    }
}


@Export
public func luaLTraceback(l: ptr[LuaState], l1: ptr[LuaState], msg: ptr[i8], level: int) {
    unsafe {
        let mut localLevel: int = level
        let mut b: LuaLBuffer = LuaLBuffer {}
        let mut ar: LuaDebug = LuaDebug {}
        let mut last: int = lastlevel(l1)
        let mut limit2show: int = (if ((last - localLevel) > (10 + 11)) {
10
} else {
-1
})
        luaLBuffinit(l, &b)
        if (msg != 0) {
            luaLAddstring(&b, msg)

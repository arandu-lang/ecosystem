}

@Export
public func findsetreg(p: ptr[Proto], lastpc: int, reg: int): int {
    unsafe {
        let mut localLastpc: int = lastpc
        let mut pc: int = 0
        let mut setreg: int = -1
        let mut jmptarget: int = 0
        if ((luaPOpmodes[(((p.code[localLastpc] >> 0) & (~(~(0 as Instruction) << 7) << 0)) as OpCode)] & (1 << 7)) != 0) {
            localLastpc = localLastpc - 1
        }
        pc = nil
        while (pc < localLastpc) {
            let mut i: Instruction = p.code[pc]
            let mut op: OpCode = (((i >> 0) & (~(~(0 as Instruction) << 7) << 0)) as OpCode)
            let mut a: int = (((i >> (0 + 7)) & (~(~(0 as Instruction) << 8) << 0)) as int)
            let mut change: int = 0
            match op {
                8 => {
                    let mut b: int = (((i >> (((0 + 7) + 8) + 1)) & (~(~(0 as Instruction) << 8) << 0)) as int)
                    change = ((a <= reg) && (reg <= (a + b)))
                    break
                }
                76 => {
                    change = (reg >= (a + 2))
                    break
                }
                68 | 69 => {
                    change = (reg >= a)
                    break
                }
                56 => {
                    let mut b: int = ((((i >> (0 + 7)) & (~(~(0 as Instruction) << (((8 + 8) + 1) + 8)) << 0)) as int) - (((1 << (((8 + 8) + 1) + 8)) - 1) >> 1))
                    let mut dest: int = ((pc + 1) + b)
                    if ((dest <= localLastpc) && (dest > jmptarget)) {
                        jmptarget = dest
                    }
                    change = 0
                    break
                }
                _ => {
                    change = (((luaPOpmodes[op] & (1 << 3)) != 0) && (reg == a))
                }
            }
            if (change != 0) {
                setreg = filterpc(pc, jmptarget)
            }
            pc = pc + 1
        }
        return setreg
    }
}

@Export

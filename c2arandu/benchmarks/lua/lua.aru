                    }
                    localWanted = (-localWanted - 3)
                    if (localWanted == -1) {
                        localWanted = localNres
                    }
                }
            }
        }
        firstresult = (l.top.p - (localNres as StkId))
        if (localNres > localWanted) {
            localNres = localWanted
        }
        i = 0
        while (i < localNres) {
            let mut io1: ptr[TValue] = &localRes[(i as StkId)].val
            let mut io2: ptr[TValue] = &firstresult[(i as StkId)].val
            io1.value = io2.value
            io1.tt = io2.tt
            i = i + 1
        }
        while (i < localWanted) {
            localRes[(i as StkId)].val.tt = (0 | (0 << 4))
            i = i + 1
        }
        l.top.p = (localRes + (localWanted as StkId))
    }
}


@Export
public func basicgetobjname(p: ptr[Proto], ppc: ptr[int], reg: int, name: ptr[ptr[i8]]): ptr[i8] {
    unsafe {
        let mut pc: int = ppc[0]
        name[0] = luaFGetlocalname(p, (reg + 1), pc)
        if (name[0] != 0) {
            return c"local"
        }
        pc = findsetreg(p, pc, reg)
        ppc[0] = pc
        if (pc != -1) {
            let mut i: Instruction = p.code[pc]
            let mut op: OpCode = (((i >> 0) & (~(~(0 as Instruction) << 7) << 0)) as OpCode)
            match op {
                0 => {
                    let mut b: int = (((i >> (((0 + 7) + 8) + 1)) & (~(~(0 as Instruction) << 8) << 0)) as int)
                    if (b < (((i >> (0 + 7)) & (~(~(0 as Instruction) << 8) << 0)) as int)) {

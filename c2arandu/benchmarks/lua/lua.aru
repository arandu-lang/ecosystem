@Export
public func readNumber(l: ptr[LuaState], f: ptr[FILE]): int {
    unsafe {
        let mut rn: RN = RN {}
        let mut count: int = 0
        let mut hex: int = 0
        let mut decp: [2]i8 = [0; 2]
        rn.f = f
        rn.n = 0
        decp[0] = localeconv().decimalPoint[0]
        decp[1] = (46 as i8)
        while true {
            rn.c = getc(rn.f)
            if !((((CtypeBLoc()[0][(rn.c as int)] as int) & ((iSspace as u16) as int)) != 0)) {
                break
            }
        }
        test2(&rn, c"-+")
        if (test2(&rn, c"00") != 0) {
            if (test2(&rn, c"xX") != 0) {
                hex = 1
            } else {
                count = 1
            }
        }
        count += readdigits(&rn, hex)
        if (test2(&rn, decp) != 0) {
            count += readdigits(&rn, hex)
        }
        if ((count > 0) && (test2(&rn, (if (hex != 0) {
c"pP"
} else {
c"eE"
})) != 0)) {
            test2(&rn, c"-+")
            readdigits(&rn, 0)
        }
        ungetc(rn.c, rn.f)
        rn.buff[rn.n] = (0 as i8)
        if (((luaStringtonumber(l, rn.buff) != (0 as usize)) as i64) != 0) {
            return 1
        } else {
            luaPushnil(l)
            return 0
        }
    }
}


@Export
public func lastlevel(l: ptr[LuaState]): int {
    unsafe {
        let mut ar: LuaDebug = LuaDebug {}
        let mut li: int = 1
        let mut le: int = 1
        while (luaGetstack(l, le, &ar) != 0) {
            li = le
            le *= 2
        }
        while (li < le) {
            let mut m: int = ((li + le) / 2)
            if (luaGetstack(l, m, &ar) != 0) {
                li = (m + 1)
            } else {
                le = m
            }
        }
        return (le - 1)
    }
}


        let mut val: Expdesc = Expdesc {}
        if (ls.t.token == TK_NAME) {
            checklimit(fs, cc.nh, 2147483647, c"items in a constructor")
            codename(ls, &key)
        } else {
            yindex(ls, &key)
        }
        cc.nh = cc.nh + 1
        checknext(ls, 61)
        tab = cc.t[0]
        luaKIndexed(fs, &tab, &key)
        expr(ls, &val)
        luaKStorevar(fs, &tab, &val)
        fs.freereg = reg
    }
}

@Export
public func closelistfield(fs: ptr[FuncState], cc: ptr[ConsControl]) {
    unsafe {
        if (cc.v.k == (vVOID as uint)) {
            return
        }
        luaKExp2nextreg(fs, &cc.v)
        cc.v.k = vVOID
        if (cc.tostore == 50) {
            luaKSetlist(fs, cc.t.u.info, cc.na, cc.tostore)
            cc.na += cc.tostore
            cc.tostore = 0
        }
    }
}

@Export
public func lastlistfield(fs: ptr[FuncState], cc: ptr[ConsControl]) {
    unsafe {
        if (cc.tostore == 0) {
            return
        }
        if ((cc.v.k == (vCALL as uint)) || (cc.v.k == (vVARARG as uint))) {
            luaKSetreturns(fs, &cc.v, -1)
            luaKSetlist(fs, cc.t.u.info, cc.na, -1)
            cc.na = cc.na - 1
        } else {
            if (cc.v.k != (vVOID as uint)) {
                luaKExp2nextreg(fs, &cc.v)
            }
            luaKSetlist(fs, cc.t.u.info, cc.na, cc.tostore)
        }
        cc.na += cc.tostore
    }
}

@Export
public func listfield(ls: ptr[LexState], cc: ptr[ConsControl]) {
    unsafe {
        expr(ls, &cc.v)
        cc.tostore = cc.tostore + 1
    }
}

@Export
public func field(ls: ptr[LexState], cc: ptr[ConsControl]) {
    unsafe {
        match ls.t.token {
            291 => {
                if (luaXLookahead(ls) != 61) {
                    listfield(ls, cc)
                } else {
                    recfield(ls, cc)
                }
                break
            }
            91 => {
                recfield(ls, cc)
                break
            }
            _ => {
                listfield(ls, cc)
                break
            }
        }
    }
}

@Export
public func constructor(ls: ptr[LexState], t: ptr[Expdesc]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut line: int = ls.linenumber
        let mut pc: int = luaKCodeABCk(fs, OP_NEWTABLE, 0, 0, 0, 0)
        let mut cc: ConsControl = ConsControl {}
        luaKCode(fs, 0)
        cc.tostore = 0
        cc.nh = cc.tostore
        cc.na = cc.nh
        cc.t = t
        initExp(t, vNONRELOC, fs.freereg)
        luaKReserveregs(fs, 1)
        initExp(&cc.v, vVOID, 0)
        checknext(ls, 123)
        while true {
            if (ls.t.token == 125) {
                break
            }
            closelistfield(fs, &cc)
            field(ls, &cc)
            if !(((testnext(ls, 44) != 0) || (testnext(ls, 59) != 0))) {
                break
            }
        }
        checkMatch(ls, 125, 123, line)
        lastlistfield(fs, &cc)
        luaKSettablesize(fs, pc, t.u.info, cc.na, cc.nh)
    }
}

@Export
public func setvararg(fs: ptr[FuncState], nparams: int) {
    unsafe {
        fs.f.isVararg = 1
        luaKCodeABCk(fs, OP_VARARGPREP, nparams, 0, 0, 0)
    }
}

@Export
public func parlist(ls: ptr[LexState]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut f: ptr[Proto] = fs.f
        let mut nparams: int = 0
        let mut isvararg: int = 0
        if (ls.t.token != 41) {
            while true {
                match ls.t.token {
                    291 => {
                        newLocalvar(ls, strCheckname(ls))
                        nparams = nparams + 1
                        break
                    }
                    280 => {
                        luaXNext(ls)
                        isvararg = 1
                        break
                    }
                    _ => {
                        luaXSyntaxerror(ls, c"<name> or '...' expected")
                    }
                }
                if !(((isvararg == 0) && (testnext(ls, 44) != 0))) {
                    break
                }
            }
        }
        adjustlocalvars(ls, nparams)
        f.numparams = (fs.nactvar as LuByte)
        if (isvararg != 0) {
            setvararg(fs, f.numparams)
        }
        luaKReserveregs(fs, fs.nactvar)
    }
}

@Export
public func body(ls: ptr[LexState], e: ptr[Expdesc], ismethod: int, line: int) {
    unsafe {
        let mut newFs: FuncState = FuncState {}
        let mut bl: BlockCnt = BlockCnt {}
        newFs.f = addprototype(ls)
        newFs.f.linedefined = line
        openFunc(ls, &newFs, &bl)
        checknext(ls, 40)
        if (ismethod != 0) {
            newLocalvar(ls, luaXNewstring(ls, c"self", ((5 / 1) - (1 as usize))))
            adjustlocalvars(ls, 1)
        }
        parlist(ls)
        checknext(ls, 41)
        statlist(ls)
        newFs.f.lastlinedefined = ls.linenumber
        checkMatch(ls, TK_END, TK_FUNCTION, line)
        codeclosure(ls, e)
        closeFunc(ls)
    }
}

@Export
public func explist(ls: ptr[LexState], v: ptr[Expdesc]): int {
    unsafe {
        let mut n: int = 1
        expr(ls, v)
        while (testnext(ls, 44) != 0) {
            luaKExp2nextreg(ls.fs, v)
            expr(ls, v)
            n = n + 1
        }
        return n
    }
}

@Export
public func funcargs(ls: ptr[LexState], f: ptr[Expdesc]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut args: Expdesc = Expdesc {}
        let mut base: int = 0
        let mut nparams: int = 0
        let mut line: int = ls.linenumber
        match ls.t.token {
            40 => {
                luaXNext(ls)
                if (ls.t.token == 41) {
                    args.k = vVOID
                } else {
                    explist(ls, &args)
                    if ((args.k == (vCALL as uint)) || (args.k == (vVARARG as uint))) {
                        luaKSetreturns(fs, &args, -1)
                    }
                }
                checkMatch(ls, 41, 40, line)
                break
            }
            123 => {
                constructor(ls, &args)
                break
            }
            292 => {
                codestring(&args, ls.t.seminfo.ts)
                luaXNext(ls)
                break
            }
            _ => {
                luaXSyntaxerror(ls, c"function arguments expected")
            }
        }
        base = f.u.info
        if ((args.k == (vCALL as uint)) || (args.k == (vVARARG as uint))) {

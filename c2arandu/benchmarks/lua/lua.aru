                return c"for iterator"
            }
            20 | 11 | 12 | 13 | 14 => {
                tm = TM_INDEX
            }
            15 | 16 | 17 | 18 => {
                tm = TM_NEWINDEX
            }
            46 | 47 | 48 => {

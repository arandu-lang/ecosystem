        while true {
            let mut p: ptr[i8] = luaLPrepbuffsize(&b, (((((16 as usize) * 8) * 8) as int) as usize))
            nr = fread((p as ptr[u8]), 1, (((((16 as usize) * 8) * 8) as int) as usize), f)
            b.n += nr
            if !((nr == (((((16 as usize) * 8) * 8) as int) as usize))) {
                break

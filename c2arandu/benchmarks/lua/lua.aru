            settabsi(l, c"nparams", (ar.nparams as int))
            settabsb(l, c"isvararg", (ar.isvararg as int))
        }
        if (strchr(options, 110) != 0) {
            settabss(l, c"name", ar.name)
            settabss(l, c"namewhat", ar.namewhat)
        }
        if (strchr(options, 114) != 0) {

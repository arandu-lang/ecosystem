                3 => {
                    return kname(p, (((i >> ((0 + 7) + 8)) & (~(~(0 as Instruction) << ((8 + 8) + 1)) << 0)) as int), name)
                }
                4 => {
                    return kname(p, (((p.code[(pc + 1)] >> (0 + 7)) & (~(~(0 as Instruction) << (((8 + 8) + 1) + 8)) << 0)) as int), name)
                }
                _ => {
                }
            }
        }

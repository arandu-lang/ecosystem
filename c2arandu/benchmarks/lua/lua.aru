    return res
}

@Export
public func project(ran: LuaUnsigned, n: LuaUnsigned, state: ptr[RanState]): LuaUnsigned {
    unsafe {
        let mut localRan: LuaUnsigned = ran
        if ((n & (n + 1)) == 0) {
            return (localRan & n)
        } else {
            let mut lim: LuaUnsigned = n
            lim |= (lim >> 1)
            lim |= (lim >> 2)
            lim |= (lim >> 4)
            lim |= (lim >> 8)
            lim |= (lim >> 16)
            lim |= (lim >> 32)
            while true {

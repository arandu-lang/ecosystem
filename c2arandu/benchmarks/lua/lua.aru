@Export
public func moveresults(l: ptr[LuaState], res: StkId, nres: int, wanted: int) {
    unsafe {
        let mut localRes: StkId = res
        let mut localNres: int = nres
        let mut localWanted: int = wanted
        let mut firstresult: StkId = StkId {}
        let mut i: int = 0
        match localWanted {
            0 => {
                l.top.p = localRes
            }
            1 => {
                if (localNres == 0) {

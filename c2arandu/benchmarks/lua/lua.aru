            123 => {
                constructor(ls, v)
                return
            }
            264 => {
                luaXNext(ls)
                body(ls, v, 0, ls.linenumber)
                return
            }
            _ => {
                suffixedexp(ls, v)
                return
            }
        }
        luaXNext(ls)
    }
}

@Export
public func getunopr(op: int): UnOpr {
    match op {
        270 => {
            return OPR_NOT
        }
        45 => {
            return OPR_MINUS
        }
        126 => {
            return OPR_BNOT
        }
        35 => {
            return OPR_LEN
        }
        _ => {
            return OPR_NOUNOPR
        }
    }
}

@Export
public func getbinopr(op: int): BinOpr {
    match op {
        43 => {
            return OPR_ADD
        }
        45 => {
            return OPR_SUB
        }
        42 => {
            return OPR_MUL
        }
        37 => {
            return OPR_MOD
        }
        94 => {
            return OPR_POW
        }
        47 => {
            return OPR_DIV
        }
        278 => {
            return OPR_IDIV
        }
        38 => {
            return OPR_BAND
        }
        124 => {
            return OPR_BOR
        }
        126 => {
            return OPR_BXOR
        }
        285 => {
            return OPR_SHL
        }
        286 => {
            return OPR_SHR
        }
        279 => {
            return OPR_CONCAT
        }
        284 => {
            return OPR_NE
        }
        281 => {
            return OPR_EQ
        }
        60 => {
            return OPR_LT
        }
        283 => {
            return OPR_LE
        }
        62 => {
            return OPR_GT
        }
        282 => {
            return OPR_GE
        }
        256 => {
            return OPR_AND
        }
        271 => {
            return OPR_OR
        }
        _ => {
            return OPR_NOBINOPR
        }
    }
}

@Export
public func subexpr(ls: ptr[LexState], v: ptr[Expdesc], limit: int): BinOpr {
    unsafe {
        let mut op: BinOpr = BinOpr {}
        let mut uop: UnOpr = UnOpr {}
        luaEIncCstack(ls.l)
        uop = getunopr(ls.t.token)
        if (uop != (OPR_NOUNOPR as uint)) {
            let mut line: int = ls.linenumber
            luaXNext(ls)
            subexpr(ls, v, 12)
            luaKPrefix(ls.fs, uop, v, line)
        } else {
            simpleexp(ls, v)
        }
        op = getbinopr(ls.t.token)
        while ((op != (OPR_NOBINOPR as uint)) && (priority[op].left > limit)) {
            let mut v2: Expdesc = Expdesc {}
            let mut nextop: BinOpr = BinOpr {}
            let mut line: int = ls.linenumber
            luaXNext(ls)
            luaKInfix(ls.fs, op, v)
            nextop = subexpr(ls, &v2, priority[op].right)
            luaKPosfix(ls.fs, op, v, &v2, line)
            op = nextop
        }
        ls.l.nCcalls = ls.l.nCcalls - 1
        return op
    }
}

@Export
public func block(ls: ptr[LexState]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut bl: BlockCnt = BlockCnt {}
        enterblock(fs, &bl, 0)
        statlist(ls)
        leaveblock(fs)
    }
}

@Export
public func checkConflict(ls: ptr[LexState], lh: ptr[LHSAssign], v: ptr[Expdesc]) {
    unsafe {
        let mut localLh: ptr[LHSAssign] = lh
        let mut fs: ptr[FuncState] = ls.fs
        let mut extra: int = fs.freereg
        let mut conflict: int = 0
        while (localLh != 0) {
            if (((vINDEXED as uint) <= localLh.v.k) && (localLh.v.k <= (vINDEXSTR as uint))) {
                if (localLh.v.k == (vINDEXUP as uint)) {
                    if ((v.k == (vUPVAL as uint)) && (localLh.v.u.ind.t == v.u.info)) {
                        conflict = 1
                        localLh.v.k = vINDEXSTR
                        localLh.v.u.ind.t = extra
                    }
                } else {
                    if ((v.k == (vLOCAL as uint)) && (localLh.v.u.ind.t == v.u.var.ridx)) {
                        conflict = 1
                        localLh.v.u.ind.t = extra
                    }
                    if (((localLh.v.k == (vINDEXED as uint)) && (v.k == (vLOCAL as uint))) && ((localLh.v.u.ind.idx as int) == v.u.var.ridx)) {
                        conflict = 1
                        localLh.v.u.ind.idx = (extra as i16)
                    }
                }
            }
            localLh = localLh.prev
        }
        if (conflict != 0) {
            if (v.k == (vLOCAL as uint)) {
                luaKCodeABCk(fs, OP_MOVE, extra, v.u.var.ridx, 0, 0)
            } else {
                luaKCodeABCk(fs, OP_GETUPVAL, extra, v.u.info, 0, 0)
            }
            luaKReserveregs(fs, 1)
        }
    }
}

@Export
public func restassign(ls: ptr[LexState], lh: ptr[LHSAssign], nvars: int) {
    unsafe {
        let mut e: Expdesc = Expdesc {}
        if !(((vLOCAL as uint) <= lh.v.k) && (lh.v.k <= (vINDEXSTR as uint))) {
            luaXSyntaxerror(ls, c"syntax error")
        }
        checkReadonly(ls, &lh.v)
        if (testnext(ls, 44) != 0) {
            let mut nv: LHSAssign = LHSAssign {}
            nv.prev = lh
            suffixedexp(ls, &nv.v)
            if !(((vINDEXED as uint) <= nv.v.k) && (nv.v.k <= (vINDEXSTR as uint))) {
                checkConflict(ls, lh, &nv.v)
            }
            luaEIncCstack(ls.l)
            restassign(ls, &nv, (nvars + 1))
            ls.l.nCcalls = ls.l.nCcalls - 1
        } else {
            let mut nexps: int = 0
            checknext(ls, 61)
            nexps = explist(ls, &e)
            if (nexps != nvars) {
                adjustAssign(ls, nvars, nexps, &e)
            } else {
                luaKSetoneret(ls.fs, &e)
                luaKStorevar(ls.fs, &lh.v, &e)
                return
            }
        }
        initExp(&e, vNONRELOC, (ls.fs.freereg - 1))
        luaKStorevar(ls.fs, &lh.v, &e)
    }
}

@Export
public func cond(ls: ptr[LexState]): int {
    unsafe {
        let mut v: Expdesc = Expdesc {}
        expr(ls, &v)
        if (v.k == (vNIL as uint)) {
            v.k = vFALSE
        }
        luaKGoiftrue(ls.fs, &v)
        return v.f
    }
}

@Export
public func gotostat(ls: ptr[LexState]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut line: int = ls.linenumber
        let mut name: ptr[TString] = strCheckname(ls)
        let mut lb: ptr[Labeldesc] = findlabel(ls, name)
        if (lb == (nil as ptr[Labeldesc])) {
            newgotoentry(ls, name, line, luaKJump(fs))
        } else {
            let mut lblevel: int = reglevel(fs, lb.nactvar)
            if (luaYNvarstack(fs) > lblevel) {
                luaKCodeABCk(fs, OP_CLOSE, lblevel, 0, 0, 0)
            }
            luaKPatchlist(fs, luaKJump(fs), lb.pc)
        }
    }
}

@Export
public func breakstat(ls: ptr[LexState]) {
    unsafe {
        let mut line: int = ls.linenumber
        luaXNext(ls)
        newgotoentry(ls, luaSNewlstr(ls.l, c"break", ((6 / 1) - (1 as usize))), line, luaKJump(ls.fs))
    }

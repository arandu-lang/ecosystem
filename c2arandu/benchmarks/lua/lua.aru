@Export
public func luaNewstate(f: LuaAlloc, ud: ptr[u8]): ptr[LuaState] {
    unsafe {
        let mut i: int = 0
        let mut l: ptr[LuaState] = nil
        let mut g: ptr[GlobalState] = nil
        let mut l: ptr[LG] = (f[0](ud, nil, (8 as usize), 1624) as ptr[LG])
        if (l == (nil as ptr[LG])) {
            return (nil as ptr[LuaState])
        }
        l = &l.l.l
        g = &l.g
        l.tt = (8 | (0 << 4))
        g.currentwhite = (1 << 3)
        l.marked = ((g.currentwhite & ((1 << 3) | (1 << 4))) as LuByte)
        preinitThread(l, g)
        g.allgc = &(l as ptr[GCUnion]).gc
        l.next = (nil as ptr[GCObject])
        l.nCcalls += 65536
        g.frealloc = f
        g.ud = ud
        g.warnf = nil
        g.udWarn = nil
        g.mainthread = l
        g.seed = luaiMakeseed(l)
        g.gcstp = 2
        g.strt.nuse = 0
        g.strt.size = g.strt.nuse
        g.strt.hash = (nil as ptr[ptr[TString]])
        g.lRegistry.tt = (0 | (0 << 4))
        g.panic = nil
        g.gcstate = 8
        g.gckind = 0
        g.gcstopem = 0
        g.gcemergency = 0
        g.fixedgc = (nil as ptr[GCObject])
        g.tobefnz = g.fixedgc
        g.finobj = g.tobefnz
        g.reallyold = (nil as ptr[GCObject])
        g.old1 = g.reallyold
        g.survival = g.old1
        g.firstold1 = g.survival
        g.finobjrold = (nil as ptr[GCObject])
        g.finobjold1 = g.finobjrold
        g.finobjsur = g.finobjold1
        g.sweepgc = (nil as ptr[ptr[GCObject]])
        g.grayagain = (nil as ptr[GCObject])
        g.gray = g.grayagain
        g.allweak = (nil as ptr[GCObject])
        g.ephemeron = g.allweak
        g.weak = g.ephemeron
        g.twups = (nil as ptr[LuaState])
        g.totalbytes = 1624
        g.gCdebt = 0
        g.lastatomic = 0
        let mut io: ptr[TValue] = &g.nilvalue
        io.value.i = 0
        io.tt = (3 | (0 << 4))
        g.gcpause = (200 / 4)
        g.gcstepmul = (100 / 4)
        g.gcstepsize = 13
        g.genmajormul = (100 / 4)
        g.genminormul = 20
        i = 0
        while (i < 9) {
            g.mt[i] = (nil as ptr[Table])
            i = i + 1
        }
        if (luaDRawrunprotected(l, fLuaopen, nil) != 0) {
            closeState(l)
            l = (nil as ptr[LuaState])
        }
        return l
    }
}

@Export
public func luaClose(l: ptr[LuaState]) {
    unsafe {
        let mut localL: ptr[LuaState] = l
        localL = localL.lG.mainthread
        closeState(localL)
    }
}

@Export
public func luaNewthread(l: ptr[LuaState]): ptr[LuaState] {
    unsafe {
        let mut g: ptr[GlobalState] = l.lG
        let mut o: ptr[GCObject] = nil
        let mut l1: ptr[LuaState] = nil
        if (l.lG.gCdebt > 0) {
            luaCStep(l)
        }
        o = luaCNewobjdt(l, 8, 208, LX)
        l1 = &(o as ptr[GCUnion]).th
        let mut io: ptr[TValue] = &l.top.p.val
        let mut x: ptr[LuaState] = l1
        io.value.gc = &(x as ptr[GCUnion]).gc
        io.tt = ((8 | (0 << 4)) | (1 << 6))
        preinitThread(l1, g)
        l1.hookmask = l.hookmask
        l1.basehookcount = l.basehookcount
        l1.hook = l.hook
        l1.hookcount = l1.basehookcount
        memcpy((((l1 as ptr[i8]) - 8) as ptr[u8]), (((g.mainthread as ptr[i8]) - 8) as ptr[u8]), 8)
        stackInit(l1, l)
        return l1
    }
}

@Export
public func luaClosethread(l: ptr[LuaState], from: ptr[LuaState]): int {
    unsafe {
        let mut status: int = 0
        l.nCcalls = (if (from != 0) {
(from.nCcalls & 65535)
} else {
0
})
        status = luaEResetthread(l, l.status)
        return status
    }
}

@Export
public func luaResetthread(l: ptr[LuaState]): int {
    unsafe {
        return luaClosethread(l, (nil as ptr[LuaState]))
    }
}

@Export
public func luaAtpanic(l: ptr[LuaState], panicf: LuaCFunction): LuaCFunction {
    unsafe {
        let mut old: LuaCFunction = LuaCFunction {}
        old = l.lG.panic
        l.lG.panic = panicf
        return old
    }
}


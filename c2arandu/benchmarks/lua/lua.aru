            nparams = (fs.freereg - (base + 1))
        }
        initExp(f, vCALL, luaKCodeABCk(fs, OP_CALL, base, (nparams + 1), 2, 0))
        luaKFixline(fs, line)
        fs.freereg = (base + 1)
    }
}

@Export
public func primaryexp(ls: ptr[LexState], v: ptr[Expdesc]) {
    unsafe {
        match ls.t.token {
            40 => {
                let mut line: int = ls.linenumber
                luaXNext(ls)
                expr(ls, v)
                checkMatch(ls, 41, 40, line)

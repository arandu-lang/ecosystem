        luaLBuffinit(l, &b)
        p = luaLPrepbuffsize(&b, n)
        nr = fread((p as ptr[u8]), 1, n, f)
        b.n += nr
        luaLPushresult(&b)
        return ((nr > (0 as usize)) as int)

                return
            }
            291 => {
                singlevar(ls, v)
                return
            }
            _ => {
                luaXSyntaxerror(ls, c"unexpected symbol")
            }
        }
    }
}

@Export
public func suffixedexp(ls: ptr[LexState], v: ptr[Expdesc]) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        primaryexp(ls, v)
        while true {
            match ls.t.token {
                46 => {
                    fieldsel(ls, v)
                    break
                }
                91 => {

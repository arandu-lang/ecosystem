                        return c"method"
                    }
                    _ => {
                    }
                }
            }
        }
        return (nil as ptr[i8])
    }
}

@Export
public func funcnamefromcode(l: ptr[LuaState], p: ptr[Proto], pc: int, name: ptr[ptr[i8]]): ptr[i8] {
    unsafe {
        let mut tm: TMS = (0 as TMS)
        let mut i: Instruction = p.code[pc]
        match (((i >> 0) & (~(~(0 as Instruction) << 7) << 0)) as OpCode) {
            68 | 69 => {

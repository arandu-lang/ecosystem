@Export
public func checkrepeated(ls: ptr[LexState], name: ptr[TString]) {
    unsafe {
        let mut lb: ptr[Labeldesc] = findlabel(ls, name)
        if ((((lb != (nil as ptr[Labeldesc])) != nil) as i64) != 0) {
            let mut msg: ptr[i8] = c"label '%s' already defined on line %d"
            msg = luaOPushfstring(ls.l, msg, name.contents, lb.line)
            luaKSemerror(ls, msg)
        }
    }
}

@Export
public func labelstat(ls: ptr[LexState], name: ptr[TString], line: int) {
    unsafe {
        checknext(ls, TK_DBCOLON)
        while ((ls.t.token == 59) || (ls.t.token == TK_DBCOLON)) {
            statement(ls)
        }
        checkrepeated(ls, name)
        createlabel(ls, name, line, blockFollow(ls, 0))
    }
}

@Export
public func whilestat(ls: ptr[LexState], line: int) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut whileinit: int = 0
        let mut condexit: int = 0
        let mut bl: BlockCnt = BlockCnt {}
        luaXNext(ls)
        whileinit = luaKGetlabel(fs)
        condexit = cond(ls)
        enterblock(fs, &bl, 1)
        checknext(ls, TK_DO)
        block(ls)
        luaKPatchlist(fs, luaKJump(fs), whileinit)
        checkMatch(ls, TK_END, TK_WHILE, line)
        leaveblock(fs)
        luaKPatchtohere(fs, condexit)
    }
}

@Export
public func repeatstat(ls: ptr[LexState], line: int) {
    unsafe {
        let mut condexit: int = 0
        let mut fs: ptr[FuncState] = ls.fs
        let mut repeatInit: int = luaKGetlabel(fs)
        let mut bl1: BlockCnt = BlockCnt {}
        let mut bl2: BlockCnt = BlockCnt {}
        enterblock(fs, &bl1, 1)
        enterblock(fs, &bl2, 0)
        luaXNext(ls)
        statlist(ls)
        checkMatch(ls, TK_UNTIL, TK_REPEAT, line)
        condexit = cond(ls)
        leaveblock(fs)
        if (bl2.upval != 0) {
            let mut exit: int = luaKJump(fs)
            luaKPatchtohere(fs, condexit)
            luaKCodeABCk(fs, OP_CLOSE, reglevel(fs, bl2.nactvar), 0, 0, 0)
            condexit = luaKJump(fs)
            luaKPatchtohere(fs, exit)
        }
        luaKPatchlist(fs, condexit, repeatInit)
        leaveblock(fs)
    }
}

@Export
public func exp1(ls: ptr[LexState]) {
    unsafe {
        let mut e: Expdesc = Expdesc {}
        expr(ls, &e)
        luaKExp2nextreg(ls.fs, &e)
    }
}

@Export
public func fixforjump(fs: ptr[FuncState], pc: int, dest: int, back: int) {
    unsafe {
        let mut jmp: ptr[Instruction] = &fs.f.code[pc]
        let mut offset: int = (dest - (pc + 1))
        if (back != 0) {
            offset = -offset
        }
        if ((((offset > ((1 << ((8 + 8) + 1)) - 1)) != 0) as i64) != 0) {
            luaXSyntaxerror(fs.ls, c"control structure too long")
        }
        jmp[0] = ((jmp[0] & ~(~(~(0 as Instruction) << ((8 + 8) + 1)) << ((0 + 7) + 8))) | (((offset as Instruction) << ((0 + 7) + 8)) & (~(~(0 as Instruction) << ((8 + 8) + 1)) << ((0 + 7) + 8))))
    }
}

@Export
public func forbody(ls: ptr[LexState], base: int, line: int, nvars: int, isgen: int) {
    unsafe {
        let mut forprep: [2]OpCode = [OP_FORPREP, OP_TFORPREP]
        let mut forloop: [2]OpCode = [OP_FORLOOP, OP_TFORLOOP]
        let mut bl: BlockCnt = BlockCnt {}
        let mut fs: ptr[FuncState] = ls.fs
        let mut prep: int = 0
        let mut endfor: int = 0
        checknext(ls, TK_DO)
        prep = luaKCodeABx(fs, forprep[isgen], base, (0 as uint))
        enterblock(fs, &bl, 0)
        adjustlocalvars(ls, nvars)
        luaKReserveregs(fs, nvars)
        block(ls)
        leaveblock(fs)
        fixforjump(fs, prep, luaKGetlabel(fs), 0)
        if (isgen != 0) {
            luaKCodeABCk(fs, OP_TFORCALL, base, 0, nvars, 0)
            luaKFixline(fs, line)
        }
        endfor = luaKCodeABx(fs, forloop[isgen], base, (0 as uint))
        fixforjump(fs, endfor, (prep + 1), 1)
        luaKFixline(fs, line)
    }
}

@Export
public func fornum(ls: ptr[LexState], varname: ptr[TString], line: int) {
    unsafe {
        let mut fs: ptr[FuncState] = ls.fs
        let mut base: int = fs.freereg
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, luaXNewstring(ls, c"(for state)", ((12 / 1) - (1 as usize))))
        newLocalvar(ls, varname)
        checknext(ls, 61)
        exp1(ls)
        checknext(ls, 44)
        exp1(ls)

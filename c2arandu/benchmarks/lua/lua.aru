@Export
public func readLine(l: ptr[LuaState], f: ptr[FILE], chop: int): int {
    unsafe {
        let mut b: LuaLBuffer = LuaLBuffer {}
        let mut c: int = 0
        luaLBuffinit(l, &b)
        while true {
            let mut buff: ptr[i8] = luaLPrepbuffsize(&b, (((((16 as usize) * 8) * 8) as int) as usize))
            let mut i: int = 0
            while true {
                c = getc(f)
                if !((((i < ((((16 as usize) * 8) * 8) as int)) && (c != -1)) && (c != 10))) {
                    break
                }
                buff[(i + 1)] = (c as i8)
            }
            b.n += (i as usize)
            if !(((c != -1) && (c != 10))) {
                break
            }
        }
        if ((chop == 0) && (c == 10)) {
            b.b[-b.n] = (c as i8)
        }
        luaLPushresult(&b)
        return (((c == 10) || (luaRawlen(l, -1) > 0)) as int)
    }
}


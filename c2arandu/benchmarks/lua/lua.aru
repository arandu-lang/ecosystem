    }
}

@Export
public func getobjname(p: ptr[Proto], lastpc: int, reg: int, name: ptr[ptr[i8]]): ptr[i8] {
    unsafe {
        let mut kind: ptr[i8] = basicgetobjname(p, &lastpc, reg, name)
        if (kind != (nil as ptr[i8])) {
            return kind
        } else {
            if (lastpc != -1) {
                let mut i: Instruction = p.code[lastpc]
                let mut op: OpCode = (((i >> 0) & (~(~(0 as Instruction) << 7) << 0)) as OpCode)
                match op {
                    11 => {

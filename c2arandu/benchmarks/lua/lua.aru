@Export
public func ioReadline(l: ptr[LuaState]): int {
    unsafe {
        let mut p: ptr[LStream] = (luaTouserdata(l, ((-1000000 - 1000) - 1)) as ptr[LStream])
        let mut i: int = 0
        let mut n: int = (luaTointegerx(l, ((-1000000 - 1000) - 2), (nil as ptr[int])) as int)
        if (p.closef == nil) {
            return luaLError(l, c"file is already closed")
        }
        luaSettop(l, 1)
        luaLCheckstack(l, n, c"too many arguments")
        i = 1
        while (i <= n) {
            luaPushvalue(l, ((-1000000 - 1000) - (3 + i)))
            i = i + 1
        }
        n = gRead(l, p.f, 2)
        if (luaToboolean(l, -n) != 0) {
            return n
        } else {
            if (n > 1) {
                return luaLError(l, c"%s", luaTolstring(l, (-n + 1), (nil as ptr[usize])))
            }
            if (luaToboolean(l, ((-1000000 - 1000) - 3)) != 0) {
                luaSettop(l, 0)
                luaPushvalue(l, ((-1000000 - 1000) - 1))
                auxClose(l)
            }
            return 0
        }
    }
}


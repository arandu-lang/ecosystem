@Export
public func txtToken(ls: ptr[LexState], token: int): ptr[i8] {
    unsafe {
        match token {
            291 | 292 | 289 | 290 => {
                save(ls, 0)
            }
            _ => {
                return luaOPushfstring(ls.l, c"'%s'", ls.buff.buffer)
                return luaXToken2str(ls, token)
            }
        }
    }
}

@Export

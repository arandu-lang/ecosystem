@Export
public func sortComp(l: ptr[LuaState], a: int, b: int): int {
    unsafe {
        if (luaType(l, 2) == 0) {
            return luaCompare(l, a, b, 1)
        } else {
            let mut res: int = 0
            luaPushvalue(l, 2)
            luaPushvalue(l, (a - 1))
            luaPushvalue(l, (b - 2))
            luaCallk(l, 2, 1, 0, nil)
            res = luaToboolean(l, -1)
            luaSettop(l, (-1 - 1))
            return res
        }
    }
}

@Export
public func partition(l: ptr[LuaState], lo: IdxT, up: IdxT): IdxT {
    unsafe {
        let mut i: IdxT = lo
        let mut j: IdxT = (up - 1)
        while true {
            while (sortComp(l, -1, -2) != 0) {
                if ((((i == (up - 1)) != 0) as i64) != 0) {
                    luaLError(l, c"invalid order function for sorting")
                }
                luaSettop(l, (-1 - 1))
            }
            while (sortComp(l, -3, -1) != 0) {
                if ((((j < i) != 0) as i64) != 0) {
                    luaLError(l, c"invalid order function for sorting")
                }
                luaSettop(l, (-1 - 1))
            }
            if (j < i) {
                luaSettop(l, (-1 - 1))
                set2(l, (up - 1), i)
                return i
            }
            set2(l, i, j)
        }
    }
}

@Export
public func choosePivot(lo: IdxT, up: IdxT, rnd: uint): IdxT {
    let mut r4: IdxT = ((up - lo) / 4)
    let mut p: IdxT = ((rnd % ((r4 * 2) as uint)) + ((lo + r4) as uint))
    return p
}

@Export
public func auxsort(l: ptr[LuaState], lo: IdxT, up: IdxT, rnd: uint) {
    unsafe {
        let mut localLo: IdxT = lo
        let mut localUp: IdxT = up
        let mut localRnd: uint = rnd
        while (localLo < localUp) {
            let mut p: IdxT = IdxT {}
            let mut n: IdxT = IdxT {}
            luaGeti(l, 1, localLo)
            luaGeti(l, 1, localUp)
            if (sortComp(l, -1, -2) != 0) {
                set2(l, localLo, localUp)
            } else {
                luaSettop(l, (-2 - 1))
            }
            if ((localUp - localLo) == 1) {
                return
            }
            if ((((localUp - localLo) as uint) < 100) || (localRnd == (0 as uint))) {
                p = ((localLo + localUp) / 2)
            } else {
                p = choosePivot(localLo, localUp, localRnd)
            }
            luaGeti(l, 1, p)
            luaGeti(l, 1, localLo)
            if (sortComp(l, -2, -1) != 0) {
                set2(l, p, localLo)
            } else {
                luaSettop(l, (-1 - 1))
                luaGeti(l, 1, localUp)
                if (sortComp(l, -1, -2) != 0) {
                    set2(l, p, localUp)
                } else {
                    luaSettop(l, (-2 - 1))
                }
            }
            if ((localUp - localLo) == 2) {
                return
            }
            luaGeti(l, 1, p)
            luaPushvalue(l, -1)
            luaGeti(l, 1, (localUp - 1))
            set2(l, p, (localUp - 1))
            p = partition(l, localLo, localUp)
            if ((p - localLo) < (localUp - p)) {
                auxsort(l, localLo, (p - 1), localRnd)
                n = (p - localLo)
                localLo = (p + 1)
            } else {
                auxsort(l, (p + 1), localUp, localRnd)
                n = (localUp - p)
                localUp = (p - 1)
            }
            if (((localUp - localLo) / 128) > n) {
                localRnd = lRandomizePivot()
            }
        }
    }
}

@Export
public func sort(l: ptr[LuaState]): int {
    unsafe {
        let mut n: LuaInteger = luaLLen(l, 1)
        if (n > 1) {
            if !(luaType(l, 2) <= 0) {
                luaLChecktype(l, 2, 6)
            }
            luaSettop(l, 2)
            auxsort(l, 1, (n as IdxT), (0 as uint))
        }
        return 0
    }
}

@Export
public func uPosrelat(pos: LuaInteger, len: usize): LuaInteger {
    if (pos >= 0) {
        return pos
    } else {
        if (((0 as usize) - (pos as usize)) > len) {
            return 0
        } else {
            return (((len as LuaInteger) + pos) + 1)
        }
    }
}

@Export
public func utf8Decode(s: ptr[i8], val: ptr[Utfint], strict: int): ptr[i8] {
    unsafe {
        let mut localS: ptr[i8] = s
        let mut limits: [6]Utfint = [~(0 as Utfint), 128, 2048, 65536, 2097152, 67108864]
        let mut c: uint = ((localS[0] as u8) as uint)
        let mut res: Utfint = 0
        if (c < (128 as uint)) {
            res = (c as Utfint)
        } else {
            let mut count: int = 0
            while ((c & (64 as uint)) != 0) {
                let mut cc: uint = ((localS[(count + 1)] as u8) as uint)
                if !((cc & (192 as uint)) == (128 as uint)) {
                    return (nil as ptr[i8])
                }
                res = ((((res << 6) as uint) | (cc & (63 as uint))) as Utfint)
                c <<= (1 as uint)
            }
            res |= (((c & (127 as uint)) as Utfint) << (count * 5))
            if (((count > 5) || ((res as uint) > 2147483647)) || (res < limits[count])) {
                return (nil as ptr[i8])
            }
            localS = (localS + (count as usize))
        }
        if (strict != 0) {
            if (((res as uint) > 1114111) || ((55296 <= (res as uint)) && ((res as uint) <= 57343))) {
                return (nil as ptr[i8])
            }
        }
        if (val != 0) {
            val[0] = res
        }
        return (localS + (1 as usize))
    }
}

@Export
public func utflen(l: ptr[LuaState]): int {
    unsafe {
        let mut n: LuaInteger = 0
        let mut len: usize = 0
        let mut s: ptr[i8] = luaLChecklstring(l, 1, &len)
        let mut posi: LuaInteger = uPosrelat(luaLOptinteger(l, 2, 1), len)
        let mut posj: LuaInteger = uPosrelat(luaLOptinteger(l, 3, -1), len)
        let mut lax: int = luaToboolean(l, 4)
        while (posi <= posj) {
            let mut s1: ptr[i8] = utf8Decode((s + (posi as usize)), (nil as ptr[Utfint]), (lax == 0))
            if (s1 == (nil as ptr[i8])) {
                luaPushnil(l)
                luaPushinteger(l, (posi + 1))
                return 2
            }
            posi = (s1 - (s as usize))
            n = n + 1
        }
        luaPushinteger(l, n)
        return 1
    }
}

@Export
public func codepoint(l: ptr[LuaState]): int {
    unsafe {
        let mut len: usize = 0
        let mut s: ptr[i8] = luaLChecklstring(l, 1, &len)
        let mut posi: LuaInteger = uPosrelat(luaLOptinteger(l, 2, 1), len)
        let mut pose: LuaInteger = uPosrelat(luaLOptinteger(l, 3, posi), len)
        let mut lax: int = luaToboolean(l, 4)
        let mut n: int = 0
        let mut se: ptr[i8] = nil
        if (posi > pose) {
            return 0
        }
        if ((pose - posi) >= 2147483647) {
            return luaLError(l, c"string slice too long")
        }
        n = (((pose - posi) as int) + 1)
        luaLCheckstack(l, n, c"string slice too long")
        n = 0
        se = (s + (pose as usize))
        s = (s + ((posi - 1) as usize))
        while (s < se) {
            let mut code: Utfint = Utfint {}
            s = utf8Decode(s, &code, (lax == 0))
            if (s == (nil as ptr[i8])) {
                return luaLError(l, c"invalid UTF-8 code")
            }
            luaPushinteger(l, code)
            n = n + 1
        }
        return n
    }
}

@Export
public func pushutfchar(l: ptr[LuaState], arg: int) {
    unsafe {
        let mut code: LuaUnsigned = (luaLCheckinteger(l, arg) as LuaUnsigned)
        luaPushfstring(l, c"%U", (code as i64))
    }
}

@Export
public func utfchar(l: ptr[LuaState]): int {
    unsafe {
        let mut n: int = luaGettop(l)
        if (n == 1) {
            pushutfchar(l, 1)
        } else {
            let mut i: int = 0
            let mut b: LuaLBuffer = LuaLBuffer {}
            luaLBuffinit(l, &b)
            i = 1
            while (i <= n) {
                pushutfchar(l, i)
                luaLAddvalue(&b)
                i = i + 1
            }
            luaLPushresult(&b)
        }
        return 1
    }
}

@Export
public func byteoffset(l: ptr[LuaState]): int {
    unsafe {
        let mut len: usize = 0
        let mut s: ptr[i8] = luaLChecklstring(l, 1, &len)
        let mut n: LuaInteger = luaLCheckinteger(l, 2)
        let mut posi: LuaInteger = (if (n >= 0) {
(1 as usize)
} else {
(len + (1 as usize))
})
        posi = uPosrelat(luaLOptinteger(l, 3, posi), len)
        if (n == 0) {
            while ((posi > 0) && ((((s + (posi as usize))[0] as int) & 192) == 128)) {
                posi = posi - 1
            }
        } else {
            if ((((s + (posi as usize))[0] as int) & 192) == 128) {
                return luaLError(l, c"initial position is a continuation byte")
            }
            if (n < 0) {
                while ((n < 0) && (posi > 0)) {
                    while true {
                        posi = posi - 1
                        if !(((posi > 0) && ((((s + (posi as usize))[0] as int) & 192) == 128))) {
                            break
                        }
                    }
                    n = n + 1
                }
            } else {
                n = n - 1
                while ((n > 0) && (posi < (len as LuaInteger))) {
                    while true {
                        posi = posi + 1
                        if !(((((s + (posi as usize))[0] as int) & 192) == 128)) {
                            break
                        }
                    }
                    n = n - 1
                }
            }
        }
        if (n == 0) {
            luaPushinteger(l, (posi + 1))
        } else {
            luaPushnil(l)
        }
        return 1
    }
}

@Export
public func iterAux(l: ptr[LuaState], strict: int): int {
    unsafe {
        let mut len: usize = 0
        let mut s: ptr[i8] = luaLChecklstring(l, 1, &len)
        let mut n: LuaUnsigned = (luaTointegerx(l, 2, (nil as ptr[int])) as LuaUnsigned)
        if (n < len) {
            while ((((s + (n as usize))[0] as int) & 192) == 128) {
                n = n + 1
            }
        }
        if (n >= len) {
            return 0
        } else {
            let mut code: Utfint = Utfint {}
            let mut next: ptr[i8] = utf8Decode((s + (n as usize)), &code, strict)
            if ((next == (nil as ptr[i8])) || (((next[0] as int) & 192) == 128)) {
                return luaLError(l, c"invalid UTF-8 code")
            }
            luaPushinteger(l, (n + 1))
            luaPushinteger(l, code)
            return 2
        }
    }
}

@Export
public func iterAuxstrict(l: ptr[LuaState]): int {
    unsafe {
        return iterAux(l, 1)
    }
}

@Export
public func iterAuxlax(l: ptr[LuaState]): int {
    unsafe {
        return iterAux(l, 0)
    }
}

@Export
public func iterCodes(l: ptr[LuaState]): int {
    unsafe {
        let mut lax: int = luaToboolean(l, 2)
        let mut s: ptr[i8] = luaLChecklstring(l, 1, (nil as ptr[usize]))
        luaPushcclosure(l, (if (lax != 0) {
iterAuxlax
} else {
iterAuxstrict
}), 0)
        luaPushvalue(l, 1)
        luaPushinteger(l, 0)
        return 3
    }
}


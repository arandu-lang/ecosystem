@Export
public func simpleexp(ls: ptr[LexState], v: ptr[Expdesc]) {
    unsafe {
        match ls.t.token {
            289 => {
                initExp(v, vKFLT, 0)
                v.u.nval = ls.t.seminfo.r
                break
            }
            290 => {
                initExp(v, vKINT, 0)
                v.u.ival = ls.t.seminfo.i
                break
            }
            292 => {
                codestring(v, ls.t.seminfo.ts)
                break
            }
            269 => {
                initExp(v, vNIL, 0)
                break
            }
            275 => {
                initExp(v, vTRUE, 0)
                break
            }
            262 => {
                initExp(v, vFALSE, 0)
                break
            }
            280 => {
                let mut fs: ptr[FuncState] = ls.fs
                if (fs.f.isVararg == 0) {
                    luaXSyntaxerror(ls, c"cannot use '...' outside a vararg function")

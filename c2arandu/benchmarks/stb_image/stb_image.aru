                        let mut left: int = width
                        let mut i: int = 0
                        while (left > 0) {
                            let mut count: StbiUc = StbiUc {}
                            let mut value: [4]StbiUc = [StbiUc {}; 4]
                            count = stbiGet8(s)
                            if (stbiAtEof(s) != 0) {

            s = s + 1
        }
        if (s >= 16) {
            return -1
        }
        b = (((k >> (16 - s)) - z.firstcode[s]) + z.firstsymbol[s])
        if (b >= 288) {
            return -1
        }
        if (z.size[b] != s) {
            return -1
        }
        a.codeBuffer >>= s
        a.numBits -= s
        return z.value[b]
    }
}

@Export
public func stbiZhuffmanDecode(a: ptr[StbiZbuf], z: ptr[StbiZhuffman]): int {
    unsafe {
        let mut b: int = 0
        let mut s: int = 0
        if (a.numBits < 16) {
            if (stbiZeof(a) != 0) {

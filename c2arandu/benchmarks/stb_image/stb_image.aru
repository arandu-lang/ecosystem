@Export
public func stbiLoadfMain(s: ptr[StbiContext], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[f32] {
    unsafe {
        let mut data: ptr[u8] = nil
        if (stbiHdrTest(s) != 0) {
            let mut ri: StbiResultInfo = StbiResultInfo {}
            let mut hdrData: ptr[f32] = stbiHdrLoad(s, x, y, comp, reqComp, &ri)

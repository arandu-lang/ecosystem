// --- Assinaturas de Funções Externas C (libc & POSIX) ---
extern "C" {
    func memset(dest: ptr[u8], val: int, len: usize): ptr[u8]
    func memcpy(dest: ptr[u8], src: ptr[u8], len: usize): ptr[u8]
    func malloc(size: usize): ptr[u8]
    func free(ptr_val: ptr[u8])
    func realloc(ptr_val: ptr[u8], size: usize): ptr[u8]
    func strcmp(s1: ptr[i8], s2: ptr[i8]): int
    func strncmp(s1: ptr[i8], s2: ptr[i8], n: usize): int
    func strtol(nptr: ptr[i8], endptr: ptr[ptr[i8]], base: int): i64
    func fopen(filename: ptr[i8], mode: ptr[i8]): ptr[FILE]
    func fclose(stream: ptr[FILE]): int
    func fseek(stream: ptr[FILE], offset: i64, whence: int): int
    func ftell(stream: ptr[FILE]): i64
    func fread(ptr_val: ptr[u8], size: usize, nmemb: usize, stream: ptr[FILE]): usize
    func fgetc(stream: ptr[FILE]): int
    func ungetc(c: int, stream: ptr[FILE]): int
    func feof(stream: ptr[FILE]): int
    func ferror(stream: ptr[FILE]): int
    func abs(n: int): int
    func pow(base: f64, exp: f64): f64
    func ldexp(x: f64, exp: int): f64
}

// --- Funções Definidas e Transpiladas ---
@Export
public func stbiLoadFromMemory(buffer: ptr[StbiUc], len: int, x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUc] {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartMem(&s, buffer, len)
        return stbiLoadAndPostprocess8bit(&s, x, y, comp, reqComp)
    }
}

@Export
public func stbiLoadFromCallbacks(clbk: ptr[StbiIoCallbacks], user: ptr[u8], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUc] {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartCallbacks(&s, (clbk as ptr[StbiIoCallbacks]), user)
        return stbiLoadAndPostprocess8bit(&s, x, y, comp, reqComp)
    }
}

@Export
public func stbiLoad(filename: ptr[i8], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUc] {
    unsafe {
        let mut f: ptr[FILE] = stbiFopen(filename, c"rb")
        let mut result: ptr[u8] = nil
        if (f == 0) {
            return (((if (stbiErr(c"can't fopen") != 0) { nil } else { nil }) as usize) as ptr[u8])
        }
        result = stbiLoadFromFile(f, x, y, comp, reqComp)
        fclose(f)
        return result
    }
}

@Export
public func stbiLoadFromFile(f: ptr[FILE], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUc] {
    unsafe {
        let mut result: ptr[u8] = nil
        let mut s: StbiContext = StbiContext {}
        stbiStartFile(&s, f)
        result = stbiLoadAndPostprocess8bit(&s, x, y, comp, reqComp)
        if (result != 0) {
            fseek(f, -((s.imgBufferEnd - s.imgBuffer) as int), 1)
        }
        return result
    }
}

@Export
public func stbiLoadGifFromMemory(buffer: ptr[StbiUc], len: int, delays: ptr[ptr[int]], x: ptr[int], y: ptr[int], z: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUc] {
    unsafe {
        let mut result: ptr[u8] = nil
        let mut s: StbiContext = StbiContext {}
        stbiStartMem(&s, buffer, len)
        result = (stbiLoadGifMain(&s, delays, x, y, z, comp, reqComp) as ptr[u8])
        if ((if (stbiVerticallyFlipOnLoadSet != 0) { stbiVerticallyFlipOnLoadLocal } else { stbiVerticallyFlipOnLoadGlobal }) != 0) {
            stbiVerticalFlipSlices(result, x[0], y[0], z[0], comp[0])
        }
        return result
    }
}

@Export
public func stbiLoad16FromMemory(buffer: ptr[StbiUc], len: int, x: ptr[int], y: ptr[int], channelsInFile: ptr[int], desiredChannels: int): ptr[StbiUs] {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartMem(&s, buffer, len)
        return stbiLoadAndPostprocess16bit(&s, x, y, channelsInFile, desiredChannels)
    }
}


        data = stbiLoadAndPostprocess8bit(s, x, y, comp, reqComp)
        if (data != 0) {
            return stbiLdrToHdr(data, x[0], y[0], (if (reqComp != 0) { reqComp } else { comp[0] }))
        }
        return (((if (stbiErr(c"unknown image type") != 0) { nil } else { nil }) as usize) as ptr[f32])
    }
}

@Export
public func stbiGet8(s: ptr[StbiContext]): StbiUc {
    unsafe {
        if (s.imgBuffer < s.imgBufferEnd) {
            return (s.imgBuffer + 1)[0]
        }
        if (s.readFromCallbacks != 0) {
            stbiRefillBuffer(s)
            return (s.imgBuffer + 1)[0]
        }
        return 0
    }
}

@Export
public func stbiAtEof(s: ptr[StbiContext]): int {
    unsafe {
        if (s.io.read != 0) {
            if (s.io.eof(s.ioUserData) == 0) {
                return 0
            }
            if (s.readFromCallbacks == nil) {
                return 1
            }
        }
        return ((s.imgBuffer >= s.imgBufferEnd) as int)
    }
}

@Export
public func stbiSkip(s: ptr[StbiContext], n: int) {
    unsafe {
        if (n == 0) {
            return
        }
        if (n < 0) {
            s.imgBuffer = s.imgBufferEnd
            return
        }
        if (s.io.read != 0) {
            let mut blen: int = ((s.imgBufferEnd - s.imgBuffer) as int)
            if (blen < n) {
                s.imgBuffer = s.imgBufferEnd
                s.io.skip(s.ioUserData, (n - blen))
                return
            }
        }
        s.imgBuffer += n
    }
}

@Export
public func stbiGetn(s: ptr[StbiContext], buffer: ptr[StbiUc], n: int): int {
    unsafe {
        if (s.io.read != 0) {
            let mut blen: int = ((s.imgBufferEnd - s.imgBuffer) as int)
            if (blen < n) {
                let mut res: int = 0
                let mut count: int = 0
                memcpy(buffer, s.imgBuffer, blen)
                count = s.io.read(s.ioUserData, ((buffer as ptr[i8]) + blen), (n - blen))
                res = (count == (n - blen))
                s.imgBuffer = s.imgBufferEnd
                return res
            }
        }
        if ((s.imgBuffer + n) <= s.imgBufferEnd) {
            memcpy(buffer, s.imgBuffer, n)
            s.imgBuffer += n
            return 1
        } else {
            return 0
        }
    }
}


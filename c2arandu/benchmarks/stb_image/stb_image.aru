                        i = 0
                        while (i < z.s.imgX) {
                            out[0] = y[i]
                            out[1] = coutput[1][i]
                            out[2] = coutput[2][i]
                            out[3] = 255
                            out += n
                            i = i + 1
                        }
                    } else {
                        z.yCbCrToRGBKernel(out, y, coutput[1], coutput[2], z.s.imgX, n)
                    }
                } else {
                    if (z.s.imgN == 4) {
                        if (z.app14ColorTransform == 0) {

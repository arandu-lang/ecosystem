        return stbiZhuffmanDecodeSlowpath(a, z)
    }
}

@Export
public func stbiZexpand(z: ptr[StbiZbuf], zout: ptr[i8], n: int): int {
    unsafe {
        let mut q: ptr[i8] = nil
        let mut cur: uint = 0
        let mut limit: uint = 0
        let mut oldLimit: uint = 0
        z.zout = zout
        if (z.zExpandable == 0) {
            return stbiErr(c"output buffer limit")
        }
        cur = ((z.zout - z.zoutStart) as uint)
        oldLimit = ((z.zoutEnd - z.zoutStart) as uint)
        limit = oldLimit
        if ((((2147483647 * 2) + 1) - cur) < (n as uint)) {
            return stbiErr(c"outofmem")
        }
        while ((cur + n) > limit) {
            if (limit > (((2147483647 * 2) + 1) / 2)) {
                return stbiErr(c"outofmem")
            }
            limit *= 2
        }
        q = (realloc(z.zoutStart, limit) as ptr[i8])
        if (q == nil) {
            return stbiErr(c"outofmem")
        }
        z.zoutStart = q
        z.zout = (q + cur)
        z.zoutEnd = (q + limit)
        return 1
    }
}

@Export
public func stbiParseHuffmanBlock(a: ptr[StbiZbuf]): int {
    unsafe {
        let mut zout: ptr[i8] = a.zout
        while true {
            let mut z: int = stbiZhuffmanDecode(a, &a.zLength)
            if (z < 256) {
                if (z < 0) {
                    return stbiErr(c"bad huffman code")
                }
                if (zout >= a.zoutEnd) {
                    if (stbiZexpand(a, zout, 1) == 0) {
                        return 0
                    }
                    zout = a.zout
                }
                zout[0] = (z as i8)
                zout = zout + 1
            } else {
                let mut p: ptr[StbiUc] = nil
                let mut len: int = 0
                let mut dist: int = 0
                if (z == 256) {
                    a.zout = zout
                    if ((a.hitZeofOnce != 0) && (a.numBits < 16)) {
                        return stbiErr(c"unexpected end")
                    }
                    return 1
                }
                if (z >= 286) {
                    return stbiErr(c"bad huffman code")
                }
                z -= 257
                len = stbiZlengthBase[z]
                if (stbiZlengthExtra[z] != 0) {
                    len += stbiZreceive(a, stbiZlengthExtra[z])
                }
                z = stbiZhuffmanDecode(a, &a.zDistance)
                if ((z < 0) || (z >= 30)) {
                    return stbiErr(c"bad huffman code")
                }
                dist = stbiZdistBase[z]
                if (stbiZdistExtra[z] != 0) {
                    dist += stbiZreceive(a, stbiZdistExtra[z])
                }
                if ((zout - a.zoutStart) < dist) {
                    return stbiErr(c"bad dist")
                }
                if (len > (a.zoutEnd - zout)) {
                    if (stbiZexpand(a, zout, len) == 0) {
                        return 0
                    }
                    zout = a.zout
                }
                p = ((zout - dist) as ptr[StbiUc])
                if (dist == 1) {
                    let mut v: StbiUc = p[0]
                    if (len != 0) {
                        while true {
                            zout[0] = v
                            zout = zout + 1
                            if !(((len - 1) != 0)) {
                                break
                            }
                        }
                    }
                } else {
                    if (len != 0) {
                        while true {
                            zout[0] = (p + 1)[0]
                            zout = zout + 1
                            if !(((len - 1) != 0)) {
                                break
                            }
                        }
                    }
                }
            }
        }
    }
}

@Export
public func stbiComputeHuffmanCodes(a: ptr[StbiZbuf]): int {
    unsafe {
        let mut lengthDezigzag: [19]StbiUc = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
        let mut zCodelength: StbiZhuffman = StbiZhuffman {}
        let mut lencodes: [455]StbiUc = [StbiUc {}; 455]
        let mut codelengthSizes: [19]StbiUc = [StbiUc {}; 19]
        let mut i: int = 0
        let mut n: int = 0
        let mut hlit: int = (stbiZreceive(a, 5) + 257)
        let mut hdist: int = (stbiZreceive(a, 5) + 1)
        let mut hclen: int = (stbiZreceive(a, 4) + 4)
        let mut ntot: int = (hlit + hdist)
        memset(codelengthSizes, 0, 19)
        i = 0
        while (i < hclen) {
            let mut s: int = stbiZreceive(a, 3)
            codelengthSizes[lengthDezigzag[i]] = (s as StbiUc)
            i = i + 1
        }
        if (stbiZbuildHuffman(&zCodelength, codelengthSizes, 19) == 0) {
            return 0
        }
        n = 0
        while (n < ntot) {
            let mut c: int = stbiZhuffmanDecode(a, &zCodelength)
            if ((c < 0) || (c >= 19)) {
                return stbiErr(c"bad codelengths")
            }
            if (c < 16) {
                lencodes[(n + 1)] = (c as StbiUc)
            } else {
                let mut fill: StbiUc = 0
                if (c == 16) {
                    c = (stbiZreceive(a, 2) + 3)
                    if (n == 0) {
                        return stbiErr(c"bad codelengths")
                    }
                    fill = lencodes[(n - 1)]
                } else {
                    if (c == 17) {
                        c = (stbiZreceive(a, 3) + 3)
                    } else {
                        if (c == 18) {
                            c = (stbiZreceive(a, 7) + 11)
                        } else {
                            return stbiErr(c"bad codelengths")
                        }
                    }
                }
                if ((ntot - n) < c) {
                    return stbiErr(c"bad codelengths")
                }
                memset((lencodes + n), fill, c)
                n += c
            }
        }
        if (n != ntot) {
            return stbiErr(c"bad codelengths")
        }
        if (stbiZbuildHuffman(&a.zLength, lencodes, hlit) == 0) {
            return 0
        }
        if (stbiZbuildHuffman(&a.zDistance, (lencodes + hlit), hdist) == 0) {
            return 0
        }
        return 1
    }
}

@Export
public func stbiParseUncompressedBlock(a: ptr[StbiZbuf]): int {
    unsafe {
        let mut header: [4]StbiUc = [StbiUc {}; 4]
        let mut len: int = 0
        let mut nlen: int = 0
        let mut k: int = 0
        if ((a.numBits & 7) != 0) {
            stbiZreceive(a, (a.numBits & 7))
        }
        k = 0
        while (a.numBits > 0) {
            header[(k + 1)] = ((a.codeBuffer & 255) as StbiUc)
            a.codeBuffer >>= 8
            a.numBits -= 8
        }
        if (a.numBits < 0) {
            return stbiErr(c"zlib corrupt")
        }
        while (k < 4) {
            header[(k + 1)] = stbiZget8(a)
        }
        len = ((header[1] * 256) + header[0])
        nlen = ((header[3] * 256) + header[2])
        if (nlen != (len ^ 65535)) {
            return stbiErr(c"zlib corrupt")
        }
        if ((a.zbuffer + len) > a.zbufferEnd) {
            return stbiErr(c"read past buffer")
        }
        if ((a.zout + len) > a.zoutEnd) {
            if (stbiZexpand(a, a.zout, len) == 0) {
                return 0
            }
        }
        memcpy(a.zout, a.zbuffer, len)
        a.zbuffer += len
        a.zout += len
        return 1
    }
}

@Export
public func stbiParseZlibHeader(a: ptr[StbiZbuf]): int {
    unsafe {
        let mut cmf: int = stbiZget8(a)
        let mut cm: int = (cmf & 15)
        let mut flg: int = stbiZget8(a)
        if (stbiZeof(a) != 0) {
            return stbiErr(c"bad zlib header")
        }
        if ((((cmf * 256) + flg) % 31) != 0) {
            return stbiErr(c"bad zlib header")
        }
        if ((flg & 32) != 0) {
            return stbiErr(c"no preset dict")
        }
        if (cm != 8) {
            return stbiErr(c"bad compression")
        }
        return 1
    }
}

@Export
public func stbiParseZlib(a: ptr[StbiZbuf], parseHeader: int): int {
    unsafe {
        let mut final: int = 0
        let mut typeVal: int = 0
        if (parseHeader != 0) {
            if (stbiParseZlibHeader(a) == 0) {
                return 0
            }
        }
        a.numBits = 0
        a.codeBuffer = 0
        a.hitZeofOnce = 0
        while true {
            final = stbiZreceive(a, 1)
            typeVal = stbiZreceive(a, 2)
            if (typeVal == 0) {
                if (stbiParseUncompressedBlock(a) == 0) {
                    return 0
                }
            } else {
                if (typeVal == 3) {
                    return 0
                } else {
                    if (typeVal == 1) {
                        if (stbiZbuildHuffman(&a.zLength, stbiZdefaultLength, 288) == 0) {
                            return 0
                        }
                        if (stbiZbuildHuffman(&a.zDistance, stbiZdefaultDistance, 32) == 0) {
                            return 0
                        }
                    } else {
                        if (stbiComputeHuffmanCodes(a) == 0) {
                            return 0
                        }
                    }
                    if (stbiParseHuffmanBlock(a) == 0) {
                        return 0
                    }
                }
            }
            if !((final == 0)) {
                break
            }
        }
        return 1
    }
}

@Export
public func stbiDoZlib(a: ptr[StbiZbuf], obuf: ptr[i8], olen: int, exp: int, parseHeader: int): int {
    unsafe {
        a.zoutStart = obuf
        a.zout = obuf
        a.zoutEnd = (obuf + olen)
        a.zExpandable = exp
        return stbiParseZlib(a, parseHeader)
    }
}


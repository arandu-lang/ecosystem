@Export
public func stbiLoad16(filename: ptr[i8], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUs] {
    unsafe {
        let mut f: ptr[FILE] = stbiFopen(filename, c"rb")
        let mut result: ptr[StbiUint16] = nil
        if (f == 0) {
            return ((((if (stbiErr(c"can't fopen") != 0) { nil } else { nil }) as usize) as ptr[u8]) as ptr[StbiUs])
        }
        result = stbiLoadFromFile16(f, x, y, comp, reqComp)
        fclose(f)
        return result
    }
}

@Export
public func stbiLoadFromFile16(f: ptr[FILE], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[StbiUs] {
    unsafe {
        let mut result: ptr[StbiUint16] = nil
        let mut s: StbiContext = StbiContext {}
        stbiStartFile(&s, f)
        result = stbiLoadAndPostprocess16bit(&s, x, y, comp, reqComp)
        if (result != 0) {
            fseek(f, -((s.imgBufferEnd - s.imgBuffer) as int), 1)
        }
        return result
    }
}


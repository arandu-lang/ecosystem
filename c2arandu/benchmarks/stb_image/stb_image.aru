@Export
public func stbiLoadMain(s: ptr[StbiContext], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int, ri: ptr[StbiResultInfo], bpc: int): ptr[u8] {
    unsafe {
        memset(ri, 0, 12)
        ri.bitsPerChannel = 8
        ri.channelOrder = STBI_ORDER_RGB
        ri.numChannels = 0
        if (stbiPngTest(s) != 0) {
            return stbiPngLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiBmpTest(s) != 0) {
            return stbiBmpLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiGifTest(s) != 0) {
            return stbiGifLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiPsdTest(s) != 0) {
            return stbiPsdLoad(s, x, y, comp, reqComp, ri, bpc)
        }
        if (stbiPicTest(s) != 0) {
            return stbiPicLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiJpegTest(s) != 0) {
            return stbiJpegLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiPnmTest(s) != 0) {
            return stbiPnmLoad(s, x, y, comp, reqComp, ri)
        }
        if (stbiHdrTest(s) != 0) {
            let mut hdr: ptr[f32] = stbiHdrLoad(s, x, y, comp, reqComp, ri)
            return stbiHdrToLdr(hdr, x[0], y[0], (if (reqComp != 0) { reqComp } else { comp[0] }))
        }
        if (stbiTgaTest(s) != 0) {
            return stbiTgaLoad(s, x, y, comp, reqComp, ri)
        }
        return (((if (stbiErr(c"unknown image type") != 0) { nil } else { nil }) as usize) as ptr[u8])
    }
}

@Export

@Export
public func stbiZbuildHuffman(z: ptr[StbiZhuffman], sizelist: ptr[StbiUc], num: int): int {
    unsafe {
        let mut i: int = 0
        let mut k: int = 0
        let mut code: int = 0
        let mut nextCode: [16]int = [0; 16]
        let mut sizes: [17]int = [0; 17]
        memset(sizes, 0, 68)
        memset(z.fast, 0, 1024)
        i = 0
        while (i < num) {
            sizes[sizelist[i]] = sizes[sizelist[i]] + 1
            i = i + 1
        }
        sizes[0] = 0
        i = 1
        while (i < 16) {
            if (sizes[i] > (1 << i)) {
                return stbiErr(c"bad sizes")
            }
            i = i + 1
        }
        code = 0
        i = 1
        while (i < 16) {
            nextCode[i] = code
            z.firstcode[i] = (code as StbiUint16)
            z.firstsymbol[i] = (k as StbiUint16)
            code = (code + sizes[i])
            if (sizes[i] != 0) {
                if ((code - 1) >= (1 << i)) {
                    return stbiErr(c"bad codelengths")
                }
            }
            z.maxcode[i] = (code << (16 - i))
            code <<= 1
            k += sizes[i]
            i = i + 1
        }
        z.maxcode[16] = 65536
        i = 0
        while (i < num) {
            let mut s: int = sizelist[i]
            if (s != 0) {
                let mut c: int = ((nextCode[s] - z.firstcode[s]) + z.firstsymbol[s])
                let mut fastv: StbiUint16 = (((s << 9) | i) as StbiUint16)
                z.size[c] = (s as StbiUc)
                z.value[c] = (i as StbiUint16)
                if (s <= 9) {
                    let mut j: int = stbiBitReverse(nextCode[s], s)
                    while (j < (1 << 9)) {
                        z.fast[j] = fastv
                        j += (1 << s)
                    }

        let mut actComp: int = 0
        let mut numPackets: int = 0
        let mut y: int = 0
        let mut chained: int = 0
        let mut packets: [10]StbiPicPacket = [StbiPicPacket {}; 10]
        while true {
            let mut packet: ptr[StbiPicPacket] = nil
            if (numPackets == (30 / 3)) {
                return (((if (stbiErr(c"bad format") != 0) { nil } else { nil }) as usize) as ptr[u8])
            }

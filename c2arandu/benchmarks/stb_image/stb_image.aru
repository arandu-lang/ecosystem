        let mut initCode: StbiInt32 = StbiInt32 {}
        let mut first: StbiUint32 = StbiUint32 {}
        let mut codesize: StbiInt32 = StbiInt32 {}
        let mut codemask: StbiInt32 = StbiInt32 {}
        let mut avail: StbiInt32 = StbiInt32 {}
        let mut oldcode: StbiInt32 = StbiInt32 {}
        let mut bits: StbiInt32 = StbiInt32 {}
        let mut validBits: StbiInt32 = StbiInt32 {}

@Export
public func stbiLoadf(filename: ptr[i8], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[f32] {
    unsafe {
        let mut result: ptr[f32] = nil
        let mut f: ptr[FILE] = stbiFopen(filename, c"rb")
        if (f == 0) {
            return (((if (stbiErr(c"can't fopen") != 0) { nil } else { nil }) as usize) as ptr[f32])
        }
        result = stbiLoadfFromFile(f, x, y, comp, reqComp)
        fclose(f)
        return result
    }
}

@Export
public func stbiLoadfFromFile(f: ptr[FILE], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[f32] {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartFile(&s, f)
        return stbiLoadfMain(&s, x, y, comp, reqComp)
    }
}

@Export
public func stbiHdrToLdrGamma(gamma: f32) {
    stbiH2lGammaI = (1 / gamma)
}

@Export
public func stbiHdrToLdrScale(scale: f32) {
    stbiH2lScaleI = (1 / scale)
}

@Export
public func stbiLdrToHdrGamma(gamma: f32) {
    stbiL2hGamma = gamma
}

@Export
public func stbiLdrToHdrScale(scale: f32) {
    stbiL2hScale = scale
}

@Export
public func stbiIsHdrFromCallbacks(clbk: ptr[StbiIoCallbacks], user: ptr[u8]): int {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartCallbacks(&s, (clbk as ptr[StbiIoCallbacks]), user)
        return stbiHdrTest(&s)
    }
}

@Export
public func stbiIsHdrFromMemory(buffer: ptr[StbiUc], len: int): int {
    unsafe {
        let mut s: StbiContext = StbiContext {}
        stbiStartMem(&s, buffer, len)
        return stbiHdrTest(&s)
    }
}

@Export
public func stbiIsHdr(filename: ptr[i8]): int {
    unsafe {
        let mut f: ptr[FILE] = stbiFopen(filename, c"rb")
        let mut result: int = 0
        if (f != 0) {
            result = stbiIsHdrFromFile(f)
            fclose(f)
        }
        return result
    }
}

@Export
public func stbiIsHdrFromFile(f: ptr[FILE]): int {
    unsafe {
        let mut pos: i64 = ftell(f)
        let mut res: int = 0
        let mut s: StbiContext = StbiContext {}
        stbiStartFile(&s, f)
        res = stbiHdrTest(&s)
        fseek(f, pos, 0)
        return res
    }
}

@Export
public func stbiFailureReason(): ptr[i8] {
    unsafe {
        return stbiGFailureReason
    }
}


                        let mut left: int = width
                        while (left > 0) {
                            let mut count: int = stbiGet8(s)
                            let mut i: int = 0
                            if (stbiAtEof(s) != 0) {
                                return (((if (stbiErr(c"bad file") != 0) { nil } else { nil }) as usize) as ptr[u8])
                            }

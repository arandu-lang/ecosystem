@Export
public func stbiFillBits(z: ptr[StbiZbuf]) {
    unsafe {
        while true {
            if (z.codeBuffer >= (1 << z.numBits)) {
                z.zbuffer = z.zbufferEnd
                return
            }
            z.codeBuffer |= ((stbiZget8(z) as uint) << z.numBits)
            z.numBits += 8
            if !((z.numBits <= 24)) {

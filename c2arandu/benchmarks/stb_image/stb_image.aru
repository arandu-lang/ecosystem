                                }
                                if (stbiReadval(s, packet.channel, value) == 0) {
                                    return 0
                                }
                                i = 0
                                while (i < count) {
                                    stbiCopyval(packet.channel, dest, value)
                                    i = i + 1
                                    dest += 4
                                }
                            } else {
                                count = count + 1
                                if (count > left) {
                                    return (((if (stbiErr(c"bad file") != 0) { nil } else { nil }) as usize) as ptr[u8])
                                }
                                i = 0
                                while (i < count) {
                                    if (stbiReadval(s, packet.channel, dest) == 0) {
                                        return 0
                                    }
                                    i = i + 1
                                    dest += 4
                                }
                            }
                            left -= count
                        }

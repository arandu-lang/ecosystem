        }
        output = (stbiMallocMad3(n, z.s.imgX, z.s.imgY, 1) as ptr[StbiUc])
        if (output == 0) {
            stbiCleanupJpeg(z)
            return (((if (stbiErr(c"outofmem") != 0) { nil } else { nil }) as usize) as ptr[u8])

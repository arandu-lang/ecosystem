            } else {
                stbiFillBits(a)
            }
        }
        b = z.fast[(a.codeBuffer & ((1 << 9) - 1))]
        if (b != 0) {
            s = (b >> 9)
            a.codeBuffer >>= s
            a.numBits -= s

            }
            if !((chained != 0)) {
                break
            }
        }
        comp[0] = (if ((actComp & 16) != 0) { 4 } else { 3 })
        y = 0
        while (y < height) {
            let mut packetIdx: int = 0
            packetIdx = nil
            while (packetIdx < numPackets) {
                let mut packet: ptr[StbiPicPacket] = &packets[packetIdx]
                let mut dest: ptr[StbiUc] = (result + ((y * width) * 4))
                match packet.typeVal {
                    _ => {
                        return (((if (stbiErr(c"bad format") != 0) { nil } else { nil }) as usize) as ptr[u8])
                    }

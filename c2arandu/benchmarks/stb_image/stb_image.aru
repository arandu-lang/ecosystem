@Export
public func stbiVerticalFlip(image: ptr[u8], w: int, h: int, bytesPerPixel: int) {
    unsafe {
        let mut row: int = 0
        let mut bytesPerRow: usize = ((w as usize) * bytesPerPixel)
        let mut temp: [2048]StbiUc = [StbiUc {}; 2048]
        let mut bytes: ptr[StbiUc] = (image as ptr[StbiUc])
        row = 0
        while (row < (h >> 1)) {
            let mut row0: ptr[StbiUc] = (bytes + (row * bytesPerRow))
            let mut row1: ptr[StbiUc] = (bytes + (((h - row) - 1) * bytesPerRow))
            let mut bytesLeft: usize = bytesPerRow
            while (bytesLeft != 0) {
                let mut bytesCopy: usize = (if (bytesLeft < 2048) { bytesLeft } else { 2048 })
                memcpy(temp, row0, bytesCopy)
                memcpy(row0, row1, bytesCopy)
                memcpy(row1, temp, bytesCopy)
                row0 += bytesCopy
                row1 += bytesCopy
                bytesLeft -= bytesCopy
            }
            row = row + 1
        }
    }
}

@Export
public func stbiVerticalFlipSlices(image: ptr[u8], w: int, h: int, z: int, bytesPerPixel: int) {
    unsafe {
        let mut slice: int = 0
        let mut sliceSize: int = ((w * h) * bytesPerPixel)
        let mut bytes: ptr[StbiUc] = (image as ptr[StbiUc])
        slice = 0
        while (slice < z) {
            stbiVerticalFlip(bytes, w, h, bytesPerPixel)
            bytes += sliceSize
            slice = slice + 1
        }
    }
}

@Export
public func stbiLoadAndPostprocess8bit(s: ptr[StbiContext], x: ptr[int], y: ptr[int], comp: ptr[int], reqComp: int): ptr[u8] {
    unsafe {
        let mut ri: StbiResultInfo = StbiResultInfo {}
        let mut result: ptr[u8] = stbiLoadMain(s, x, y, comp, reqComp, &ri, 8)

//! Arquivo gerado automaticamente pelo c2arandu
//! Baseado na arquitetura Dual-Locus & OSSA da linguagem Arandu.

// --- Tipos de Sistema C C-ABI ---
@Repr("C")
public struct FILE {}

@Repr("C")
public struct AnonymousStruct {
    public err: int,
    public pDesc: ptr[i8],
}

// --- Typedefs e Aliases C ---
public type StbiUc = u8
public type StbiUs = u16
public type StbiUint16 = u16
public type StbiInt16 = i16
public type StbiUint32 = u32
public type StbiInt32 = i32
public type ValidateUint32 = [1]u8
public type ResampleRowFunc = ptr[func(ptr[StbiUc], ptr[StbiUc], ptr[StbiUc], int, int) ptr[StbiUc]]


                            let mut r: StbiUc = stbiBlinn8x8(coutput[0][i], m)
                            let mut g: StbiUc = stbiBlinn8x8(coutput[1][i], m)
                            let mut b: StbiUc = stbiBlinn8x8(coutput[2][i], m)
                            out[0] = stbiComputeY(r, g, b)
                            out[1] = 255

            k = 0
            while (k < decodeN) {
                let mut r: ptr[StbiResample] = &resComp[k]
                let mut yBot: int = (r.ystep >= (r.vs >> 1))
                coutput[k] = r.resample(z.imgComp[k].linebuf, (if (yBot != 0) { r.line1 } else { r.line0 }), (if (yBot != 0) { r.line0 } else { r.line1 }), r.wLores, r.hs)

@Export
public func stbiBuildHuffman(h: ptr[StbiHuffman], count: ptr[int]): int {
    unsafe {
        let mut i: int = 0
        let mut j: int = 0
        let mut k: int = 0
        let mut code: uint = 0
        i = 0
        while (i < 16) {
            j = 0
            while (j < count[i]) {
                h.size[(k + 1)] = ((i + 1) as StbiUc)
                if (k >= 257) {
                    return stbiErr(c"bad size list")
                }
                j = j + 1
            }
            i = i + 1
        }
        h.size[k] = 0
        code = 0
        k = 0
        j = 1
        while (j <= 16) {
            h.delta[j] = (k - code)
            if (h.size[k] == j) {
                while (h.size[k] == j) {
                    h.code[(k + 1)] = ((code + 1) as StbiUint16)
                }
                if ((code - 1) >= (1 << j)) {
                    return stbiErr(c"bad code lengths")
                }
            }
            h.maxcode[j] = (code << (16 - j))
            code <<= 1
            j = j + 1
        }
        h.maxcode[j] = -1
        memset(h.fast, 255, (1 << 9))
        i = 0
        while (i < k) {
            let mut s: int = h.size[i]
            if (s <= 9) {
                let mut c: int = (h.code[i] << (9 - s))
                let mut m: int = (1 << (9 - s))
                j = 0
                while (j < m) {
                    h.fast[(c + j)] = (i as StbiUc)
                    j = j + 1
                }
            }
            i = i + 1
        }
        return 1
    }
}

@Export
public func stbiBuildFastAc(fastAc: ptr[StbiInt16], h: ptr[StbiHuffman]) {
    unsafe {
        let mut i: int = 0
        i = 0
        while (i < (1 << 9)) {
            let mut fast: StbiUc = h.fast[i]
            fastAc[i] = 0
            if (fast < 255) {
                let mut rs: int = h.values[fast]
                let mut run: int = ((rs >> 4) & 15)
                let mut magbits: int = (rs & 15)
                let mut len: int = h.size[fast]
                if ((magbits != 0) && ((len + magbits) <= 9)) {
                    let mut k: int = (((i << len) & ((1 << 9) - 1)) >> (9 - magbits))
                    let mut m: int = (1 << (magbits - 1))
                    if (k < m) {
                        k += ((~0 << magbits) + 1)
                    }
                    if ((k >= -128) && (k <= 127)) {
                        fastAc[i] = ((((k * 256) + (run * 16)) + (len + magbits)) as StbiInt16)
                    }
                }
            }
            i = i + 1
        }
    }
}

@Export
public func stbiGrowBufferUnsafe(j: ptr[StbiJpeg]) {
    unsafe {
        while true {
            let mut b: uint = (if (j.nomore != 0) { 0 } else { stbiGet8(j.s) })
            if (b == 255) {
                let mut c: int = stbiGet8(j.s)
                while (c == 255) {
                    c = stbiGet8(j.s)

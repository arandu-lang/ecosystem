        }
        k = (z.codeBuffer & ((1 << n) - 1))
        z.codeBuffer >>= n
        z.numBits -= n
        return k
    }
}

@Export
public func stbiZhuffmanDecodeSlowpath(a: ptr[StbiZbuf], z: ptr[StbiZhuffman]): int {
    unsafe {
        let mut b: int = 0
        let mut s: int = 0
        let mut k: int = 0
        k = stbiBitReverse(a.codeBuffer, 16)
        s = (9 + 1)
        while true {
            if (k < z.maxcode[s]) {
                break

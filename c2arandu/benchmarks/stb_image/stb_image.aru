@Export
public func stbiBitreverse16(n: int): int {
    let mut localN = n
    localN = (((localN & 43690) >> 1) | ((localN & 21845) << 1))
    localN = (((localN & 52428) >> 2) | ((localN & 13107) << 2))
    localN = (((localN & 61680) >> 4) | ((localN & 3855) << 4))
    localN = (((localN & 65280) >> 8) | ((localN & 255) << 8))
    return localN
}

@Export
public func stbiBitReverse(v: int, bits: int): int {
    return (stbiBitreverse16(v) >> (16 - bits))

            i = i + 1
        }
        return 1
    }
}

@Export
public func stbiPaeth(a: int, b: int, c: int): int {
    let mut thresh: int = ((c * 3) - (a + b))
    let mut lo: int = (if (a < b) { a } else { b })
    let mut hi: int = (if (a < b) { b } else { a })
    let mut t0: int = (if (hi <= thresh) { lo } else { c })
    let mut t1: int = (if (thresh <= lo) { hi } else { t0 })
    return t1
}

@Export
public func stbiCreatePngAlphaExpand8(dest: ptr[StbiUc], src: ptr[StbiUc], x: StbiUint32, imgN: int) {
    unsafe {
        let mut i: int = 0
        if (imgN == 1) {
            i = (x - 1)
            while (i >= 0) {
                dest[((i * 2) + 1)] = 255
                dest[((i * 2) + 0)] = src[i]
                i = i - 1
            }
        } else {
            i = (x - 1)
            while (i >= 0) {
                dest[((i * 4) + 3)] = 255
                dest[((i * 4) + 2)] = src[((i * 3) + 2)]
                dest[((i * 4) + 1)] = src[((i * 3) + 1)]
                dest[((i * 4) + 0)] = src[((i * 3) + 0)]
                i = i - 1
            }

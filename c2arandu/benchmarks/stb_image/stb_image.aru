            }
            j.codeBuffer |= (b << (24 - j.codeBits))
            j.codeBits += 8
            if !((j.codeBits <= 24)) {
                break
            }
        }
    }
}

@Export
public func stbiJpegHuffDecode(j: ptr[StbiJpeg], h: ptr[StbiHuffman]): int {

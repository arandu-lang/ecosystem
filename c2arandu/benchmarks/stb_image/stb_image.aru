                            while (i < z.s.imgX) {
                                let mut m: StbiUc = coutput[3][i]
                                out[0] = stbiBlinn8x8(coutput[0][i], m)
                                out[1] = stbiBlinn8x8(coutput[1][i], m)
                                out[2] = stbiBlinn8x8(coutput[2][i], m)
                                out[3] = 255
                                out += n
                                i = i + 1
                            }
                        } else {
                            if (z.app14ColorTransform == 2) {
                                z.yCbCrToRGBKernel(out, y, coutput[1], coutput[2], z.s.imgX, n)
                                i = 0
                                while (i < z.s.imgX) {
                                    let mut m: StbiUc = coutput[3][i]
                                    out[0] = stbiBlinn8x8((255 - out[0]), m)
                                    out[1] = stbiBlinn8x8((255 - out[1]), m)
                                    out[2] = stbiBlinn8x8((255 - out[2]), m)
                                    out += n
                                    i = i + 1
                                }
                            } else {

}

@Export
public func aggregateIdxEprRefToColCallback(pWalker: ptr[Walker], pExpr: ptr[Expr]): int {
    unsafe {
        let mut pAggInfo: ptr[AggInfo] = nil
        let mut pCol: ptr[AggInfoCol] = nil
        if (pExpr.pAggInfo == nil) {
            return 0
        }
        if (pExpr.op == 170) {
            return 0
        }
        if (pExpr.op == 169) {
            return 0
        }
        if (pExpr.op == 179) {
            return 0
        }
        pAggInfo = pExpr.pAggInfo
        if (pExpr.iAgg >= pAggInfo.nColumn) {
            return 0
        }
        pCol = &pAggInfo.aCol[pExpr.iAgg]
        pExpr.op = 170
        pExpr.iTable = pCol.iTable
        pExpr.iColumn = pCol.iColumn
        pExpr.flags &= (((8192 | 512) | 524288) as U32);
        return 1
    }
}

@Export
public func aggregateConvertIndexedExprRefToColumn(pAggInfo: ptr[AggInfo]) {
    unsafe {
        let mut i: int = 0
        let mut w: Walker = Walker {}
        memset(&w, 0, 48)
        w.xExprCallback = aggregateIdxEprRefToColCallback
        i = 0

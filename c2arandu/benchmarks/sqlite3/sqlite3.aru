                i = i + 1
            }
        }
        aPermute = sqlite3DbMallocRawNN(db, (4 * (nOrderBy + 1)))
        if (aPermute != 0) {
            let mut pItem: ptr[ExprListItem] = nil
            let mut bKeep: int = 0
            aPermute[0] = nOrderBy
            i = 1
            while (i <= nOrderBy) {
                aPermute[i] = (pItem.u.x.iOrderByCol - 1)
                if (aPermute[i] != ((i as U32) - 1)) {
                    bKeep = 1
                }
                i = i + 1
                pItem = pItem + 1
            }
            if (bKeep == 0) {
                sqlite3DbFreeNN(db, aPermute)
                aPermute = 0
            }
        }
        pKeyMerge = multiSelectByMergeKeyInfo(pParse, p, 1)
        if (op == 136) {
            regPrev = 0
        } else {
            let mut nExpr: int = p.pEList.nExpr
            regPrev = (pParse.nMem + 1)
            pParse.nMem += (nExpr + 1)
            sqlite3VdbeAddOp2(v, 73, 0, regPrev)
            pKeyDup = sqlite3KeyInfoAlloc(db, nExpr, 1)
            if (pKeyDup != 0) {
                i = 0
                while (i < nExpr) {
                    pKeyDup.aColl[i] = multiSelectCollSeq(pParse, p, i)
                    pKeyDup.aSortFlags[i] = nil
                    i = i + 1
                }
            }
        }
        nSelect = 1
        if (((op == 136) || (op == 135)) && ((db.dbOptFlags & 2097152) == 0)) {
            pSplit = p
            while ((pSplit.pPrior != nil) && (pSplit.op == op)) {
                nSelect = nSelect + 1
                pSplit = pSplit.pPrior
            }
        }
        if (nSelect <= 3) {
            pSplit = p
        } else {
            pSplit = p
            i = 2
            while (i < nSelect) {
                pSplit = pSplit.pPrior
                i += 2
            }
        }
        pPrior = pSplit.pPrior
        pSplit.pPrior = nil
        pPrior.pNext = nil
        pPrior.pOrderBy = sqlite3ExprListDup(pParse.db, pOrderBy, 0)
        sqlite3ResolveOrderGroupBy(pParse, p, p.pOrderBy, c"ORDER")
        sqlite3ResolveOrderGroupBy(pParse, pPrior, pPrior.pOrderBy, c"ORDER")
        computeLimitRegisters(pParse, p, labelEnd)
        if ((p.iLimit != 0) && (op == 136)) {
            regLimitA = (pParse.nMem + 1)
            regLimitB = (pParse.nMem + 1)
            sqlite3VdbeAddOp2(v, 82, (if (p.iOffset != 0) { (p.iOffset + 1) } else { p.iLimit }), regLimitA)
            sqlite3VdbeAddOp2(v, 82, regLimitA, regLimitB)
        } else {
            regLimitB = 0
            regLimitA = regLimitB
        }
        sqlite3ExprDelete(db, p.pLimit)
        p.pLimit = nil
        regAddrA = (pParse.nMem + 1)
        regAddrB = (pParse.nMem + 1)
        regOutA = (pParse.nMem + 1)
        regOutB = (pParse.nMem + 1)
        sqlite3SelectDestInit(&destA, 11, regAddrA)
        sqlite3SelectDestInit(&destB, 11, regAddrB)
        sqlite3VdbeExplain(pParse, 1, c"MERGE (%s)", sqlite3SelectOpName(p.op))
        addrSelectA = (sqlite3VdbeCurrentAddr(v) + 1)
        addr1 = sqlite3VdbeAddOp3(v, 11, regAddrA, 0, addrSelectA)
        ;
        pPrior.iLimit = regLimitA
        sqlite3VdbeExplain(pParse, 1, c"LEFT")
        sqlite3Select(pParse, pPrior, &destA)
        sqlite3VdbeEndCoroutine(v, regAddrA)
        sqlite3VdbeJumpHere(v, addr1)
        addrSelectB = (sqlite3VdbeCurrentAddr(v) + 1)
        addr1 = sqlite3VdbeAddOp3(v, 11, regAddrB, 0, addrSelectB)
        ;
        savedLimit = p.iLimit
        savedOffset = p.iOffset
        p.iLimit = regLimitB
        p.iOffset = nil
        sqlite3VdbeExplain(pParse, 1, c"RIGHT")
        sqlite3Select(pParse, p, &destB)
        p.iLimit = savedLimit
        p.iOffset = savedOffset
        sqlite3VdbeEndCoroutine(v, regAddrB)
        ;
        addrOutA = generateOutputSubroutine(pParse, p, &destA, pDest, regOutA, regPrev, pKeyDup, labelEnd)
        if ((op == 136) || (op == 135)) {
            ;
            addrOutB = generateOutputSubroutine(pParse, p, &destB, pDest, regOutB, regPrev, pKeyDup, labelEnd)
        }
        sqlite3KeyInfoUnref(pKeyDup)
        if ((op == 137) || (op == 138)) {
            addrEofA = labelEnd
            addrEofANoB = addrEofA

@Export
public func windowCodeRangeTest(p: ptr[WindowCodeArg], op: int, csr1: int, regVal: int, csr2: int, lbl: int) {
    unsafe {
        let mut localOp = op
        let mut pParse: ptr[Parse] = p.pParse
        let mut v: ptr[Vdbe] = sqlite3GetVdbe(pParse)
        let mut pOrderBy: ptr[ExprList] = p.pMWin.pOrderBy
        let mut reg1: int = sqlite3GetTempReg(pParse)
        let mut reg2: int = sqlite3GetTempReg(pParse)
        let mut regString: int = (pParse.nMem + 1)
        let mut arith: int = 107
        let mut addrGe: int = 0
        let mut addrDone: int = sqlite3VdbeMakeLabel(pParse)
        let mut pColl: ptr[CollSeq] = nil
        windowReadPeerValues(p, csr1, reg1)
        windowReadPeerValues(p, csr2, reg2)
        if ((pOrderBy.a[0].fg.sortFlags & 1) != 0) {
            match localOp {
                58 => {
                    localOp = 56
                }
                55 => {
                    localOp = 57
                }
                _ => {
                    localOp = 58
                }
            }
            arith = 108
        }
        ;
        if ((pOrderBy.a[0].fg.sortFlags & 2) != 0) {
            let mut addr: int = sqlite3VdbeAddOp1(v, 52, reg1)
            ;
            match localOp {
                58 => {
                    sqlite3VdbeAddOp2(v, 9, 0, lbl)
                }
                55 => {
                    sqlite3VdbeAddOp2(v, 52, reg2, lbl)
                }
                56 => {
                    sqlite3VdbeAddOp2(v, 51, reg2, lbl)
                }
                _ => {
                    ;
                    ;
                }
            }
            sqlite3VdbeAddOp2(v, 9, 0, addrDone)
            sqlite3VdbeJumpHere(v, addr)
            sqlite3VdbeAddOp2(v, 51, reg2, (if ((localOp == 55) || (localOp == 58)) { addrDone } else { lbl }))
            ;
        }
        sqlite3VdbeAddOp4(v, 118, 0, regString, 0, c"", 1))
        addrGe = sqlite3VdbeAddOp3(v, 58, regString, 0, reg1)
        ;
        if (((localOp == 58) && (arith == 107)) || ((localOp == 56) && (arith == 108))) {
            sqlite3VdbeAddOp3(v, localOp, reg2, lbl, reg1)
            ;
        }
        sqlite3VdbeAddOp3(v, arith, regVal, reg1, reg1)
        sqlite3VdbeJumpHere(v, addrGe)
        sqlite3VdbeAddOp3(v, localOp, reg2, lbl, reg1)
        ;
        pColl = sqlite3ExprNNCollSeq(pParse, pOrderBy.a[0].pExpr)
        sqlite3VdbeAppendP4(v, (pColl as ptr[u8]), 2))
        sqlite3VdbeChangeP5(v, 128)
        sqlite3VdbeResolveLabel(v, addrDone)
        ;
        ;
        ;
        ;
        ;
        ;
        ;
        ;
        sqlite3ReleaseTempReg(pParse, reg1)
        sqlite3ReleaseTempReg(pParse, reg2)
        ;
    }
}

@Export
public func windowCodeOp(p: ptr[WindowCodeArg], op: int, regCountdown: int, jumpOnEof: int): int {
    unsafe {
        let mut csr: int = 0
        let mut reg: int = 0
        let mut pParse: ptr[Parse] = p.pParse
        let mut pMWin: ptr[Window] = p.pMWin
        let mut ret: int = 0
        let mut v: ptr[Vdbe] = p.pVdbe
        let mut addrContinue: int = 0
        let mut bPeer: int = (pMWin.eFrmType != 77)
        let mut lblDone: int = sqlite3VdbeMakeLabel(pParse)
        let mut addrNextRange: int = 0
        if ((op == 2) && (pMWin.eStart == 91)) {
            return 0
        }
        if (regCountdown > 0) {
            if (pMWin.eFrmType == 90) {
                addrNextRange = sqlite3VdbeCurrentAddr(v)
                if (op == 2) {
                    if (pMWin.eStart == 87) {
                        windowCodeRangeTest(p, 56, p.current.csr, regCountdown, p.start.csr, lblDone)
                    } else {
                        windowCodeRangeTest(p, 58, p.start.csr, regCountdown, p.current.csr, lblDone)
                    }
                } else {
                    windowCodeRangeTest(p, 55, p.end.csr, regCountdown, p.current.csr, lblDone)
                }
            } else {
                sqlite3VdbeAddOp3(v, 61, regCountdown, lblDone, 1)
                ;
            }
        }
        if ((op == 1) && (pMWin.regStartRowid == nil)) {
            windowAggFinal(p, 0)
        }
        addrContinue = sqlite3VdbeCurrentAddr(v)
        if (((pMWin.eStart == pMWin.eEnd) && (regCountdown != 0)) && (pMWin.eFrmType == 90)) {
            let mut regRowid1: int = sqlite3GetTempReg(pParse)
            let mut regRowid2: int = sqlite3GetTempReg(pParse)
            if (op == 2) {
                sqlite3VdbeAddOp2(v, 137, p.start.csr, regRowid1)
                sqlite3VdbeAddOp2(v, 137, p.end.csr, regRowid2)
                sqlite3VdbeAddOp3(v, 58, regRowid2, lblDone, regRowid1)
                ;
            } else {
                if (p.regRowid != 0) {
                    sqlite3VdbeAddOp2(v, 137, p.end.csr, regRowid1)
                    sqlite3VdbeAddOp3(v, 58, p.regRowid, lblDone, regRowid1)
                    ;
                }
            }
            sqlite3ReleaseTempReg(pParse, regRowid1)
            sqlite3ReleaseTempReg(pParse, regRowid2)
        }
        match op {
            1 => {
                csr = p.current.csr
            }
            2 => {
                csr = p.start.csr
            }
            _ => {
                reg = p.current.reg
                windowReturnOneRow(p)
                reg = p.start.reg
                if (pMWin.regStartRowid != 0) {
                    sqlite3VdbeAddOp2(v, 88, pMWin.regStartRowid, 1)
                } else {
                    windowAggStep(p, pMWin, csr, 1, p.regArg)
                }
                csr = p.end.csr
                reg = p.end.reg
                if (pMWin.regStartRowid != 0) {

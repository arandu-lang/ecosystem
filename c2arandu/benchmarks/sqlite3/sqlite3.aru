        let mut pMain: ptr[Btree] = nil
        let mut pTemp: ptr[Btree] = nil
        let mut savedMDbFlags: U32 = U32 {}
        let mut savedFlags: U64 = U64 {}
        let mut savedNChange: I64 = I64 {}
        let mut savedNTotalChange: I64 = I64 {}

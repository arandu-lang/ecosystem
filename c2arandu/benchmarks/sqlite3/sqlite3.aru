                break
            }
            if ((pTab.eTabType == 2) && (localTrTm != 66)) {
                sqlite3ErrorMsg(pParse, c"cannot create %s trigger on view: %S", (if (localTrTm == 33) { c"BEFORE" } else { c"AFTER" }), pTableName.a)
                // goto trigger_orphan_error
            }
            if (!(pTab.eTabType == 2) && (localTrTm == 66)) {
                sqlite3ErrorMsg(pParse, c"cannot create INSTEAD OF trigger on table: %S", pTableName.a)
                // goto trigger_orphan_error
            }
            if !(pParse.eParseMode >= 2) {

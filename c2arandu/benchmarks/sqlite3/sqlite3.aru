            sqlite3VdbeAddOp3(v, 14, (sqlite3VdbeCurrentAddr(v) + 1), addr, (sqlite3VdbeCurrentAddr(v) + 1))
            ;
            sqlite3VdbeAddOp3(v, 82, regNew, regOld, (nVal - 1))

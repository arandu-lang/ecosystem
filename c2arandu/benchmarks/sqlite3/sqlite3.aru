            ;
            ;
            ;
            ;
            ;
            zType = azType[(pCol.affinity - 65)]
            len = sqlite3Strlen30(zType)
            memcpy(&zStmt[k], zType, len)
            k += len
            i = i + 1
            pCol = pCol + 1
        }
        len = sqlite3Strlen30(zEnd)
        memcpy(&zStmt[k], zEnd, (len + 1))
        return zStmt
    }
}


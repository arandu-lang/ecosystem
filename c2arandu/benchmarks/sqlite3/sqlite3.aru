@Export
public func sqlite3StrICmp(zLeft: ptr[i8], zRight: ptr[i8]): int {
    unsafe {
        let mut a: ptr[u8] = nil
        let mut b: ptr[u8] = nil
        let mut c: int = 0
        let mut x: int = 0
        a = (zLeft as ptr[u8])
        b = (zRight as ptr[u8])
        while true {
            c = a[0]
            x = b[0]
            if (c == x) {
                if (c == 0) {
                    break
                }
            } else {
                c = ((sqlite3UpperToLower[c] as int) - (sqlite3UpperToLower[x] as int))
                if (c != 0) {
                    break
                }
            }
            a = a + 1
            b = b + 1
        }
        return c
    }
}

@Export

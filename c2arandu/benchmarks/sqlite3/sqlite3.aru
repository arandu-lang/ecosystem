                nErr = nErr + 1
            } else {
                if (pTable.pCheck != 0) {
                    sqlite3ColumnsFromExprList(pParse, pTable.pCheck, &pTable.nCol, &pTable.aCol)
                    if ((pParse.nErr == nil) && (pTable.nCol == pSel.pEList.nExpr)) {
                        sqlite3SubqueryColumnTypes(pParse, pTable, pSel, 64)
                    }
                } else {
                    pTable.nCol = pSelTab.nCol
                    pTable.aCol = pSelTab.aCol
                    pTable.tabFlags |= (pSelTab.tabFlags & 98)
                    pSelTab.nCol = nil
                    pSelTab.aCol = nil
                }
            }
            pTable.nNVCol = pTable.nCol
            sqlite3DeleteTable(db, pSelTab)
            sqlite3SelectDelete(db, pSel)
            db.lookaside.bDisable;
            db.lookaside.sz = (if (db.lookaside.bDisable != 0) { 0 } else { db.lookaside.szTrue })
            pParse.eParseMode = eParseMode
        } else {
            nErr = nErr + 1
        }
        pTable.pSchema.schemaFlags |= 2
        if (db.mallocFailed != 0) {
            sqlite3DeleteColumnNames(db, pTable)
        }
        return (nErr + pParse.nErr)
    }
}

@Export

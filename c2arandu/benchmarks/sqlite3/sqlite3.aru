@Export
public func sqlite3VdbeNextOpcode(p: ptr[Vdbe], pSub: ptr[Mem], eMode: int, piPc: ptr[int], piAddr: ptr[int], paOp: ptr[ptr[Op]]): int {
    unsafe {
        let mut nRow: int = 0
        let mut nSub: int = 0
        let mut apSub: ptr[ptr[SubProgram]] = nil
        let mut i: int = 0
        let mut rc: int = 0
        let mut aOp: ptr[Op] = nil
        let mut iPc: int = 0
        nRow = p.nOp
        if (pSub != nil) {
            if ((pSub.flags & 16) != 0) {
                nSub = (pSub.n / 8)
                apSub = (pSub.z as ptr[ptr[SubProgram]])
            }
            i = 0
            while (i < nSub) {
                nRow += apSub[i].nOp
                i = i + 1
            }
        }
        iPc = piPc[0]
        while (1 != 0) {
            i = (iPc + 1)
            if (i >= nRow) {
                p.rc = nil
                rc = 101
                break
            }
            if (i < p.nOp) {
                aOp = p.aOp
            } else {
                let mut j: int = 0
                i -= p.nOp
                j = 0
                while (i >= apSub[j].nOp) {
                    i -= apSub[j].nOp
                    j = j + 1
                }
                aOp = apSub[j].aOp
            }
            if ((pSub != nil) && (aOp[i].p4type == 4))) {
                let mut nByte: int = ((nSub + 1) * 8)
                let mut j: int = 0
                j = 0
                while (j < nSub) {
                    if (apSub[j] == aOp[i].p4.pProgram) {
                        break
                    }
                    j = j + 1
                }
                if (j == nSub) {
                    p.rc = sqlite3VdbeMemGrow(pSub, nByte, (nSub != 0))
                    if (p.rc != nil) {
                        rc = 1
                        break
                    }
                    apSub = (pSub.z as ptr[ptr[SubProgram]])
                    apSub[(nSub + 1)] = aOp[i].p4.pProgram
                    (pSub.flags = ((pSub.flags & (3519 | 1024);) | 16))
                    pSub.n = (nSub * 8)
                    nRow += aOp[i].p4.pProgram.nOp
                }
            }
            if (eMode == 0) {
                break
            }
            if (aOp[i].opcode == 190) {
                break
            }
            if ((aOp[i].opcode == 8) && (iPc > 1)) {
                break
            }
        }
        piPc[0] = iPc
        piAddr[0] = i
        paOp[0] = aOp
        return rc
    }
}


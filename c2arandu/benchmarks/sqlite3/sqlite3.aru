                            }
                        }
                    }
                    p = p.pNext
                    if !((p != 0)) {
                        break
                    }
                }
            }
            break
        }
        if (pMask != 0) {
            pMask[0] = mask
        }
        return (if (mask != 0) { pList } else { 0 })
    }
}

@Export
public func isAsteriskTerm(pParse: ptr[Parse], pTerm: ptr[Expr]): int {

            i = 1
            while ((db.mallocFailed == 0) && (i <= p.pEList.nExpr)) {
                let mut pItem: ptr[ExprListItem] = nil
                j = 0
                while (j < nOrderBy) {
                    if (pItem.u.x.iOrderByCol == i) {
                        break
                    }
                    j = j + 1
                    pItem = pItem + 1
                }
                if (j == nOrderBy) {
                    let mut pNew: ptr[Expr] = sqlite3ExprInt32(db, i)
                    if (pNew == nil) {

@Export
public func sqlite3UpsertAnalyzeTarget(pParse: ptr[Parse], pTabList: ptr[SrcList], pUpsert: ptr[Upsert], pAll: ptr[Upsert]): int {
    unsafe {
        let mut localPUpsert = pUpsert
        let mut pTab: ptr[Table] = nil
        let mut rc: int = 0
        let mut iCursor: int = 0
        let mut pIdx: ptr[Index] = nil
        let mut pTarget: ptr[ExprList] = nil
        let mut pTerm: ptr[Expr] = nil
        let mut sNC: NameContext = NameContext {}
        let mut sCol: [2]Expr = [Expr {}; 2]
        let mut nClause: int = 0
        memset(&sNC, 0, 56)
        sNC.pParse = pParse
        sNC.pSrcList = pTabList
        while ((localPUpsert != 0) && (localPUpsert.pUpsertTarget != 0)) {
            rc = sqlite3ResolveExprListNames(&sNC, localPUpsert.pUpsertTarget)
            if (rc != 0) {
                return rc
            }
            rc = sqlite3ResolveExprNames(&sNC, localPUpsert.pUpsertTargetWhere)
            if (rc != 0) {
                return rc
            }
            pTab = pTabList.a[0].pSTab
            pTarget = localPUpsert.pUpsertTarget
            iCursor = pTabList.a[0].iCursor
            if (((((pTab.tabFlags & 128) == 0) && (pTarget.nExpr == 1)) && ((pTerm = pTarget.a[0].pExpr).op == 168)) && (pTerm.iColumn == 1))) {
                continue
            }
            memset(sCol, 0, 144)
            sCol[0].op = 114
            sCol[0].pLeft = &sCol[1]
            sCol[1].op = 168
            sCol[1].iTable = pTabList.a[0].iCursor
            pIdx = pTab.pIndex
            while (pIdx != 0) {
                let mut ii: int = 0
                let mut jj: int = 0
                let mut nn: int = 0
                if !(pIdx.onError != nil) {
                    continue
                }
                if (pTarget.nExpr != pIdx.nKeyCol) {
                    continue
                }
                if (pIdx.pPartIdxWhere != 0) {
                    if (localPUpsert.pUpsertTargetWhere == 0) {
                        continue
                    }
                    if (sqlite3ExprCompare(pParse, localPUpsert.pUpsertTargetWhere, pIdx.pPartIdxWhere, iCursor) != 0) {
                        continue
                    }
                }
                nn = pIdx.nKeyCol
                ii = 0
                while (ii < nn) {
                    let mut pExpr: ptr[Expr] = nil
                    sCol[0].u.zToken = (pIdx.azColl[ii] as ptr[i8])
                    if (pIdx.aiColumn[ii] == 2)) {
                        pExpr = pIdx.aColExpr.a[ii].pExpr
                        if (pExpr.op != 114) {
                            sCol[0].pLeft = pExpr
                            pExpr = &sCol[0]
                        }
                    } else {
                        sCol[0].pLeft = &sCol[1]
                        sCol[1].iColumn = pIdx.aiColumn[ii]
                        pExpr = &sCol[0]
                    }
                    jj = 0
                    while (jj < nn) {
                        if (sqlite3ExprCompare(0, pTarget.a[jj].pExpr, pExpr, iCursor) < 2) {
                            break
                        }
                        jj = jj + 1
                    }
                    if (jj >= nn) {
                        break
                    }
                    ii = ii + 1
                }
                if (ii < nn) {
                    continue
                }
                localPUpsert.pUpsertIdx = pIdx
                if (sqlite3UpsertOfIndex(pAll, pIdx) != localPUpsert) {
                    localPUpsert.isDup = 1
                }
                break
                pIdx = pIdx.pNext
            }
            if (localPUpsert.pUpsertIdx == 0) {
                let mut zWhich: [16]i8 = [0; 16]
                if ((nClause == 0) && (localPUpsert.pNextUpsert == 0)) {
                    zWhich[0] = 0
                } else {
                    sqlite3Snprintf(16, zWhich, c"%r ", (nClause + 1))
                }
                sqlite3ErrorMsg(pParse, c"%sON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint", zWhich)
                return 1
            }
            localPUpsert = localPUpsert.pNextUpsert
            nClause = nClause + 1
        }
        return 0
    }
}

@Export
public func sqlite3UpsertDoUpdate(pParse: ptr[Parse], pUpsert: ptr[Upsert], pTab: ptr[Table], pIdx: ptr[Index], iCur: int) {

        return 1
    }
}

@Export
public func sqlite3ExpandReturning(pParse: ptr[Parse], pList: ptr[ExprList], pTab: ptr[Table]): ptr[ExprList] {
    unsafe {
        let mut pNew: ptr[ExprList] = nil
        let mut db: ptr[Sqlite3] = pParse.db
        let mut i: int = 0
        i = 0
        while (i < pList.nExpr) {
            let mut pOldExpr: ptr[Expr] = pList.a[i].pExpr
            if (pOldExpr == nil) {
                continue
            }
            if (isAsteriskTerm(pParse, pOldExpr) != 0) {
                let mut jj: int = 0
                jj = 0
                while (jj < pTab.nCol) {

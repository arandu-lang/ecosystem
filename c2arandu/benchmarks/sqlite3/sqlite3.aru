                return sqlite3VtabCreateModule(db, azModule[i], &jsonEachModule, 0, 0)
            }
            i = i + 1
        }
        return 0
    }
}

@Export
public func sqlite3SafetyCheckOk(db: ptr[Sqlite3]): int {

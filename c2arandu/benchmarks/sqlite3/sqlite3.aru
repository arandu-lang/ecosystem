@Export
public func explainAppendTerm(pStr: ptr[StrAccum], pIdx: ptr[Index], nTerm: int, iTerm: int, bAnd: int, zOp: ptr[i8]) {
    unsafe {
        let mut i: int = 0
        if (bAnd != 0) {
            sqlite3StrAppend(pStr, c" AND ", 5)
        }
        if (nTerm > 1) {
            sqlite3StrAppend(pStr, c"(", 1)
        }
        i = 0
        while (i < nTerm) {
            if (i != 0) {
                sqlite3StrAppend(pStr, c",", 1)
            }
            sqlite3StrAppendall(pStr, explainIndexColumnName(pIdx, (iTerm + i)))
            i = i + 1
        }
        if (nTerm > 1) {
            sqlite3StrAppend(pStr, c")", 1)
        }
        sqlite3StrAppend(pStr, zOp, 1)
        if (nTerm > 1) {
            sqlite3StrAppend(pStr, c"(", 1)
        }
        i = 0
        while (i < nTerm) {
            if (i != 0) {
                sqlite3StrAppend(pStr, c",", 1)
            }
            sqlite3StrAppend(pStr, c"?", 1)
            i = i + 1
        }
        if (nTerm > 1) {

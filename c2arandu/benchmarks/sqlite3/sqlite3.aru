}

@Export
public func sqlite3BeginTrigger(pParse: ptr[Parse], pName1: ptr[Token], pName2: ptr[Token], trTm: int, op: int, pColumns: ptr[IdList], pTableName: ptr[SrcList], pWhen: ptr[Expr], isTemp: int, noErr: int) {

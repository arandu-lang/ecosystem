                    sqlite3StrAppendf(&x, c",%s%s%s", (if ((pKeyInfo.aSortFlags[j] & 1) != 0) { c"-" } else { c"" }), (if ((pKeyInfo.aSortFlags[j] & 2) != 0) { c"N." } else { c"" }), zColl)

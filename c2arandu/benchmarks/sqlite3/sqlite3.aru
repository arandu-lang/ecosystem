@Export
public func setupLookaside(db: ptr[Sqlite3], pBuf: ptr[u8], sz: int, cnt: int): int {
    unsafe {
        let mut localSz = sz
        let mut localCnt = cnt
        let mut pStart: ptr[u8] = nil
        let mut szAlloc: Sqlite3Int64 = Sqlite3Int64 {}
        let mut nBig: int = 0
        let mut nSm: int = 0
        if (sqlite3LookasideUsed(db, 0) > 0) {
            return 5
        }
        if (db.lookaside.bMalloced != 0) {
            sqlite3Free(db.lookaside.pStart)
        }
        localSz = (localSz & 7;)
        if (localSz <= (8 as int)) {
            localSz = 0
        }
        if (localSz > 65528) {
            localSz = 65528
        }
        if (localCnt < 1) {
            localCnt = 0
        }
        if ((localSz > 0) && (localCnt > (2147418112 / localSz))) {
            localCnt = (2147418112 / localSz)
        }
        szAlloc = ((localSz as I64) * (localCnt as I64))
        if (szAlloc == 0) {
            localSz = 0
            pStart = nil
        } else {
            if (pBuf == nil) {
                sqlite3BeginBenignMalloc()
                pStart = sqlite3Malloc(szAlloc)
                sqlite3EndBenignMalloc()
                if (pStart != 0) {
                    szAlloc = sqlite3MallocSize(pStart)
                }
            } else {
                pStart = pBuf
            }
        }
        if (localSz >= (128 * 3)) {
            nBig = (szAlloc / ((3 * 128) + localSz))
            nSm = ((szAlloc - ((localSz as I64) * (nBig as I64))) / 128)
        } else {
            if (localSz >= (128 * 2)) {
                nBig = (szAlloc / (128 + localSz))
                nSm = ((szAlloc - ((localSz as I64) * (nBig as I64))) / 128)
            } else {
                if (localSz > 0) {
                    nBig = (szAlloc / localSz)
                    nSm = 0
                } else {
                    nSm = 0
                    nBig = nSm
                }
            }
        }
        db.lookaside.pStart = pStart
        db.lookaside.pInit = 0
        db.lookaside.pFree = 0
        db.lookaside.sz = (localSz as U16)
        db.lookaside.szTrue = (localSz as U16)
        if (pStart != 0) {
            let mut i: int = 0
            let mut p: ptr[LookasideSlot] = nil
            p = (pStart as ptr[LookasideSlot])
            i = 0
            while (i < nBig) {
                p.pNext = db.lookaside.pInit
                db.lookaside.pInit = p
                p = (&(p as ptr[U8])[localSz] as ptr[LookasideSlot])
                i = i + 1
            }
            db.lookaside.pSmallInit = 0
            db.lookaside.pSmallFree = 0
            db.lookaside.pMiddle = p
            i = 0
            while (i < nSm) {
                p.pNext = db.lookaside.pSmallInit
                db.lookaside.pSmallInit = p
                p = (&(p as ptr[U8])[128] as ptr[LookasideSlot])
                i = i + 1
            }
            db.lookaside.pEnd = p
            db.lookaside.bDisable = 0
            db.lookaside.bMalloced = (if (pBuf == nil) { 1 } else { 0 })
            db.lookaside.nSlot = (nBig + nSm)
        } else {
            db.lookaside.pStart = 0
            db.lookaside.pSmallInit = 0
            db.lookaside.pSmallFree = 0
            db.lookaside.pMiddle = 0
            db.lookaside.pEnd = 0
            db.lookaside.bDisable = 1
            db.lookaside.sz = 0
            db.lookaside.bMalloced = 0
            db.lookaside.nSlot = 0
        }
        db.lookaside.pTrueEnd = db.lookaside.pEnd
        return 0
    }
}

@Export
public func binCollFunc(notUsed: ptr[u8], nKey1: int, pKey1: ptr[u8], nKey2: int, pKey2: ptr[u8]): int {
    unsafe {
        let mut rc: int = 0
        let mut n: int = 0
        n = (if (nKey1 < nKey2) { nKey1 } else { nKey2 })
        rc = memcmp(pKey1, pKey2, n)
        if (rc == 0) {
            rc = (nKey1 - nKey2)
        }
        return rc
    }
}

@Export
public func rtrimCollFunc(pUser: ptr[u8], nKey1: int, pKey1: ptr[u8], nKey2: int, pKey2: ptr[u8]): int {
    unsafe {
        let mut localNKey1 = nKey1
        let mut localNKey2 = nKey2
        let mut pK1: ptr[U8] = (pKey1 as ptr[U8])
        let mut pK2: ptr[U8] = (pKey2 as ptr[U8])
        while ((localNKey1 != 0) && (pK1[(localNKey1 - 1)] == 32)) {
            localNKey1 = localNKey1 - 1
        }
        while ((localNKey2 != 0) && (pK2[(localNKey2 - 1)] == 32)) {
            localNKey2 = localNKey2 - 1
        }
        return binCollFunc(pUser, localNKey1, pKey1, localNKey2, pKey2)
    }
}

@Export
public func nocaseCollatingFunc(notUsed: ptr[u8], nKey1: int, pKey1: ptr[u8], nKey2: int, pKey2: ptr[u8]): int {
    unsafe {
        let mut r: int = sqlite3Strnicmp((pKey1 as ptr[i8]), (pKey2 as ptr[i8]), (if (nKey1 < nKey2) { nKey1 } else { nKey2 }))
        if (0 == r) {
            r = (nKey1 - nKey2)
        }
        return r
    }
}

@Export

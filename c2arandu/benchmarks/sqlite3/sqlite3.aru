}

@Export
public func windowFullScan(p: ptr[WindowCodeArg]) {
    unsafe {
        let mut pWin: ptr[Window] = nil
        let mut pParse: ptr[Parse] = p.pParse
        let mut pMWin: ptr[Window] = p.pMWin
        let mut v: ptr[Vdbe] = p.pVdbe
        let mut regCRowid: int = 0
        let mut regCPeer: int = 0
        let mut regRowid: int = 0
        let mut regPeer: int = 0
        let mut nPeer: int = 0
        let mut lblNext: int = 0
        let mut lblBrk: int = 0
        let mut addrNext: int = 0
        let mut csr: int = 0
        ;
        csr = pMWin.csrApp
        nPeer = (if (pMWin.pOrderBy != 0) { pMWin.pOrderBy.nExpr } else { 0 })
        lblNext = sqlite3VdbeMakeLabel(pParse)
        lblBrk = sqlite3VdbeMakeLabel(pParse)
        regCRowid = sqlite3GetTempReg(pParse)
        regRowid = sqlite3GetTempReg(pParse)
        if (nPeer != 0) {
            regCPeer = sqlite3GetTempRange(pParse, nPeer)
            regPeer = sqlite3GetTempRange(pParse, nPeer)
        }
        sqlite3VdbeAddOp2(v, 137, pMWin.iEphCsr, regCRowid)
        windowReadPeerValues(p, pMWin.iEphCsr, regCPeer)
        pWin = pMWin
        while (pWin != 0) {
            sqlite3VdbeAddOp2(v, 77, 0, pWin.regAccum)
            pWin = pWin.pNextWin
        }
        sqlite3VdbeAddOp3(v, 23, csr, lblBrk, pMWin.regStartRowid)
        ;
        addrNext = sqlite3VdbeCurrentAddr(v)
        sqlite3VdbeAddOp2(v, 137, csr, regRowid)
        sqlite3VdbeAddOp3(v, 55, pMWin.regEndRowid, lblBrk, regRowid)
        ;
        if (pMWin.eExclude == 86) {
            sqlite3VdbeAddOp3(v, 54, regCRowid, lblNext, regRowid)
            ;
        } else {
            if (pMWin.eExclude != 67) {
                let mut addr: int = 0
                let mut addrEq: int = 0
                let mut pKeyInfo: ptr[KeyInfo] = nil
                if (pMWin.pOrderBy != 0) {
                    pKeyInfo = sqlite3KeyInfoFromExprList(pParse, pMWin.pOrderBy, 0, 0)
                }
                if (pMWin.eExclude == 95) {
                    addrEq = sqlite3VdbeAddOp3(v, 54, regCRowid, 0, regRowid)
                    ;
                }
                if (pKeyInfo != 0) {
                    windowReadPeerValues(p, csr, regPeer)
                    sqlite3VdbeAddOp3(v, 92, regPeer, regCPeer, nPeer)
                    sqlite3VdbeAppendP4(v, (pKeyInfo as ptr[u8]), 9))
                    addr = (sqlite3VdbeCurrentAddr(v) + 1)
                    sqlite3VdbeAddOp3(v, 14, addr, lblNext, addr)
                    ;
                } else {
                    sqlite3VdbeAddOp2(v, 9, 0, lblNext)
                }
                if (addrEq != 0) {
                    sqlite3VdbeJumpHere(v, addrEq)
                }
            }
        }
        windowAggStep(p, pMWin, csr, 0, p.regArg)
        sqlite3VdbeResolveLabel(v, lblNext)
        sqlite3VdbeAddOp2(v, 40, csr, addrNext)
        ;
        sqlite3VdbeJumpHere(v, (addrNext - 1))
        sqlite3VdbeJumpHere(v, (addrNext + 1))
        sqlite3ReleaseTempReg(pParse, regRowid)
        sqlite3ReleaseTempReg(pParse, regCRowid)
        if (nPeer != 0) {
            sqlite3ReleaseTempRange(pParse, regPeer, nPeer)
            sqlite3ReleaseTempRange(pParse, regCPeer, nPeer)
        }
        windowAggFinal(p, 1)
        ;
    }
}

@Export
public func windowReturnOneRow(p: ptr[WindowCodeArg]) {
    unsafe {
        let mut pMWin: ptr[Window] = p.pMWin
        let mut v: ptr[Vdbe] = p.pVdbe
        if (pMWin.regStartRowid != 0) {
            windowFullScan(p)
        } else {
            let mut pParse: ptr[Parse] = p.pParse
            let mut pWin: ptr[Window] = nil
            pWin = pMWin
            while (pWin != 0) {
                let mut pFunc: ptr[FuncDef] = pWin.pWFunc
                if ((pFunc.zName == nthValueName) || (pFunc.zName == firstValueName)) {
                    let mut csr: int = pWin.csrApp
                    let mut lbl: int = sqlite3VdbeMakeLabel(pParse)
                    let mut tmpReg: int = sqlite3GetTempReg(pParse)
                    sqlite3VdbeAddOp2(v, 77, 0, pWin.regResult)
                    if (pFunc.zName == nthValueName) {
                        sqlite3VdbeAddOp3(v, 96, pMWin.iEphCsr, (pWin.iArgCol + 1), tmpReg)
                        windowCheckValue(pParse, tmpReg, 2)
                    } else {
                        sqlite3VdbeAddOp2(v, 73, 1, tmpReg)
                    }
                    sqlite3VdbeAddOp3(v, 107, tmpReg, pWin.regApp, tmpReg)
                    sqlite3VdbeAddOp3(v, 55, (pWin.regApp + 1), lbl, tmpReg)
                    ;
                    sqlite3VdbeAddOp3(v, 30, csr, 0, tmpReg)
                    ;
                    sqlite3VdbeAddOp3(v, 96, csr, pWin.iArgCol, pWin.regResult)
                    sqlite3VdbeResolveLabel(v, lbl)
                    sqlite3ReleaseTempReg(pParse, tmpReg)
                } else {
                    if ((pFunc.zName == leadName) || (pFunc.zName == lagName)) {
                        let mut nArg: int = pWin.pOwner.x.pList.nExpr
                        let mut csr: int = pWin.csrApp
                        let mut lbl: int = sqlite3VdbeMakeLabel(pParse)
                        let mut tmpReg: int = sqlite3GetTempReg(pParse)
                        let mut iEph: int = pMWin.iEphCsr
                        if (nArg < 3) {
                            sqlite3VdbeAddOp2(v, 77, 0, pWin.regResult)
                        } else {
                            sqlite3VdbeAddOp3(v, 96, iEph, (pWin.iArgCol + 2), pWin.regResult)
                        }
                        sqlite3VdbeAddOp2(v, 137, iEph, tmpReg)
                        if (nArg < 2) {
                            let mut val: int = (if (pFunc.zName == leadName) { 1 } else { -1 })
                            sqlite3VdbeAddOp2(v, 88, tmpReg, val)
                        } else {
                            let mut op: int = (if (pFunc.zName == leadName) { 107 } else { 108 })
                            let mut tmpReg2: int = sqlite3GetTempReg(pParse)
                            sqlite3VdbeAddOp3(v, 96, iEph, (pWin.iArgCol + 1), tmpReg2)
                            sqlite3VdbeAddOp3(v, op, tmpReg2, tmpReg, tmpReg)
                            sqlite3ReleaseTempReg(pParse, tmpReg2)
                        }
                        sqlite3VdbeAddOp3(v, 30, csr, lbl, tmpReg)
                        ;
                        sqlite3VdbeAddOp3(v, 96, csr, pWin.iArgCol, pWin.regResult)
                        sqlite3VdbeResolveLabel(v, lbl)
                        sqlite3ReleaseTempReg(pParse, tmpReg)
                    }
                }
                pWin = pWin.pNextWin
            }
        }
        sqlite3VdbeAddOp2(v, 10, p.regGosub, p.addrGosub)
    }
}

@Export
public func windowInitAccum(pParse: ptr[Parse], pMWin: ptr[Window]): int {
    unsafe {
        let mut v: ptr[Vdbe] = sqlite3GetVdbe(pParse)
        let mut regArg: int = 0
        let mut nArg: int = 0
        let mut pWin: ptr[Window] = nil
        pWin = pMWin
        while (pWin != 0) {
            let mut pFunc: ptr[FuncDef] = pWin.pWFunc
            sqlite3VdbeAddOp2(v, 77, 0, pWin.regAccum)
            nArg = (if (nArg > windowArgCount(pWin)) { nArg } else { windowArgCount(pWin) })
            if (pMWin.regStartRowid == nil) {
                if ((pFunc.zName == nthValueName) || (pFunc.zName == firstValueName)) {
                    sqlite3VdbeAddOp2(v, 73, 0, pWin.regApp)
                    sqlite3VdbeAddOp2(v, 73, 0, (pWin.regApp + 1))

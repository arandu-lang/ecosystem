@Export
public func loadAnalysis(pParse: ptr[Parse], iDb: int) {
    unsafe {
        let mut v: ptr[Vdbe] = sqlite3GetVdbe(pParse)
        if (v != 0) {
            sqlite3VdbeAddOp1(v, 152, iDb)
        }
    }
}

@Export
public func analyzeDatabase(pParse: ptr[Parse], iDb: int) {
    unsafe {
        let mut db: ptr[Sqlite3] = pParse.db
        let mut pSchema: ptr[Schema] = db.aDb[iDb].pSchema
        let mut k: ptr[HashElem] = nil
        let mut iStatCur: int = 0
        let mut iMem: int = 0
        let mut iTab: int = 0
        sqlite3BeginWriteOperation(pParse, 0, iDb)
        iStatCur = pParse.nTab
        pParse.nTab += 3
        openStatTable(pParse, iDb, iStatCur, 0, 0)
        iMem = (pParse.nMem + 1)
        iTab = pParse.nTab
        k = pSchema.tblHash.first
        while (k != 0) {
            let mut pTab: ptr[Table] = (k.data as ptr[Table])
            analyzeOneTable(pParse, pTab, 0, iStatCur, iMem, iTab)
            k = k.next
        }
        loadAnalysis(pParse, iDb)
    }
}

@Export
public func analyzeTable(pParse: ptr[Parse], pTab: ptr[Table], pOnlyIdx: ptr[Index]) {
    unsafe {
        let mut iDb: int = 0
        let mut iStatCur: int = 0
        iDb = sqlite3SchemaToIndex(pParse.db, pTab.pSchema)
        sqlite3BeginWriteOperation(pParse, 0, iDb)
        iStatCur = pParse.nTab
        pParse.nTab += 3
        if (pOnlyIdx != 0) {
            openStatTable(pParse, iDb, iStatCur, pOnlyIdx.zName, c"idx")
        } else {
            openStatTable(pParse, iDb, iStatCur, pTab.zName, c"tbl")
        }
        analyzeOneTable(pParse, pTab, pOnlyIdx, iStatCur, (pParse.nMem + 1), pParse.nTab)
        loadAnalysis(pParse, iDb)
    }
}

@Export
public func decodeIntArray(zIntArray: ptr[i8], nOut: int, aOut: ptr[TRowcnt], aLog: ptr[LogEst], pIndex: ptr[Index]) {
    unsafe {
        let mut z: ptr[i8] = zIntArray
        let mut c: int = 0
        let mut i: int = 0
        let mut v: TRowcnt = TRowcnt {}
        i = 0
        while ((z[0] != 0) && (i < nOut)) {
            v = 0
            while true {
                c = z[0]
                if !(((c >= 48) && (c <= 57))) {
                    break
                }
                v = (((v * 10) + c) - 48)
                z = z + 1
            }
            aLog[i] = sqlite3LogEst(v)
            if (z[0] == 32) {
                z = z + 1
            }
            i = i + 1
        }
        pIndex.bUnordered = nil
        pIndex.noSkipScan = nil
        while (z[0] != 0) {
            if (sqlite3Strglob(c"unordered*", z) == 0) {
                pIndex.bUnordered = 1
            } else {
                if (sqlite3Strglob(c"sz=[0-9]*", z) == 0) {
                    let mut sz: int = sqlite3Atoi((z + 3))
                    if (sz < 2) {
                        sz = 2
                    }
                    pIndex.szIdxRow = sqlite3LogEst(sz)
                } else {
                    if (sqlite3Strglob(c"noskipscan*", z) == 0) {
                        pIndex.noSkipScan = 1
                    }
                }
            }
            while ((z[0] != 0) && (z[0] != 32)) {
                z = z + 1
            }
            while (z[0] == 32) {
                z = z + 1
            }
        }
    }
}

@Export
public func analysisLoader(pData: ptr[u8], argc: int, argv: ptr[ptr[i8]], notUsed: ptr[ptr[i8]]): int {
    unsafe {
        let mut pInfo: ptr[AnalysisInfo] = (pData as ptr[AnalysisInfo])
        let mut pIndex: ptr[Index] = nil
        let mut pTable: ptr[Table] = nil
        let mut z: ptr[i8] = nil
        if (((argv == 0) || (argv[0] == 0)) || (argv[2] == 0)) {
            return 0
        }
        pTable = sqlite3FindTable(pInfo.db, argv[0], pInfo.zDatabase)
        if (pTable == nil) {
            return 0
        }
        if (argv[1] == 0) {
            pIndex = nil
        } else {
            if (sqlite3Stricmp(argv[0], argv[1]) == 0) {
                pIndex = sqlite3PrimaryKeyIndex(pTable)
            } else {
                pIndex = sqlite3FindIndex(pInfo.db, argv[1], pInfo.zDatabase)
            }
        }
        z = argv[2]
        if (pIndex != 0) {
            let mut aiRowEst: ptr[TRowcnt] = nil
            let mut nCol: int = (pIndex.nKeyCol + 1)
            pIndex.bUnordered = nil
            decodeIntArray((z as ptr[i8]), nCol, aiRowEst, pIndex.aiRowLogEst, pIndex)
            pIndex.hasStat1 = 1
            if (pIndex.pPartIdxWhere == nil) {
                pTable.nRowLogEst = pIndex.aiRowLogEst[0]
                pTable.tabFlags |= 16
            }
        } else {
            let mut fakeIdx: Index = Index {}
            fakeIdx.szIdxRow = pTable.szTabRow
            decodeIntArray((z as ptr[i8]), 1, 0, &pTable.nRowLogEst, &fakeIdx)
            pTable.szTabRow = fakeIdx.szIdxRow
            pTable.tabFlags |= 16
        }
        return 0
    }
}

@Export
public func resolveAttachExpr(pName: ptr[NameContext], pExpr: ptr[Expr]): int {
    unsafe {
        let mut rc: int = 0
        if (pExpr != 0) {
            if (pExpr.op != 60) {
                rc = sqlite3ResolveExprNames(pName, pExpr)
            } else {
                pExpr.op = 118
            }
        }
        return rc
    }
}

@Export
public func attachFunc(context: ptr[Sqlite3Context], notUsed: int, argv: ptr[ptr[Sqlite3Value]]) {
    unsafe {
        let mut i: int = 0
        let mut rc: int = 0
        let mut db: ptr[Sqlite3] = sqlite3ContextDbHandle(context)
        let mut zName: ptr[i8] = nil
        let mut zFile: ptr[i8] = nil
        let mut zPath: ptr[i8] = nil
        let mut zErr: ptr[i8] = nil
        let mut flags: uint = 0
        let mut aNew: ptr[Db] = nil
        let mut pNew: ptr[Db] = nil
        let mut zErrDyn: ptr[i8] = nil
        let mut pVfs: ptr[Sqlite3Vfs] = nil
        zFile = (sqlite3ValueText(argv[0]) as ptr[i8])
        zName = (sqlite3ValueText(argv[1]) as ptr[i8])
        if (zFile == 0) {
            zFile = c""
        }
        if (zName == 0) {
            zName = c""
        }
        while true {
            if (db.init.reopenMemdb != 0) {
                let mut pNewBt: ptr[Btree] = nil
                pNew = &db.aDb[db.init.iDb]
                if ((sqlite3BtreeTxnState(pNew.pBt) != 0) || (sqlite3BtreeIsInBackup(pNew.pBt) != 0)) {
                    rc = 5
                    break
                }
                pVfs = sqlite3VfsFind(c"memdb")
                if (pVfs == nil) {
                    return
                }
                rc = sqlite3BtreeOpen(pVfs, c"x\000", db, &pNewBt, 0, 256)
                if (rc == 0) {
                    let mut pNewSchema: ptr[Schema] = sqlite3SchemaGet(db, pNewBt)
                    if (pNewSchema != 0) {
                        sqlite3BtreeClose(pNew.pBt)
                        pNew.pBt = pNewBt
                        pNew.pSchema = pNewSchema
                    } else {
                        sqlite3BtreeClose(pNewBt)
                        rc = 7
                    }
                }
                if (rc != 0) {
                    break
                }
            } else {
                if (db.nDb >= (db.aLimit[7] + 2)) {
                    zErrDyn = sqlite3MPrintf(db, c"too many attached databases - max %d", db.aLimit[7])
                    break
                }
                i = 0
                while (i < db.nDb) {
                    if (sqlite3DbIsNamed(db, i, zName) != 0) {
                        zErrDyn = sqlite3MPrintf(db, c"database %s is already in use", zName)
                        break
                    }
                    i = i + 1
                }
                if (db.aDb == db.aDbStatic) {
                    aNew = sqlite3DbMallocRawNN(db, (32 * 3))
                    if (aNew == 0) {
                        return
                    }
                    memcpy(aNew, db.aDb, (32 * 2))
                } else {
                    aNew = sqlite3DbRealloc(db, db.aDb, (32 * (1 + (db.nDb as I64))))
                    if (aNew == 0) {
                        return
                    }
                }
                db.aDb = aNew
                pNew = &db.aDb[db.nDb]
                memset(pNew, 0, 32)
                flags = db.openFlags
                rc = sqlite3ParseUri(db.pVfs.zName, zFile, &flags, &pVfs, &zPath, &zErr)
                if (rc != 0) {
                    if (rc == 7) {
                        sqlite3OomFault(db)
                    }
                    sqlite3ResultError(context, zErr, -1)
                    sqlite3Free(zErr)
                    return
                }
                if ((db.flags & ((32 as U64) << 32)) == 0) {
                    flags &= ~(4 | 2)
                    flags |= 1
                } else {
                    if ((db.flags & ((16 as U64) << 32)) == 0) {
                        flags &= ~4
                    }
                }
                flags |= 256
                rc = sqlite3BtreeOpen(pVfs, zPath, db, &pNew.pBt, 0, flags)
                db.nDb = db.nDb + 1
                pNew.zDbSName = sqlite3DbStrDup(db, zName)
            }
            db.noSharedCache = 0
            if (rc == 19) {
                rc = 1
                zErrDyn = sqlite3MPrintf(db, c"database is already attached")
            } else {
                if (rc == 0) {
                    let mut pPager: ptr[Pager] = nil
                    pNew.pSchema = sqlite3SchemaGet(db, pNew.pBt)
                    if (pNew.pSchema == nil) {
                        rc = 7
                    } else {
                        if ((pNew.pSchema.fileFormat != 0) && (pNew.pSchema.enc != db.enc)) {
                            zErrDyn = sqlite3MPrintf(db, c"attached databases must use the same text encoding as main database")
                            rc = 1
                        }
                    }
                    sqlite3BtreeEnter(pNew.pBt)
                    pPager = sqlite3BtreePager(pNew.pBt)
                    sqlite3PagerLockingMode(pPager, db.dfltLockMode)
                    sqlite3BtreeSecureDelete(pNew.pBt, sqlite3BtreeSecureDelete(db.aDb[0].pBt, -1))
                    sqlite3BtreeSetPagerFlags(pNew.pBt, (3 | (db.flags & 56)))
                    ;
                }
            }
            pNew.safetyLevel = (2 + 1)
            if ((rc == 0) && (pNew.zDbSName == nil)) {
                rc = 7
            }
            sqlite3FreeFilename(zPath)
            if (rc == 0) {
                sqlite3BtreeEnterAll(db)
                db.init.iDb = 0
                db.mDbFlags &= ~16
                if (db.init.reopenMemdb == 0) {
                    rc = sqlite3Init(db, &zErrDyn)
                }
                ;
            }
            if (rc != 0) {
                if (db.init.reopenMemdb == 0) {
                    let mut iDb: int = (db.nDb - 1)
                    if (db.aDb[iDb].pBt != 0) {
                        sqlite3BtreeClose(db.aDb[iDb].pBt)
                        db.aDb[iDb].pBt = 0
                        db.aDb[iDb].pSchema = 0
                    }
                    sqlite3ResetAllSchemasOfConnection(db)
                    db.nDb = iDb
                    if ((rc == 7) || (rc == (10 | (12 << 8)))) {
                        sqlite3OomFault(db)
                        sqlite3DbFree(db, zErrDyn)
                        zErrDyn = sqlite3MPrintf(db, c"out of memory")
                    } else {
                        if (zErrDyn == 0) {
                            zErrDyn = sqlite3MPrintf(db, c"unable to open database: %s", zFile)
                        }
                    }
                }
                break
            }
            return
            break
        }
        if (zErrDyn != 0) {
            sqlite3ResultError(context, zErrDyn, -1)
            sqlite3DbFree(db, zErrDyn)
        }
        if (rc != 0) {
            sqlite3ResultErrorCode(context, rc)
        }
    }
}

@Export
public func detachFunc(context: ptr[Sqlite3Context], notUsed: int, argv: ptr[ptr[Sqlite3Value]]) {
    unsafe {
        let mut zName: ptr[i8] = (sqlite3ValueText(argv[0]) as ptr[i8])
        let mut db: ptr[Sqlite3] = sqlite3ContextDbHandle(context)
        let mut i: int = 0
        let mut pDb: ptr[Db] = nil
        let mut pEntry: ptr[HashElem] = nil
        let mut zErr: [128]i8 = [0; 128]
        if (zName == 0) {
            zName = c""
        }
        i = 0
        while (i < db.nDb) {
            pDb = &db.aDb[i]
            if (pDb.pBt == nil) {
                continue
            }
            if (sqlite3DbIsNamed(db, i, zName) != 0) {
                break
            }
            i = i + 1
        }
        while true {
            if (i >= db.nDb) {
                sqlite3Snprintf(128, zErr, c"no such database: %s", zName)
                break
            }
            if (i < 2) {
                sqlite3Snprintf(128, zErr, c"cannot detach database %s", zName)
                break
            }
            if ((sqlite3BtreeTxnState(pDb.pBt) != 0) || (sqlite3BtreeIsInBackup(pDb.pBt) != 0)) {
                sqlite3Snprintf(128, zErr, c"database %s is locked", zName)
                break
            }
            pEntry = db.aDb[1].pSchema.trigHash.first
            while (pEntry != 0) {
                let mut pTrig: ptr[Trigger] = (pEntry.data as ptr[Trigger])
                if (pTrig.pTabSchema == pDb.pSchema) {
                    pTrig.pTabSchema = pTrig.pSchema
                }
                pEntry = pEntry.next
            }
            sqlite3BtreeClose(pDb.pBt)
            pDb.pBt = nil
            pDb.pSchema = nil
            sqlite3CollapseDatabaseArray(db)
            return
            break
        }
        sqlite3ResultError(context, zErr, -1)
    }
}

@Export
public func codeAttach(pParse: ptr[Parse], typeVal: int, pFunc: ptr[FuncDef], pAuthArg: ptr[Expr], pFilename: ptr[Expr], pDbname: ptr[Expr], pKey: ptr[Expr]) {
    unsafe {
        let mut rc: int = 0
        let mut sName: NameContext = NameContext {}
        let mut v: ptr[Vdbe] = nil
        let mut db: ptr[Sqlite3] = pParse.db
        let mut regArgs: int = 0
        while true {
            if (0 != sqlite3ReadSchema(pParse)) {
                break
            }
            if (pParse.nErr != 0) {
                break
            }
            memset(&sName, 0, 56)
            sName.pParse = pParse
            if (((0 != resolveAttachExpr(&sName, pFilename)) || (0 != resolveAttachExpr(&sName, pDbname))) || (0 != resolveAttachExpr(&sName, pKey))) {
                break
            }
            if (pAuthArg != 0) {
                let mut zAuthArg: ptr[i8] = nil
                if (pAuthArg.op == 118) {
                    zAuthArg = pAuthArg.u.zToken
                } else {

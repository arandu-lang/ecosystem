@Export
public func parserDoubleLinkSelect(pParse: ptr[Parse], p: ptr[Select]) {
    unsafe {
        if (p.pPrior != 0) {
            let mut pNext: ptr[Select] = nil
            let mut pLoop: ptr[Select] = p
            let mut mxSelect: int = 0
            let mut cnt: int = 1
            while (1 != 0) {
                pLoop.pNext = pNext
                pLoop.selFlags |= 256
                pNext = pLoop
                pLoop = pLoop.pPrior

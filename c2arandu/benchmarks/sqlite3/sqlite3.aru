            db.lookaside.sz = 0
            xAuth = db.xAuth
            db.xAuth = 0
            pSelTab = sqlite3ResultSetOfSelect(pParse, pSel, 64)
            db.xAuth = xAuth
            pParse.nTab = nTab
            pParse.nSelect = nSelect
            if (pSelTab == nil) {

            }
            pCte.zCteErr = nil
            pParse.pWith = pSavedWith
            return 1
        }
        return 0
    }
}

@Export
public func inAnyUsingClause(zName: ptr[i8], pBase: ptr[SrcItem], n: int): int {
    unsafe {
        let mut localPBase = pBase
        let mut localN = n
        while (localN > 0) {
            localN = localN - 1
            localPBase = localPBase + 1
            if (localPBase.fg.isUsing == 0) {
                continue
            }
            if (localPBase.u3.pUsing == 0) {
                continue
            }
            if (sqlite3IdListIndex(localPBase.u3.pUsing, zName) >= 0) {
                return 1
            }
        }
        return 0
    }
}


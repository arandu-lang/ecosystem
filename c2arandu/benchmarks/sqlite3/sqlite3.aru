    }
}

@Export
public func assignAggregateRegisters(pParse: ptr[Parse], pAggInfo: ptr[AggInfo]) {
    unsafe {
        pAggInfo.iFirstReg = (pParse.nMem + 1)
        pParse.nMem += (pAggInfo.nColumn + pAggInfo.nFunc)
    }
}

@Export
public func resetAccumulator(pParse: ptr[Parse], pAggInfo: ptr[AggInfo]) {
    unsafe {
        let mut v: ptr[Vdbe] = pParse.pVdbe
        let mut i: int = 0
        let mut pFunc: ptr[AggInfoFunc] = nil
        let mut nReg: int = (pAggInfo.nFunc + pAggInfo.nColumn)
        if (nReg == 0) {
            return
        }
        if (pParse.nErr != 0) {
            return
        }
        sqlite3VdbeAddOp3(v, 77, 0, pAggInfo.iFirstReg, ((pAggInfo.iFirstReg + nReg) - 1))
        pFunc = pAggInfo.aFunc
        while (i < pAggInfo.nFunc) {
            if (pFunc.iDistinct >= 0) {
                let mut pE: ptr[Expr] = pFunc.pFExpr
                if ((pE.x.pList == nil) || (pE.x.pList.nExpr != 1)) {
                    sqlite3ErrorMsg(pParse, c"DISTINCT aggregates must have exactly one argument")
                    pFunc.iDistinct = -1

                    if ((iCol < pS.pEList.nExpr) && ((0 == 0) || (iCol >= 0))) {
                        let mut sNC: NameContext = NameContext {}
                        let mut p: ptr[Expr] = pS.pEList.a[iCol].pExpr
                        sNC.pSrcList = pS.pSrc
                        sNC.pNext = localPNC
                        sNC.pParse = localPNC.pParse
                        zType = columnTypeImpl(&sNC, p)
                    }
                } else {
                    if (iCol < 0) {
                        zType = c"INTEGER"
                    } else {
                        zType = sqlite3ColumnType(&pTab.aCol[iCol], 0)
                    }
                }
                break
            }
            139 => {
                let mut sNC: NameContext = NameContext {}
                let mut pS: ptr[Select] = nil
                let mut p: ptr[Expr] = nil
                pS = pExpr.x.pSelect
                p = pS.pEList.a[0].pExpr
                sNC.pSrcList = pS.pSrc
                sNC.pNext = localPNC
                sNC.pParse = localPNC.pParse
                zType = columnTypeImpl(&sNC, p)
                break
            }
            _ => {
            }
        }
        return zType
    }
}

@Export
public func generateColumnTypes(pParse: ptr[Parse], pTabList: ptr[SrcList], pEList: ptr[ExprList]) {
    unsafe {
        let mut v: ptr[Vdbe] = pParse.pVdbe
        let mut i: int = 0
        let mut sNC: NameContext = NameContext {}
        sNC.pSrcList = pTabList
        sNC.pParse = pParse
        sNC.pNext = 0
        i = 0
        while (i < pEList.nExpr) {
            let mut p: ptr[Expr] = pEList.a[i].pExpr
            let mut zType: ptr[i8] = nil
            zType = columnTypeImpl(&sNC, p)
            sqlite3VdbeSetColName(v, i, 1, zType, (1) as Sqlite3DestructorType))
            i = i + 1
        }
    }
}

@Export
public func computeLimitRegisters(pParse: ptr[Parse], p: ptr[Select], iBreak: int) {
    unsafe {
        let mut v: ptr[Vdbe] = nil
        let mut iLimit: int = 0
        let mut iOffset: int = 0
        let mut n: int = 0
        let mut pLimit: ptr[Expr] = p.pLimit
        if (p.iLimit != 0) {
            return
        }
        if (pLimit != 0) {
            iLimit = (pParse.nMem + 1)
            p.iLimit = iLimit
            v = sqlite3GetVdbe(pParse)
            if (sqlite3ExprIsInteger(pLimit.pLeft, &n, pParse) != 0) {
                sqlite3VdbeAddOp2(v, 73, n, iLimit)
                ;
                if (n == 0) {
                    sqlite3VdbeGoto(v, iBreak)
                } else {
                    if ((n >= 0) && (p.nSelectRow > sqlite3LogEst((n as U64)))) {
                        p.nSelectRow = sqlite3LogEst((n as U64))
                        p.selFlags |= 16384
                    }
                }
            } else {
                sqlite3ExprCode(pParse, pLimit.pLeft, iLimit)
                sqlite3VdbeAddOp1(v, 13, iLimit)
                ;
                ;
                sqlite3VdbeAddOp2(v, 17, iLimit, iBreak)
                ;
            }
            if (pLimit.pRight != 0) {
                iOffset = (pParse.nMem + 1)
                p.iOffset = iOffset
                pParse.nMem = pParse.nMem + 1
                sqlite3ExprCode(pParse, pLimit.pRight, iOffset)
                sqlite3VdbeAddOp1(v, 13, iOffset)
                ;
                ;
                sqlite3VdbeAddOp3(v, 162, iLimit, (iOffset + 1), iOffset)
                ;
            }
        }
    }
}

@Export
public func multiSelectCollSeq(pParse: ptr[Parse], p: ptr[Select], iCol: int): ptr[CollSeq] {
    unsafe {
        let mut pRet: ptr[CollSeq] = nil
        if (p.pPrior != 0) {
            pRet = multiSelectCollSeq(pParse, p.pPrior, iCol)
        } else {
            pRet = nil
        }
        if ((pRet == nil) && (iCol < p.pEList.nExpr)) {
            pRet = sqlite3ExprCollSeq(pParse, p.pEList.a[iCol].pExpr)
        }
        return pRet
    }
}

@Export
public func multiSelectByMergeKeyInfo(pParse: ptr[Parse], p: ptr[Select], nExtra: int): ptr[KeyInfo] {
    unsafe {
        let mut pOrderBy: ptr[ExprList] = p.pOrderBy
        let mut nOrderBy: int = (if (pOrderBy != nil) { pOrderBy.nExpr } else { 0 })
        let mut db: ptr[Sqlite3] = pParse.db
        let mut pRet: ptr[KeyInfo] = sqlite3KeyInfoAlloc(db, (nOrderBy + nExtra), 1)
        if (pRet != 0) {
            let mut i: int = 0
            i = 0
            while (i < nOrderBy) {
                let mut pItem: ptr[ExprListItem] = &pOrderBy.a[i]
                let mut pTerm: ptr[Expr] = pItem.pExpr
                let mut pColl: ptr[CollSeq] = nil
                if ((pTerm.flags & 512) != 0) {
                    pColl = sqlite3ExprCollSeq(pParse, pTerm)
                } else {
                    pColl = multiSelectCollSeq(pParse, p, (pItem.u.x.iOrderByCol - 1))
                    if (pColl == nil) {
                        pColl = db.pDfltColl
                    }
                    pOrderBy.a[i].pExpr = sqlite3ExprAddCollateString(pParse, pTerm, pColl.zName)
                }
                pRet.aColl[i] = pColl
                pRet.aSortFlags[i] = pOrderBy.a[i].fg.sortFlags
                i = i + 1
            }
        }
        return pRet
    }
}

@Export
public func generateWithRecursiveQuery(pParse: ptr[Parse], p: ptr[Select], pDest: ptr[SelectDest]) {
    unsafe {
        let mut pSrc: ptr[SrcList] = p.pSrc
        let mut nCol: int = p.pEList.nExpr
        let mut v: ptr[Vdbe] = pParse.pVdbe
        let mut pSetup: ptr[Select] = nil
        let mut pFirstRec: ptr[Select] = nil
        let mut addrTop: int = 0
        let mut addrCont: int = 0
        let mut addrBreak: int = 0
        let mut iCurrent: int = 0
        let mut regCurrent: int = 0
        let mut iQueue: int = 0
        let mut iDistinct: int = 0
        let mut eDest: int = 6
        let mut destQueue: SelectDest = SelectDest {}
        let mut i: int = 0
        let mut rc: int = 0
        let mut pOrderBy: ptr[ExprList] = nil
        let mut pLimit: ptr[Expr] = nil
        let mut regLimit: int = 0
        let mut regOffset: int = 0
        if (p.pWin != 0) {
            sqlite3ErrorMsg(pParse, c"cannot use window functions in recursive queries")
            return
        }
        if (sqlite3AuthCheck(pParse, 33, 0, 0, 0) != 0) {
            return
        }
        addrBreak = sqlite3VdbeMakeLabel(pParse)
        p.nSelectRow = 320
        computeLimitRegisters(pParse, p, addrBreak)
        pLimit = p.pLimit
        regLimit = p.iLimit
        regOffset = p.iOffset
        p.pLimit = nil
        p.iOffset = nil
        p.iLimit = p.iOffset
        pOrderBy = p.pOrderBy
        i = 0
        while (i < pSrc.nSrc) {
            if (pSrc.a[i].fg.isRecursive != 0) {
                iCurrent = pSrc.a[i].iCursor
                break
            }
            i = i + 1
        }
        iQueue = (pParse.nTab + 1)
        if (p.op == 135) {
            eDest = (if (pOrderBy != 0) { 4 } else { 3 })
            iDistinct = (pParse.nTab + 1)
        } else {
            eDest = (if (pOrderBy != 0) { 5 } else { 6 })
        }
        sqlite3SelectDestInit(&destQueue, eDest, iQueue)
        regCurrent = (pParse.nMem + 1)
        sqlite3VdbeAddOp3(v, 123, iCurrent, regCurrent, nCol)
        if (pOrderBy != 0) {
            let mut pKeyInfo: ptr[KeyInfo] = multiSelectByMergeKeyInfo(pParse, p, 1)
            sqlite3VdbeAddOp4(v, 120, iQueue, (pOrderBy.nExpr + 2), 0, (pKeyInfo as ptr[i8]), 9))
            destQueue.pOrderBy = pOrderBy
        } else {
            sqlite3VdbeAddOp2(v, 120, iQueue, nCol)
        }
        ;
        if (iDistinct != 0) {
            let mut pKeyInfo: ptr[KeyInfo] = nil
            let mut apColl: ptr[ptr[CollSeq]] = nil
            nCol = p.pEList.nExpr
            pKeyInfo = sqlite3KeyInfoAlloc(pParse.db, nCol, 1)
            if (pKeyInfo != 0) {
                i = 0
                while (i < nCol) {
                    apColl[0] = multiSelectCollSeq(pParse, p, i)
                    if (0 == apColl[0]) {
                        apColl[0] = pParse.db.pDfltColl
                    }
                    i = i + 1
                    apColl = apColl + 1
                }
                sqlite3VdbeAddOp4(v, 120, iDistinct, nCol, 0, (pKeyInfo as ptr[u8]), 9))
            } else {
            }
        }
        p.pOrderBy = nil
        while true {
            pFirstRec = p
            while (pFirstRec != nil) {
                if ((pFirstRec.selFlags & 8) != 0) {
                    sqlite3ErrorMsg(pParse, c"recursive aggregate queries not supported")
                    break
                }
                pFirstRec.op = 136
                if ((pFirstRec.pPrior.selFlags & 8192) == 0) {
                    break
                }
                pFirstRec = pFirstRec.pPrior
            }
            pSetup = pFirstRec.pPrior
            pSetup.pNext = nil
            sqlite3VdbeExplain(pParse, 1, c"SETUP")
            rc = sqlite3Select(pParse, pSetup, &destQueue)
            pSetup.pNext = p
            if (rc != 0) {
                break
            }
            addrTop = sqlite3VdbeAddOp2(v, 36, iQueue, addrBreak)
            ;
            sqlite3VdbeAddOp1(v, 138, iCurrent)
            if (pOrderBy != 0) {
                sqlite3VdbeAddOp3(v, 96, iQueue, (pOrderBy.nExpr + 1), regCurrent)
            } else {
                sqlite3VdbeAddOp2(v, 136, iQueue, regCurrent)
            }
            sqlite3VdbeAddOp1(v, 132, iQueue)
            addrCont = sqlite3VdbeMakeLabel(pParse)
            codeOffset(v, regOffset, addrCont)
            selectInnerLoop(pParse, p, iCurrent, 0, 0, pDest, addrCont, addrBreak)
            if (regLimit != 0) {
                sqlite3VdbeAddOp2(v, 63, regLimit, addrBreak)
                ;
            }
            sqlite3VdbeResolveLabel(v, addrCont)
            pFirstRec.pPrior = nil
            sqlite3VdbeExplain(pParse, 1, c"RECURSIVE STEP")
            sqlite3Select(pParse, p, &destQueue)
            pFirstRec.pPrior = pSetup
            sqlite3VdbeGoto(v, addrTop)
            sqlite3VdbeResolveLabel(v, addrBreak)
            break
        }
        sqlite3ExprListDelete(pParse.db, p.pOrderBy)
        p.pOrderBy = pOrderBy
        p.pLimit = pLimit
        return
    }
}

@Export
public func multiSelectByMerge(pParse: ptr[Parse], p: ptr[Select], pDest: ptr[SelectDest]): int {
    unsafe {
        let mut i: int = 0
        let mut j: int = 0
        let mut pPrior: ptr[Select] = nil
        let mut pSplit: ptr[Select] = nil
        let mut nSelect: int = 0
        let mut v: ptr[Vdbe] = nil
        let mut destA: SelectDest = SelectDest {}
        let mut destB: SelectDest = SelectDest {}
        let mut regAddrA: int = 0
        let mut regAddrB: int = 0
        let mut addrSelectA: int = 0
        let mut addrSelectB: int = 0
        let mut regOutA: int = 0
        let mut regOutB: int = 0
        let mut addrOutA: int = 0
        let mut addrOutB: int = 0
        let mut addrEofA: int = 0
        let mut addrEofANoB: int = 0
        let mut addrEofB: int = 0
        let mut addrAltB: int = 0
        let mut addrAeqB: int = 0
        let mut addrAgtB: int = 0
        let mut regLimitA: int = 0
        let mut regLimitB: int = 0
        let mut regPrev: int = 0
        let mut savedLimit: int = 0
        let mut savedOffset: int = 0
        let mut labelCmpr: int = 0
        let mut labelEnd: int = 0
        let mut addr1: int = 0
        let mut op: int = 0
        let mut pKeyDup: ptr[KeyInfo] = nil
        let mut pKeyMerge: ptr[KeyInfo] = nil
        let mut db: ptr[Sqlite3] = nil
        let mut pOrderBy: ptr[ExprList] = nil
        let mut nOrderBy: int = 0
        let mut aPermute: ptr[U32] = nil

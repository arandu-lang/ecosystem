@Export
public func codeDistinct(pParse: ptr[Parse], eTnctType: int, iTab: int, addrRepeat: int, pEList: ptr[ExprList], regElem: int): int {
    unsafe {
        let mut iRet: int = 0
        let mut nResultCol: int = pEList.nExpr
        let mut v: ptr[Vdbe] = pParse.pVdbe
        match eTnctType {
            2 => {
                let mut i: int = 0
                let mut iJump: int = 0

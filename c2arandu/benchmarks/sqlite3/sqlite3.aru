                    pFunc.iDistAddr = sqlite3VdbeAddOp4(v, 120, pFunc.iDistinct, 0, 0, (pKeyInfo as ptr[i8]), 9))
                    sqlite3VdbeExplain(pParse, 0, c"USE TEMP B-TREE FOR %s(DISTINCT)", pFunc.pFunc.zName)

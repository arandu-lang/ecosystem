@Export
public func viewGetColumnNames(pParse: ptr[Parse], pTable: ptr[Table]): int {
    unsafe {
        let mut pSelTab: ptr[Table] = nil
        let mut pSel: ptr[Select] = nil
        let mut nErr: int = 0
        let mut db: ptr[Sqlite3] = pParse.db
        let mut rc: int = 0
        let mut xAuth: Sqlite3Xauth = Sqlite3Xauth {}
        if (pTable.eTabType == 1) {
            db.nSchemaLock = db.nSchemaLock + 1
            rc = sqlite3VtabCallConnect(pParse, pTable)
            db.nSchemaLock = db.nSchemaLock - 1
            return rc
        }
        if (pTable.nCol < 0) {
            sqlite3ErrorMsg(pParse, c"view %s is circularly defined", pTable.zName)
            return 1
        }
        pSel = sqlite3SelectDup(db, pTable.u.view.pSelect, 0)
        if (pSel != 0) {
            let mut eParseMode: U8 = pParse.eParseMode
            let mut nTab: int = pParse.nTab
            let mut nSelect: int = pParse.nSelect
            pParse.eParseMode = nil
            sqlite3SrcListAssignCursors(pParse, pSel.pSrc)
            pTable.nCol = -1

                if ((db.mallocFailed == 0) && (pList.a[i].zEName != nil)) {
                    let mut pItem: ptr[ExprListItem] = &pNew.a[(pNew.nExpr - 1)]
                    pItem.zEName = sqlite3DbStrDup(db, pList.a[i].zEName)
                    pItem.fg.eEName = pList.a[i].fg.eEName

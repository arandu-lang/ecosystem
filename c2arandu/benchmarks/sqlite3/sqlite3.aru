            ;
            addrEofA = sqlite3VdbeAddOp2(v, 10, regOutB, addrOutB)
            ;
            addrEofANoB = sqlite3VdbeAddOp2(v, 12, regAddrB, labelEnd)
            ;
            ;
            sqlite3VdbeGoto(v, addrEofA)
            p.nSelectRow = sqlite3LogEstAdd(p.nSelectRow, pPrior.nSelectRow)
        }
        if (op == 138) {
            addrEofB = addrEofA
            if (p.nSelectRow > pPrior.nSelectRow) {
                p.nSelectRow = pPrior.nSelectRow
            }
        } else {
            ;
            addrEofB = sqlite3VdbeAddOp2(v, 10, regOutA, addrOutA)
            ;
            sqlite3VdbeAddOp2(v, 12, regAddrA, labelEnd)
            ;
            ;
            sqlite3VdbeGoto(v, addrEofB)
        }
        addrAltB = sqlite3VdbeAddOp2(v, 10, regOutA, addrOutA)
        ;
        sqlite3VdbeAddOp2(v, 12, regAddrA, addrEofA)
        ;
        ;
        sqlite3VdbeGoto(v, labelCmpr)
        if (op == 136) {
            addrAeqB = addrAltB
        } else {
            if (op == 138) {
                addrAeqB = addrAltB
                addrAltB = addrAltB + 1
            } else {
                addrAeqB = (addrAltB + 1)
            }
        }
        addrAgtB = sqlite3VdbeCurrentAddr(v)
        if ((op == 136) || (op == 135)) {
            sqlite3VdbeAddOp2(v, 10, regOutB, addrOutB)
            ;
            sqlite3VdbeAddOp2(v, 12, regAddrB, addrEofB)
            ;
            ;
            sqlite3VdbeGoto(v, labelCmpr)
        } else {
            addrAgtB = addrAgtB + 1
        }
        sqlite3VdbeJumpHere(v, addr1)
        sqlite3VdbeAddOp2(v, 12, regAddrA, addrEofANoB)
        ;
        ;
        sqlite3VdbeAddOp2(v, 12, regAddrB, addrEofB)
        ;
        ;
        if (aPermute != 0) {
            sqlite3VdbeAddOp4(v, 91, 0, 0, 0, (aPermute as ptr[i8]), 15))
        }
        sqlite3VdbeResolveLabel(v, labelCmpr)
        sqlite3VdbeAddOp4(v, 92, destA.iSdst, destB.iSdst, nOrderBy, (pKeyMerge as ptr[i8]), 9))
        if (aPermute != 0) {
            sqlite3VdbeChangeP5(v, 1)
        }
        sqlite3VdbeAddOp3(v, 14, addrAltB, addrAeqB, addrAgtB)
        ;
        ;
        ;
        ;
        sqlite3VdbeResolveLabel(v, labelEnd)
        if (pSplit.pPrior != 0) {
            sqlite3ParserAddCleanup(pParse, sqlite3SelectDeleteGeneric, pSplit.pPrior)
        }
        pSplit.pPrior = pPrior
        pPrior.pNext = pSplit
        sqlite3ExprListDelete(db, pPrior.pOrderBy)
        pPrior.pOrderBy = nil
        sqlite3VdbeExplainPop(pParse)
        return ((pParse.nErr != nil) as int)
    }
}

@Export
public func multiSelectValues(pParse: ptr[Parse], p: ptr[Select], pDest: ptr[SelectDest]): int {
    unsafe {
        let mut localP = p
        let mut nRow: int = 1
        let mut rc: int = 0
        let mut bShowAll: int = (localP.pLimit == 0)
        while true {
            if (localP.pWin != 0) {
                return -1
            }
            if (localP.pPrior == 0) {
                break
            }
            localP = localP.pPrior
            nRow += bShowAll
            if !((1 != 0)) {
                break
            }
        }
        sqlite3VdbeExplain(pParse, 0, c"SCAN %d CONSTANT ROW%s", nRow, (if (nRow == 1) { c"" } else { c"S" }))
        while (localP != 0) {
            selectInnerLoop(pParse, localP, -1, 0, 0, pDest, 1, 1)
            if (bShowAll == 0) {
                break
            }
            localP.nSelectRow = nRow
            localP = localP.pNext
        }
        return rc
    }
}

@Export
public func hasAnchor(p: ptr[Select]): int {
    unsafe {
        let mut localP = p
        while ((localP != 0) && ((localP.selFlags & 8192) != 0)) {
            localP = localP.pPrior
        }
        return ((localP != 0) as int)
    }
}

@Export
public func multiSelect(pParse: ptr[Parse], p: ptr[Select], pDest: ptr[SelectDest]): int {
    unsafe {
        let mut rc: int = 0
        let mut pPrior: ptr[Select] = nil
        let mut v: ptr[Vdbe] = nil
        let mut dest: SelectDest = SelectDest {}
        let mut pDelete: ptr[Select] = nil
        let mut db: ptr[Sqlite3] = nil
        db = pParse.db
        pPrior = p.pPrior
        dest = pDest[0]
        v = sqlite3GetVdbe(pParse)
        if (dest.eDest == 10) {
            sqlite3VdbeAddOp2(v, 120, dest.iSDParm, p.pEList.nExpr)
            dest.eDest = 12
        }
        while true {
            if ((p.selFlags & 1024) != 0) {
                rc = multiSelectValues(pParse, p, &dest)
                if (rc >= 0) {
                    break
                }
                rc = 0
            }
            if (((p.selFlags & 8192) != 0) && (hasAnchor(p) != 0)) {
                generateWithRecursiveQuery(pParse, p, &dest)
            } else {
                if (p.pOrderBy != 0) {
                    return multiSelectByMerge(pParse, p, pDest)
                } else {
                    if (p.op != 136) {
                        let mut pOne: ptr[Expr] = sqlite3ExprInt32(db, 1)
                        p.pOrderBy = sqlite3ExprListAppend(pParse, 0, pOne)
                        if (pParse.nErr != 0) {
                            break
                        }
                        p.pOrderBy.a[0].u.x.iOrderByCol = 1
                        return multiSelectByMerge(pParse, p, pDest)
                    } else {
                        let mut addr: int = 0
                        let mut nLimit: int = 0
                        if (pPrior.pPrior == nil) {
                            sqlite3VdbeExplain(pParse, 1, c"COMPOUND QUERY")
                            sqlite3VdbeExplain(pParse, 1, c"LEFT-MOST SUBQUERY")
                        }
                        pPrior.iLimit = p.iLimit
                        pPrior.iOffset = p.iOffset
                        pPrior.pLimit = sqlite3ExprDup(db, p.pLimit, 0)
                        ;
                        rc = sqlite3Select(pParse, pPrior, &dest)
                        sqlite3ExprDelete(db, pPrior.pLimit)
                        pPrior.pLimit = nil

                    let mut pColl: ptr[CollSeq] = pKeyInfo.aColl[j]
                    let mut zColl: ptr[i8] = (if (pColl != 0) { pColl.zName } else { c"" })
                    if (strcmp(zColl, c"BINARY") == 0) {

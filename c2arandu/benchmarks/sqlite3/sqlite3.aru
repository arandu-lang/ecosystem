                // goto trigger_orphan_error
            }
            if (((pTab.tabFlags & 4096) != 0) && (sqlite3ReadOnlyShadowTables(db) != 0)) {
                sqlite3ErrorMsg(pParse, c"cannot create triggers on shadow tables")
                // goto trigger_orphan_error
            }
            zName = sqlite3NameFromToken(db, pName)
            if (zName == 0) {

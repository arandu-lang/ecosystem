@Export
public func getToken(pz: ptr[ptr[u8]]): int {
    unsafe {
        let mut z: ptr[u8] = pz[0]
        let mut t: int = 0
        while true {
            z += sqlite3GetToken(z, &t)
            if !(((t == 184) || (t == 185))) {
                break
            }
        }
        if ((((((t == 60) || (t == 118)) || (t == 119)) || (t == 165)) || (t == 166)) || (sqlite3ParserFallback(t) == 60)) {
            t = 60
        }
        pz[0] = z
        return t
    }
}

@Export

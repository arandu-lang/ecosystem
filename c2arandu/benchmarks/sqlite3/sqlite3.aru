@Export
public func yyGrowStack(p: ptr[YyParser]): int {
    unsafe {
        let mut oldSize: int = (1 + ((p.yystackEnd - p.yystack) as int))
        let mut newSize: int = 0
        let mut idx: int = 0
        let mut pNew: ptr[YyStackEntry] = nil
        let mut nLimit: int = parserStackSizeLimit(p.pParse)
        newSize = ((oldSize * 2) + 100)
        if (newSize > nLimit) {
            newSize = nLimit

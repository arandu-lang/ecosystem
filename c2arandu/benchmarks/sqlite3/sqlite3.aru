@Export
public func analyzeAggFuncArgs(pAggInfo: ptr[AggInfo], pNC: ptr[NameContext]) {
    unsafe {
        let mut i: int = 0
        pNC.ncFlags |= 131072
        i = 0
        while (i < pAggInfo.nFunc) {
            let mut pExpr: ptr[Expr] = pAggInfo.aFunc[i].pFExpr
            sqlite3ExprAnalyzeAggList(pNC, pExpr.x.pList)
            if (pExpr.pLeft != 0) {
                sqlite3ExprAnalyzeAggList(pNC, pExpr.pLeft.x.pList)
            }
            if ((pExpr.flags & (16777216 as U32)) != 0) {
                sqlite3ExprAnalyzeAggregates(pNC, pExpr.y.pWin.pFilter)
            }
            i = i + 1
        }
        pNC.ncFlags &= ~131072
    }
}

@Export
public func optimizeAggregateUseOfIndexedExpr(pParse: ptr[Parse], pSelect: ptr[Select], pAggInfo: ptr[AggInfo], pNC: ptr[NameContext]) {
    unsafe {
        pAggInfo.nColumn = pAggInfo.nAccumulator
        if (pAggInfo.nSortingColumn > 0) {
            let mut mx: int = (pSelect.pGroupBy.nExpr - 1)
            let mut j: int = 0
            let mut k: int = 0
            j = 0
            while (j < pAggInfo.nColumn) {
                k = pAggInfo.aCol[j].iSorterColumn
                if (k > mx) {
                    mx = k
                }
                j = j + 1
            }
            pAggInfo.nSortingColumn = (mx + 1)
        }
        analyzeAggFuncArgs(pAggInfo, pNC)

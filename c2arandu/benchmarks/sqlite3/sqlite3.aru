@Export
public func sqlite3RegisterPerConnectionBuiltinFunctions(db: ptr[Sqlite3]) {
    unsafe {
        let mut rc: int = sqlite3OverloadFunction(db, c"MATCH", 2)
        if (rc == 7) {
            sqlite3OomFault(db)
        }
    }
}


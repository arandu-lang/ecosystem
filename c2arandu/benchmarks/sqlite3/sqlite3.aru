            return 0
        }
        eOpenState = db.eOpenState
        if (eOpenState != 118) {
            if (sqlite3SafetyCheckSickOrOk(db) != 0) {
                ;
                logBadConnection(c"unopened")
            }
            return 0
        } else {
            return 1
        }
    }
}

@Export

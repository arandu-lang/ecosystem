                    if (i < (nResultCol - 1)) {
                        sqlite3VdbeAddOp3(v, 53, (regElem + i), iJump, (regPrev + i))
                        ;
                    } else {
                        sqlite3VdbeAddOp3(v, 54, (regElem + i), addrRepeat, (regPrev + i))
                        ;
                    }
                    sqlite3VdbeChangeP4(v, -1, (pColl as ptr[i8]), 2))
                    sqlite3VdbeChangeP5(v, 128)
                    i = i + 1

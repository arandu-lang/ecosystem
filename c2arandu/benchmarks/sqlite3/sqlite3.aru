            mxSelect = pParse.db.aLimit[4]
            if ((((p.selFlags & (1024 | 512)) == 0) && (mxSelect > 0)) && (cnt > mxSelect)) {
                sqlite3ErrorMsg(pParse, c"too many terms in compound SELECT")
            }
        }
    }

        if ((pOnlyIdx == nil) && (needTableCnt != 0)) {
            ;
            sqlite3VdbeAddOp2(v, 100, iTabCur, regStat1)
            jZeroRows = sqlite3VdbeAddOp1(v, 17, regStat1)

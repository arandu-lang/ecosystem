            pCheck.nErr = pCheck.nErr + 1
        }
    }
}

@Export
public func checkProgress(pCheck: ptr[IntegrityCk]) {
    unsafe {
        let mut db: ptr[Sqlite3] = pCheck.db
        if (&db.u1.isInterrupted != 0) {
            pCheck.rc = 9
            pCheck.nErr = pCheck.nErr + 1
            pCheck.mxErr = nil
        }
        if (db.xProgress != 0) {
            pCheck.nStep = pCheck.nStep + 1
            if (((pCheck.nStep % db.nProgressOps) == 0) && (db.xProgress(db.pProgressArg) != 0)) {
                pCheck.rc = 9
                pCheck.nErr = pCheck.nErr + 1
                pCheck.mxErr = nil
            }
        }
    }
}

@Export
public func checkAppendMsg(pCheck: ptr[IntegrityCk], zFormat: ptr[i8]) {
    unsafe {
        let mut ap: VaList = VaList {}
        checkProgress(pCheck)
        if (pCheck.mxErr == nil) {
            return
        }
        pCheck.mxErr = pCheck.mxErr - 1
        pCheck.nErr = pCheck.nErr + 1
        BuiltinVaStart(ap, zFormat)
        if (pCheck.errMsg.nChar != 0) {
            sqlite3StrAppend(&pCheck.errMsg, c"\n", 1)
        }
        if (pCheck.zPfx != 0) {
            sqlite3StrAppendf(&pCheck.errMsg, pCheck.zPfx, pCheck.v0, pCheck.v1, pCheck.v2)
        }
        sqlite3StrVappendf(&pCheck.errMsg, zFormat, ap)
        BuiltinVaEnd(ap)
        if (pCheck.errMsg.accError == 7) {
            checkOom(pCheck)
        }
    }
}

@Export
public func getPageReferenced(pCheck: ptr[IntegrityCk], iPg: Pgno): int {
    unsafe {
        return (pCheck.aPgRef[(iPg / 8)] & (1 << (iPg & 7)))
    }
}

@Export
public func setPageReferenced(pCheck: ptr[IntegrityCk], iPg: Pgno) {
    unsafe {
        pCheck.aPgRef[(iPg / 8)] |= (1 << (iPg & 7))
    }
}

@Export
public func checkRef(pCheck: ptr[IntegrityCk], iPage: Pgno): int {
    unsafe {
        if ((iPage > pCheck.nCkPage) || (iPage == 0)) {
            checkAppendMsg(pCheck, c"invalid page number %u", iPage)
            return 1
        }
        if (getPageReferenced(pCheck, iPage) != 0) {
            checkAppendMsg(pCheck, c"2nd reference to page %u", iPage)
            return 1
        }
        setPageReferenced(pCheck, iPage)
        return 0
    }
}

@Export
public func checkPtrmap(pCheck: ptr[IntegrityCk], iChild: Pgno, eType: U8, iParent: Pgno) {
    unsafe {
        let mut rc: int = 0
        let mut ePtrmapType: U8 = U8 {}
        let mut iPtrmapParent: Pgno = Pgno {}
        rc = ptrmapGet(pCheck.pBt, iChild, &ePtrmapType, &iPtrmapParent)
        if (rc != 0) {
            if ((rc == 7) || (rc == (10 | (12 << 8)))) {
                checkOom(pCheck)
            }
            checkAppendMsg(pCheck, c"Failed to read ptrmap key=%u", iChild)
            return
        }
        if ((ePtrmapType != eType) || (iPtrmapParent != iParent)) {
            checkAppendMsg(pCheck, c"Bad ptr map entry key=%u expected=(%u,%u) got=(%u,%u)", iChild, eType, iParent, ePtrmapType, iPtrmapParent)
        }
    }
}

@Export
public func checkList(pCheck: ptr[IntegrityCk], isFreeList: int, iPage: Pgno, n: U32) {
    unsafe {
        let mut localIPage = iPage
        let mut localN = n
        let mut i: int = 0
        let mut expected: U32 = localN
        let mut nErrAtStart: int = pCheck.nErr
        while ((localIPage != 0) && (pCheck.mxErr != 0)) {
            let mut pOvflPage: ptr[DbPage] = nil
            let mut pOvflData: ptr[u8] = nil
            if (checkRef(pCheck, localIPage) != 0) {
                break
            }
            localN = localN - 1
            if (sqlite3PagerGet(pCheck.pPager, (localIPage as Pgno), &pOvflPage, 0) != 0) {
                checkAppendMsg(pCheck, c"failed to get page %u", localIPage)
                break
            }
            pOvflData = (sqlite3PagerGetData(pOvflPage) as ptr[u8])
            if (isFreeList != 0) {
                let mut n: U32 = (sqlite3Get4byte(&pOvflData[4]) as U32)
                if (pCheck.pBt.autoVacuum != 0) {
                    checkPtrmap(pCheck, localIPage, 2, 0)
                }
                if (n > ((pCheck.pBt.usableSize / 4) - 2)) {
                    checkAppendMsg(pCheck, c"freelist leaf count too big on page %u", localIPage)
                    localN = localN - 1
                } else {
                    i = 0
                    while (i < (n as int)) {
                        let mut iFreePage: Pgno = sqlite3Get4byte(&pOvflData[(8 + (i * 4))])
                        if (pCheck.pBt.autoVacuum != 0) {
                            checkPtrmap(pCheck, iFreePage, 2, 0)
                        }
                        checkRef(pCheck, iFreePage)
                        i = i + 1
                    }
                    localN -= n
                }
            } else {
                if ((pCheck.pBt.autoVacuum != 0) && (localN > 0)) {
                    i = sqlite3Get4byte(pOvflData)
                    checkPtrmap(pCheck, i, 4, localIPage)
                }
            }
            localIPage = sqlite3Get4byte(pOvflData)
            sqlite3PagerUnref(pOvflPage)
        }
        if ((localN != 0) && (nErrAtStart == pCheck.nErr)) {
            checkAppendMsg(pCheck, c"%s is %u but should be %u", (if (isFreeList != 0) { c"size" } else { c"overflow list length" }), (expected - localN), expected)
        }
    }
}

@Export
public func btreeHeapInsert(aHeap: ptr[U32], x: U32) {
    unsafe {
        let mut localX = x
        let mut j: U32 = U32 {}
        let mut i: U32 = U32 {}
        i = (aHeap[0] + 1)
        aHeap[i] = localX
        while true {
            j = (i / 2)
            if !(((j > 0) && (aHeap[j] > aHeap[i]))) {
                break
            }
            localX = aHeap[j]
            aHeap[j] = aHeap[i]
            aHeap[i] = localX
            i = j
        }
    }
}

@Export
public func btreeHeapPull(aHeap: ptr[U32], pOut: ptr[U32]): int {
    unsafe {
        let mut j: U32 = U32 {}
        let mut i: U32 = U32 {}
        let mut x: U32 = U32 {}
        x = aHeap[0]
        if (x == 0) {
            return 0
        }
        pOut[0] = aHeap[1]
        aHeap[1] = aHeap[x]
        aHeap[x] = -1
        aHeap[0] = aHeap[0] - 1
        i = 1
        while true {
            j = (i * 2)
            if !((j <= aHeap[0])) {
                break
            }
            if (aHeap[j] > aHeap[(j + 1)]) {
                j = j + 1
            }
            if (aHeap[i] < aHeap[j]) {
                break
            }
            x = aHeap[i]
            aHeap[i] = aHeap[j]
            aHeap[j] = x
            i = j
        }
        return 1
    }
}

@Export
public func checkTreePage(pCheck: ptr[IntegrityCk], iPage: Pgno, piMinKey: ptr[I64], maxKey: I64): int {
    unsafe {
        let mut localMaxKey = maxKey
        let mut pPage: ptr[MemPage] = nil
        let mut i: int = 0
        let mut rc: int = 0
        let mut depth: int = -1
        let mut d2: int = 0
        let mut pgno: int = 0
        let mut nFrag: int = 0
        let mut hdr: int = 0
        let mut cellStart: int = 0
        let mut nCell: int = 0
        let mut doCoverageCheck: int = 1
        let mut keyCanBeEqual: int = 1
        let mut data: ptr[U8] = nil
        let mut pCell: ptr[U8] = nil
        let mut pCellIdx: ptr[U8] = nil
        let mut pBt: ptr[BtShared] = nil
        let mut pc: U32 = U32 {}
        let mut usableSize: U32 = U32 {}
        let mut contentOffset: U32 = U32 {}
        let mut heap: ptr[U32] = nil
        let mut x: U32 = U32 {}
        let mut prev: U32 = 0
        let mut savedZPfx: ptr[i8] = pCheck.zPfx
        let mut savedV1: int = pCheck.v1
        let mut savedV2: int = pCheck.v2
        let mut savedIsInit: U8 = 0
        checkProgress(pCheck)
        while true {
            if (pCheck.mxErr == nil) {
                break
            }
            pBt = pCheck.pBt
            usableSize = pBt.usableSize
            if (iPage == 0) {
                return 0
            }
            if (checkRef(pCheck, iPage) != 0) {
                return 0
            }
            pCheck.zPfx = c"Tree %u page %u: "
            pCheck.v1 = iPage
            rc = btreeGetPage(pBt, iPage, &pPage, 0)
            if (rc != 0) {
                checkAppendMsg(pCheck, c"unable to get the page. error code=%d", rc)
                if (rc == (10 | (12 << 8))) {
                    pCheck.rc = 7
                }
                break
            }
            savedIsInit = pPage.isInit
            pPage.isInit = nil
            rc = btreeInitPage(pPage)
            if (rc != 0) {
                checkAppendMsg(pCheck, c"btreeInitPage() returns error code %d", rc)
                break
            }
            rc = btreeComputeFreeSpace(pPage)
            if (rc != 0) {
                checkAppendMsg(pCheck, c"free space corruption", rc)
                break
            }
            data = pPage.aData
            hdr = pPage.hdrOffset
            pCheck.zPfx = c"Tree %u page %u cell %u: "
            contentOffset = ((((((&data[(hdr + 5)][0] << 8) | &data[(hdr + 5)][1]) as int) - 1) & 65535) + 1)
            nCell = ((&data[(hdr + 3)][0] << 8) | &data[(hdr + 3)][1])
            if ((pPage.leaf != 0) || (pPage.intKey == nil)) {
                pCheck.nRow += nCell
            }
            cellStart = ((hdr + 12) - (4 * pPage.leaf))
            pCellIdx = &data[(cellStart + (2 * (nCell - 1)))]
            if (pPage.leaf == nil) {
                pgno = sqlite3Get4byte(&data[(hdr + 8)])
                if (pBt.autoVacuum != 0) {
                    pCheck.zPfx = c"Tree %u page %u right child: "
                    checkPtrmap(pCheck, pgno, 5, iPage)
                }
                depth = checkTreePage(pCheck, pgno, &localMaxKey, localMaxKey)
                keyCanBeEqual = 0
            } else {
                heap = pCheck.heap
                heap[0] = 0
            }
            i = (nCell - 1)
            while ((i >= 0) && (pCheck.mxErr != 0)) {
                let mut info: CellInfo = CellInfo {}
                pCheck.v2 = i
                pc = ((pCellIdx[0] << 8) | pCellIdx[1])
                pCellIdx -= 2
                if ((pc < contentOffset) || (pc > (usableSize - 4))) {
                    checkAppendMsg(pCheck, c"Offset %u out of range %u..%u", pc, contentOffset, (usableSize - 4))
                    doCoverageCheck = 0
                    continue
                }
                pCell = &data[pc]
                pPage.xParseCell(pPage, pCell, &info)
                if ((pc + info.nSize) > usableSize) {
                    checkAppendMsg(pCheck, c"Extends off end of page")
                    doCoverageCheck = 0
                    continue
                }
                if (pPage.intKey != 0) {
                    if ((if (keyCanBeEqual != 0) { (info.nKey > localMaxKey) } else { (info.nKey >= localMaxKey) }) != 0) {
                        checkAppendMsg(pCheck, c"Rowid %lld out of order", info.nKey)
                    }
                    localMaxKey = info.nKey
                    keyCanBeEqual = 0
                }
                if (info.nPayload > info.nLocal) {
                    let mut nPage: U32 = U32 {}
                    let mut pgnoOvfl: Pgno = Pgno {}
                    nPage = ((((info.nPayload - info.nLocal) + usableSize) - 5) / (usableSize - 4))
                    pgnoOvfl = sqlite3Get4byte(&pCell[(info.nSize - 4)])
                    if (pBt.autoVacuum != 0) {
                        checkPtrmap(pCheck, pgnoOvfl, 3, iPage)
                    }
                    checkList(pCheck, 0, pgnoOvfl, nPage)
                }
                if (pPage.leaf == nil) {
                    pgno = sqlite3Get4byte(pCell)
                    if (pBt.autoVacuum != 0) {
                        checkPtrmap(pCheck, pgno, 5, iPage)
                    }
                    d2 = checkTreePage(pCheck, pgno, &localMaxKey, localMaxKey)
                    keyCanBeEqual = 0
                    if (d2 != depth) {
                        checkAppendMsg(pCheck, c"Child page depth differs")
                        depth = d2
                    }
                } else {
                    btreeHeapInsert(heap, ((pc << 16) | ((pc + info.nSize) - 1)))
                }
                i = i - 1
            }
            piMinKey[0] = localMaxKey
            pCheck.zPfx = nil
            if ((doCoverageCheck != 0) && (pCheck.mxErr > 0)) {
                if (pPage.leaf == nil) {
                    heap = pCheck.heap
                    heap[0] = 0
                    i = (nCell - 1)
                    while (i >= 0) {
                        let mut size: U32 = U32 {}
                        pc = ((&data[(cellStart + (i * 2))][0] << 8) | &data[(cellStart + (i * 2))][1])
                        size = pPage.xCellSize(pPage, &data[pc])
                        btreeHeapInsert(heap, ((pc << 16) | ((pc + size) - 1)))
                        i = i - 1
                    }
                }
                i = ((&data[(hdr + 1)][0] << 8) | &data[(hdr + 1)][1])
                while (i > 0) {
                    let mut size: int = 0
                    let mut j: int = 0
                    size = ((&data[(i + 2)][0] << 8) | &data[(i + 2)][1])
                    btreeHeapInsert(heap, (((i as U32) << 16) | ((i + size) - 1)))
                    j = ((&data[i][0] << 8) | &data[i][1])
                    i = j
                }
                nFrag = 0
                prev = (contentOffset - 1)
                while (btreeHeapPull(heap, &x) != 0) {
                    if ((prev & 65535) >= (x >> 16)) {
                        checkAppendMsg(pCheck, c"Multiple uses for byte %u of page %u", (x >> 16), iPage)
                        break
                    } else {
                        nFrag += (((x >> 16) - (prev & 65535)) - 1)
                        prev = x
                    }
                }
                nFrag += ((usableSize - (prev & 65535)) - 1)
                if ((heap[0] == 0) && (nFrag != data[(hdr + 7)])) {
                    checkAppendMsg(pCheck, c"Fragmentation of %u bytes reported as %u on page %u", nFrag, data[(hdr + 7)], iPage)
                }
            }
            break
        }
        if (doCoverageCheck == 0) {
            pPage.isInit = savedIsInit
        }
        releasePage(pPage)
        pCheck.zPfx = savedZPfx
        pCheck.v1 = savedV1
        pCheck.v2 = savedV2
        return (depth + 1)
    }
}

@Export
public func findBtree(pErrorDb: ptr[Sqlite3], pDb: ptr[Sqlite3], zDb: ptr[i8]): ptr[Btree] {
    unsafe {
        let mut i: int = sqlite3FindDbName(pDb, zDb)
        if (i == 1) {
            let mut sParse: Parse = Parse {}
            let mut rc: int = 0
            sqlite3ParseObjectInit(&sParse, pDb)
            if (sqlite3OpenTempDatabase(&sParse) != 0) {
                sqlite3ErrorWithMsg(pErrorDb, sParse.rc, c"%s", sParse.zErrMsg)
                rc = 1
            }
            sqlite3DbFree(pErrorDb, sParse.zErrMsg)
            sqlite3ParseObjectReset(&sParse)
            if (rc != 0) {
                return 0
            }
        }
        if (i < 0) {
            sqlite3ErrorWithMsg(pErrorDb, 1, c"unknown database %s", zDb)
            return 0
        }
        return pDb.aDb[i].pBt
    }
}

@Export
public func setDestPgsz(pDest: ptr[Btree], pSrc: ptr[Btree]): int {
    unsafe {
        return sqlite3BtreeSetPageSize(pDest, sqlite3BtreeGetPageSize(pSrc), 0, 0)
    }
}

@Export
public func checkReadTransaction(db: ptr[Sqlite3], p: ptr[Btree]): int {
    unsafe {
        if (sqlite3BtreeTxnState(p) != 0) {
            sqlite3ErrorWithMsg(db, 1, c"destination database is in use")
            return 1
        }
        return 0
    }
}

@Export
public func isFatalError(rc: int): int {
    return ((((rc != 0) && (rc != 5)) && (rc != 6)) as int)
}

@Export
public func backupOnePage(p: ptr[Sqlite3Backup], iSrcPg: Pgno, zSrcData: ptr[U8], bUpdate: int): int {
    unsafe {
        let mut pDestPager: ptr[Pager] = sqlite3BtreePager(p.pDest)
        let mut nSrcPgsz: int = sqlite3BtreeGetPageSize(p.pSrc)
        let mut nDestPgsz: int = sqlite3BtreeGetPageSize(p.pDest)
        let mut nCopy: int = (if (nSrcPgsz < nDestPgsz) { nSrcPgsz } else { nDestPgsz })
        let mut iEnd: I64 = ((iSrcPg as I64) * (nSrcPgsz as I64))
        let mut rc: int = 0
        let mut iOff: I64 = I64 {}
        iOff = (iEnd - (nSrcPgsz as I64))
        while ((rc == 0) && (iOff < iEnd)) {
            let mut pDestPg: ptr[DbPage] = nil
            let mut iDest: Pgno = (((iOff / nDestPgsz) as Pgno) + 1)
            if (iDest == (((sqlite3PendingByte / p.pDest.pBt.pageSize) + 1) as Pgno)) {
                continue
            }
            rc = sqlite3PagerGet(pDestPager, iDest, &pDestPg, 0)
            if ((0 == rc) && (0 == (rc = sqlite3PagerWrite(pDestPg)))) {
                let mut zIn: ptr[U8] = &zSrcData[(iOff % nSrcPgsz)]
                let mut zDestData: ptr[U8] = sqlite3PagerGetData(pDestPg)
                let mut zOut: ptr[U8] = &zDestData[(iOff % nDestPgsz)]
                memcpy(zOut, zIn, nCopy)
                (sqlite3PagerGetExtra(pDestPg) as ptr[U8])[0] = nil
                if ((iOff == 0) && (bUpdate == 0)) {
                    sqlite3Put4byte(&zOut[28], sqlite3BtreeLastPage(p.pSrc))
                }
            }
            sqlite3PagerUnref(pDestPg)
            iOff += nDestPgsz
        }
        return rc
    }
}

@Export
public func backupTruncateFile(pFile: ptr[Sqlite3File], iSize: I64): int {
    unsafe {
        let mut iCurrent: I64 = I64 {}
        let mut rc: int = sqlite3OsFileSize(pFile, &iCurrent)
        if ((rc == 0) && (iCurrent > iSize)) {
            rc = sqlite3OsTruncate(pFile, iSize)
        }
        return rc
    }
}

@Export
public func attachBackupObject(p: ptr[Sqlite3Backup]) {
    unsafe {
        let mut pp: ptr[ptr[Sqlite3Backup]] = nil
        pp = sqlite3PagerBackupPtr(sqlite3BtreePager(p.pSrc))
        p.pNext = pp[0]
        pp[0] = p
        p.isAttached = 1
    }
}

@Export
public func backupUpdate(p: ptr[Sqlite3Backup], iPage: Pgno, aData: ptr[U8]) {
    unsafe {
        let mut localP = p
        while true {
            if ((isFatalError(localP.rc) == 0) && (iPage < localP.iNext)) {
                let mut rc: int = 0
                ;
                rc = backupOnePage(localP, iPage, aData, 1)
                ;
                if (rc != 0) {
                    localP.rc = rc
                }
            }
            if !(((localP = localP.pNext) != 0)) {
                break
            }
        }
    }
}

@Export
public func vdbeMemRenderNum(sz: int, zBuf: ptr[i8], p: ptr[Mem]) {
    unsafe {
        let mut acc: StrAccum = StrAccum {}
        if ((p.flags & (4 | 32)) != 0) {
            p.n = sqlite3Int64ToText(p.u.i, zBuf)
            if ((p.flags & 32) != 0) {
                memcpy((zBuf + p.n), c".0", 3)
                p.n += 2
            }
        } else {
            sqlite3StrAccumInit(&acc, 0, zBuf, sz, 0)
            sqlite3StrAppendf(&acc, c"%!.*g", (if (p.db != 0) { p.db.nFpDigit } else { 17 }), p.u.r)
            zBuf[acc.nChar] = 0
            p.n = acc.nChar
        }
    }
}

@Export
public func vdbeMemAddTerminator(pMem: ptr[Mem]): int {
    unsafe {
        if (sqlite3VdbeMemGrow(pMem, (pMem.n + 3), 1) != 0) {
            return 7
        }
        pMem.z[pMem.n] = nil
        pMem.z[(pMem.n + 1)] = nil
        pMem.z[(pMem.n + 2)] = nil
        pMem.flags |= 512
        return 0
    }
}

@Export
public func vdbeMemClearExternAndSetNull(p: ptr[Mem]) {
    unsafe {
        if ((p.flags & 32768) != 0) {
            sqlite3VdbeMemFinalize(p, p.u.pDef)
            ;
        }
        if ((p.flags & 4096) != 0) {
            p.xDel((p.z as ptr[u8]))
        }
        p.flags = 1
    }
}

@Export
public func vdbeMemClear(p: ptr[Mem]) {
    unsafe {
        if ((p.flags & (32768 | 4096)) != 0) {
            vdbeMemClearExternAndSetNull(p)
        }
        if (p.szMalloc != 0) {
            sqlite3DbFreeNN(p.db, p.zMalloc)
            p.szMalloc = nil
        }
        p.z = nil
    }
}

@Export
public func memIntValue(pMem: ptr[Mem]): I64 {
    unsafe {
        let mut value: I64 = 0
        sqlite3Atoi64(pMem.z, &value, pMem.n, pMem.enc)
        return value
    }
}

@Export
public func sqlite3MemRealValueRCSlowPath(pMem: ptr[Mem], pValue: ptr[f64]): int {
    unsafe {
        let mut rc: int = 0
        pValue[0] = 0.0
        if (pMem.enc == 1) {
            let mut zCopy: ptr[i8] = sqlite3DbStrNDup(pMem.db, pMem.z, pMem.n)
            if (zCopy != 0) {
                rc = sqlite3AtoF(zCopy, pValue)
                sqlite3DbFree(pMem.db, zCopy)
            }
            return rc
        } else {
            let mut n: int = 0
            let mut i: int = 0
            let mut j: int = 0
            let mut zCopy: ptr[i8] = nil
            let mut z: ptr[i8] = nil
            n = (pMem.n & ~1)
            zCopy = sqlite3DbMallocRaw(pMem.db, ((n / 2) + 2))
            if (zCopy != 0) {
                z = pMem.z
                if (pMem.enc == 2) {
                    j = 0
                    while (i < (n - 1)) {
                        zCopy[j] = z[i]
                        if (z[(i + 1)] != 0) {
                            break
                        }
                        i += 2
                        j = j + 1
                    }
                } else {
                    j = 0
                    while (i < (n - 1)) {
                        if (z[i] != 0) {
                            break
                        }
                        zCopy[j] = z[(i + 1)]
                        i += 2
                        j = j + 1
                    }
                }
                zCopy[j] = 0
                rc = sqlite3AtoF(zCopy, pValue)
                if (i < n) {
                    rc = -100
                }
                sqlite3DbFree(pMem.db, zCopy)
            }
            return rc
        }
    }
}

@Export
public func sqlite3MemRealValueNoRC(pMem: ptr[Mem]): f64 {
    unsafe {
        let mut r: f64 = 0.0
        return r
    }
}

@Export
public func vdbeReleaseAndSetInt64(pMem: ptr[Mem], val: I64) {
    unsafe {
        sqlite3VdbeMemSetNull(pMem)
        pMem.u.i = val
        pMem.flags = 4
    }
}

@Export
public func vdbeClrCopy(pTo: ptr[Mem], pFrom: ptr[Mem], eType: int) {
    unsafe {
        vdbeMemClearExternAndSetNull(pTo)
        sqlite3VdbeMemShallowCopy(pTo, pFrom, eType)
    }
}

@Export
public func valueToText(pVal: ptr[Sqlite3Value], enc: U8): ptr[u8] {

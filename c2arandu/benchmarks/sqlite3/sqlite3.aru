        }
    }
}

@Export
public func explainIndexRange(pStr: ptr[StrAccum], pLoop: ptr[WhereLoop]) {
    unsafe {
        let mut pIndex: ptr[Index] = pLoop.u.btree.pIndex
        let mut nEq: U16 = pLoop.u.btree.nEq
        let mut nSkip: U16 = pLoop.nSkip

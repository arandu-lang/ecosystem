                if (pFunc.bUseSubtype != 0) {
                    nExtra += pFunc.pFExpr.x.pList.nExpr
                }
                pKeyInfo = sqlite3KeyInfoFromExprList(pParse, pOBList, 0, nExtra)
                if ((pFunc.bOBUnique == nil) && (pParse.nErr == nil)) {
                    pKeyInfo.nKeyField = pKeyInfo.nKeyField + 1
                }
                sqlite3VdbeAddOp4(v, 120, pFunc.iOBTab, (pOBList.nExpr + nExtra), 0, (pKeyInfo as ptr[i8]), 9))
                sqlite3VdbeExplain(pParse, 0, c"USE TEMP B-TREE FOR %s(ORDER BY)", pFunc.pFunc.zName)
            }
            i = i + 1
            pFunc = pFunc + 1
        }
    }
}

@Export
public func finalizeAggFunctions(pParse: ptr[Parse], pAggInfo: ptr[AggInfo]) {
    unsafe {
        let mut v: ptr[Vdbe] = pParse.pVdbe
        let mut i: int = 0
        let mut pF: ptr[AggInfoFunc] = nil
        i = 0
        while (i < pAggInfo.nFunc) {

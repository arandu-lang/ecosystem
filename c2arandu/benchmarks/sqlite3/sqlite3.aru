@Export
public func sqlite3WindowChain(pParse: ptr[Parse], pWin: ptr[Window], pList: ptr[Window]) {
    unsafe {
        if (pWin.zBase != 0) {
            let mut db: ptr[Sqlite3] = pParse.db
            let mut pExist: ptr[Window] = windowFind(pParse, pList, pWin.zBase)
            if (pExist != 0) {
                let mut zErr: ptr[i8] = nil
                if (pWin.pPartition != 0) {
                    zErr = c"PARTITION clause"
                } else {
                    if ((pExist.pOrderBy != 0) && (pWin.pOrderBy != 0)) {
                        zErr = c"ORDER BY clause"
                    } else {
                        if (pExist.bImplicitFrame == nil) {
                            zErr = c"frame specification"
                        }
                    }
                }
                if (zErr != 0) {
                    sqlite3ErrorMsg(pParse, c"cannot override %s of window: %s", zErr, pWin.zBase)
                } else {
                    pWin.pPartition = sqlite3ExprListDup(db, pExist.pPartition, 0)
                    if (pExist.pOrderBy != 0) {
                        pWin.pOrderBy = sqlite3ExprListDup(db, pExist.pOrderBy, 0)
                    }
                    sqlite3DbFree(db, pWin.zBase)
                    pWin.zBase = nil
                }
            }
        }
    }
}

@Export
public func sqlite3WindowAssemble(pParse: ptr[Parse], pWin: ptr[Window], pPartition: ptr[ExprList], pOrderBy: ptr[ExprList], pBase: ptr[Token]): ptr[Window] {

        }
    }
}

@Export
public func windowAggStep(p: ptr[WindowCodeArg], pMWin: ptr[Window], csr: int, bInverse: int, reg: int) {
    unsafe {
        let mut pParse: ptr[Parse] = p.pParse
        let mut v: ptr[Vdbe] = sqlite3GetVdbe(pParse)
        let mut pWin: ptr[Window] = nil
        pWin = pMWin
        while (pWin != 0) {
            let mut pFunc: ptr[FuncDef] = pWin.pWFunc
            let mut regArg: int = 0
            let mut nArg: int = (if (pWin.bExprArgs != 0) { 0 } else { windowArgCount(pWin) })
            let mut i: int = 0
            let mut addrIf: int = 0
            i = 0
            while (i < nArg) {
                if ((i != 1) || (pFunc.zName != nthValueName)) {
                    sqlite3VdbeAddOp3(v, 96, csr, (pWin.iArgCol + i), (reg + i))
                } else {
                    sqlite3VdbeAddOp3(v, 96, pMWin.iEphCsr, (pWin.iArgCol + i), (reg + i))
                }
                i = i + 1
            }
            regArg = reg
            if (pWin.pFilter != 0) {
                let mut regTmp: int = 0
                regTmp = sqlite3GetTempReg(pParse)
                sqlite3VdbeAddOp3(v, 96, csr, (pWin.iArgCol + nArg), regTmp)
                addrIf = sqlite3VdbeAddOp3(v, 17, regTmp, 0, 1)
                ;
                sqlite3ReleaseTempReg(pParse, regTmp)
            }
            if (((pMWin.regStartRowid == nil) && ((pFunc.funcFlags & 4096) != 0)) && (pWin.eStart != 91)) {
                let mut addrIsNull: int = sqlite3VdbeAddOp1(v, 51, regArg)
                ;
                if (bInverse == 0) {
                    sqlite3VdbeAddOp2(v, 88, (pWin.regApp + 1), 1)
                    sqlite3VdbeAddOp2(v, 83, regArg, pWin.regApp)
                    sqlite3VdbeAddOp3(v, 99, pWin.regApp, 2, (pWin.regApp + 2))
                    sqlite3VdbeAddOp2(v, 140, pWin.csrApp, (pWin.regApp + 2))
                } else {
                    sqlite3VdbeAddOp4Int(v, 23, pWin.csrApp, 0, regArg, 1)
                    ;
                    sqlite3VdbeAddOp1(v, 132, pWin.csrApp)
                    sqlite3VdbeJumpHere(v, (sqlite3VdbeCurrentAddr(v) - 2))
                }
                sqlite3VdbeJumpHere(v, addrIsNull)
            } else {
                if (pWin.regApp != 0) {
                    sqlite3VdbeAddOp2(v, 88, ((pWin.regApp + 1) - bInverse), 1)
                } else {
                    if (pFunc.xSFunc != noopStepFunc) {
                        if (pWin.bExprArgs != 0) {
                            let mut iOp: int = sqlite3VdbeCurrentAddr(v)
                            let mut iEnd: int = 0
                            nArg = pWin.pOwner.x.pList.nExpr
                            regArg = sqlite3GetTempRange(pParse, nArg)
                            sqlite3ExprCodeExprList(pParse, pWin.pOwner.x.pList, regArg, 0, 0)
                            iEnd = sqlite3VdbeCurrentAddr(v)
                            while (iOp < iEnd) {
                                let mut pOp: ptr[VdbeOp] = sqlite3VdbeGetOp(v, iOp)
                                if ((pOp.opcode == 96) && (pOp.p1 == pMWin.iEphCsr)) {
                                    pOp.p1 = csr
                                }
                                iOp = iOp + 1
                            }
                        }
                        if ((pFunc.funcFlags & 32) != 0) {
                            let mut pColl: ptr[CollSeq] = nil
                            pColl = sqlite3ExprNNCollSeq(pParse, pWin.pOwner.x.pList.a[0].pExpr)
                            sqlite3VdbeAddOp4(v, 87, 0, 0, 0, (pColl as ptr[i8]), 2))
                        }
                        sqlite3VdbeAddOp3(v, (if (bInverse != 0) { 163 } else { 164 }), bInverse, regArg, pWin.regAccum)
                        sqlite3VdbeAppendP4(v, pFunc, 8))
                        sqlite3VdbeChangeP5(v, (nArg as U16))
                        if (pWin.bExprArgs != 0) {
                            sqlite3ReleaseTempRange(pParse, regArg, nArg)
                        }
                    }
                }
            }
            if (addrIf != 0) {
                sqlite3VdbeJumpHere(v, addrIf)
            }
            pWin = pWin.pNextWin
        }
    }
}

@Export
public func windowAggFinal(p: ptr[WindowCodeArg], bFin: int) {
    unsafe {
        let mut pParse: ptr[Parse] = p.pParse
        let mut pMWin: ptr[Window] = p.pMWin
        let mut v: ptr[Vdbe] = sqlite3GetVdbe(pParse)

    unsafe {
        let mut pDestructor: ptr[FuncDestructor] = nil
        pDestructor = p.u.pDestructor
        if (pDestructor != 0) {
            pDestructor.nRef = pDestructor.nRef - 1
            if (pDestructor.nRef == nil) {
                pDestructor.xDestroy(pDestructor.pUserData)
                sqlite3DbFree(db, pDestructor)
            }
        }
    }
}

@Export
public func disconnectAllVtab(db: ptr[Sqlite3]) {
    unsafe {
        let mut i: int = 0
        let mut p: ptr[HashElem] = nil
        sqlite3BtreeEnterAll(db)
        i = 0
        while (i < db.nDb) {
            let mut pSchema: ptr[Schema] = db.aDb[i].pSchema
            if (pSchema != 0) {
                p = pSchema.tblHash.first
                while (p != 0) {
                    let mut pTab: ptr[Table] = (p.data as ptr[Table])
                    if (pTab.eTabType == 1) {
                        sqlite3VtabDisconnect(db, pTab)
                    }
                    p = p.next
                }
            }
            i = i + 1
        }
        p = db.aModule.first
        while (p != 0) {
            let mut pMod: ptr[Module] = (p.data as ptr[Module])
            if (pMod.pEpoTab != 0) {
                sqlite3VtabDisconnect(db, pMod.pEpoTab)
            }
            p = p.next
        }
        sqlite3VtabUnlockList(db)
        ;
    }
}

@Export
public func connectionIsBusy(db: ptr[Sqlite3]): int {
    unsafe {
        let mut j: int = 0
        if (db.pVdbe != 0) {
            return 1
        }
        j = 0
        while (j < db.nDb) {
            let mut pBt: ptr[Btree] = db.aDb[j].pBt
            if ((pBt != 0) && (sqlite3BtreeIsInBackup(pBt) != 0)) {
                return 1
            }
            j = j + 1
        }
        return 0
    }
}

@Export
public func sqlite3Close(db: ptr[Sqlite3], forceZombie: int): int {
    unsafe {
        if (db == 0) {
            return 0
        }
        if (sqlite3SafetyCheckSickOrOk(db) == 0) {
            return sqlite3MisuseError(188663)
        }
        ;
        if ((db.mTrace & 8) != 0) {
            db.trace.xV2(8, db.pTraceArg, db, 0)
        }
        disconnectAllVtab(db)
        sqlite3VtabRollback(db)
        if ((forceZombie == 0) && (connectionIsBusy(db) != 0)) {
            sqlite3ErrorWithMsg(db, 5, c"unable to close due to unfinalized statements or unfinished backups")
            ;

@Export
public func sqlite3QuoteValue(pStr: ptr[StrAccum], pValue: ptr[Sqlite3Value], bEscape: int) {
    unsafe {
        match sqlite3ValueType(pValue) {
            2 => {
                sqlite3StrAppendf(pStr, c"%!0.17g", sqlite3ValueDouble(pValue))
                break
            }
            1 => {
                sqlite3StrAppendf(pStr, c"%lld", sqlite3ValueInt64(pValue))
                break
            }
            4 => {
                let mut zBlob: ptr[i8] = sqlite3ValueBlob(pValue)
                let mut nBlob: I64 = sqlite3ValueBytes(pValue)
                sqlite3StrAccumEnlarge(pStr, ((nBlob * 2) + 4))
                if (pStr.accError == nil) {
                    let mut zText: ptr[i8] = pStr.zText
                    let mut i: int = 0
                    i = 0
                    while (i < nBlob) {
                        zText[((i * 2) + 2)] = hexdigits[((zBlob[i] >> 4) & 15)]
                        zText[((i * 2) + 3)] = hexdigits[(zBlob[i] & 15)]
                        i = i + 1
                    }
                    zText[((nBlob * 2) + 2)] = 39
                    zText[((nBlob * 2) + 3)] = 0
                    zText[0] = 88
                    zText[1] = 39
                    pStr.nChar = ((nBlob * 2) + 3)
                }
                break
            }
            3 => {
                let mut zArg: ptr[u8] = sqlite3ValueText(pValue)
                sqlite3StrAppendf(pStr, (if (bEscape != 0) { c"%#Q" } else { c"%Q" }), zArg)
                break
            }
            _ => {
                sqlite3StrAppend(pStr, c"NULL", 4)
                break
            }
        }
    }
}

@Export
public func sqlite3AppendOneUtf8Character(zOut: ptr[i8], v: U32): int {
    unsafe {
        if (v < 128) {
            zOut[0] = ((v & 255) as U8)
            return 1
        }
        if (v < 2048) {
            zOut[0] = (192 + (((v >> 6) & 31) as U8))
            zOut[1] = (128 + ((v & 63) as U8))
            return 2
        }
        if (v < 65536) {
            zOut[0] = (224 + (((v >> 12) & 15) as U8))
            zOut[1] = (128 + (((v >> 6) & 63) as U8))
            zOut[2] = (128 + ((v & 63) as U8))
            return 3
        }
        zOut[0] = (240 + (((v >> 18) & 7) as U8))
        zOut[1] = (128 + (((v >> 12) & 63) as U8))
        zOut[2] = (128 + (((v >> 6) & 63) as U8))
        zOut[3] = (128 + ((v & 63) as U8))
        return 4
    }
}


            sqlite3ResultInt(context, (p.current.anDLt[0] > 0))
        }
    }
}

@Export
public func statGet(context: ptr[Sqlite3Context], argc: int, argv: ptr[ptr[Sqlite3Value]]) {
    unsafe {
        let mut p: ptr[StatAccum] = (sqlite3ValueBlob(argv[0]) as ptr[StatAccum])
        let mut sStat: Sqlite3Str = Sqlite3Str {}
        let mut i: int = 0
        sqlite3StrAccumInit(&sStat, 0, 0, 0, ((p.nKeyCol + 1) * 100))
        sqlite3StrAppendf(&sStat, c"%llu", (if (p.nSkipAhead != 0) { (p.nEst as U64) } else { (p.nRow as U64) }))
        i = 0
        while (i < p.nKeyCol) {
            let mut nDistinct: U64 = (p.current.anDLt[i] + 1)
            let mut iVal: U64 = (((p.nRow + nDistinct) - 1) / nDistinct)
            if ((iVal == 2) && ((p.nRow * 10) <= (nDistinct * 11))) {
                iVal = 1
            }
            sqlite3StrAppendf(&sStat, c" %llu", iVal)
            i = i + 1
        }
        sqlite3ResultStrAccum(context, &sStat)
    }
}


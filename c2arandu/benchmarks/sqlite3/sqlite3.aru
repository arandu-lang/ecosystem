                if (((pFunc.funcFlags & 4096) != 0) && (pWin.csrApp != 0)) {
                    sqlite3VdbeAddOp1(v, 148, pWin.csrApp)
                    sqlite3VdbeAddOp2(v, 73, 0, (pWin.regApp + 1))
                }
            }
            pWin = pWin.pNextWin
        }
        regArg = (pParse.nMem + 1)
        pParse.nMem += nArg
        return regArg
    }
}

@Export
public func windowCacheFrame(pMWin: ptr[Window]): int {
    unsafe {
        let mut pWin: ptr[Window] = nil
